/*
 * memtrace2.bt - larry, 2026-10-26 (memtrace.bt + the xe shrinker's BO backups): what the kernel's memory management does to the ds41 engine, one line every 2 s:
 *   edr / odr  direct reclaim: calls, total ms, longest ms (e = the engine's threads, o = everything else)
 *   edc / odc  direct compaction (try_to_compact_pages): calls, total ms, longest ms
 *   mig        pages migrated (all reasons), migc = by compaction
 *   up         xe userptr invalidations, userptr rebinds in exec / in the rebind worker
 *   x          xe exec ioctls: calls, calls over 2 ms, their ms, longest ms
 *   thr        reclaim throttling events
 *   bk         TTM backups (the xe shrinker writing system-memory BOs out to shmem / swap): calls, pages, ms
 *   rs         TTM restores (a backed-up BO touched again - CPU fault, validate, rebind): calls, pages, ms, longest ms
 *   pr         xe preempt-rebind worker runs (a compute VM's queues stay preempted until it ends): calls, ms, longest ms
 *   sh         xe shrinker scans: calls, objects freed, ms
 * At the end: the kernel stacks that entered direct compaction / direct reclaim / TTM restore, migrations by reason.
 * Run: bpftrace -B line memtrace2.bt (memtrace-start.sh BT=memtrace2.bt); SIGINT ends it.
 */

tracepoint:vmscan:mm_vmscan_direct_reclaim_begin
{
	@drb[tid] = nsecs;
	@dr_stk[comm, args.order, kstack(16)] = count();
}

tracepoint:vmscan:mm_vmscan_direct_reclaim_end
/@drb[tid]/
{
	$d = (nsecs - @drb[tid]) / 1000;
	delete(@drb[tid]);
	if (comm == "ds41_generate_x") {
		@edr_n += 1;
		@edr_us += $d;
		if ($d > @edr_max) { @edr_max = $d; }
	} else {
		@odr_n += 1;
		@odr_us += $d;
		if ($d > @odr_max) { @odr_max = $d; }
	}
}

kprobe:try_to_compact_pages
{
	@dcb[tid] = nsecs;
}

kretprobe:try_to_compact_pages
/@dcb[tid]/
{
	$d = (nsecs - @dcb[tid]) / 1000;
	delete(@dcb[tid]);
	if (comm == "ds41_generate_x") {
		@edc_n += 1;
		@edc_us += $d;
		if ($d > @edc_max) { @edc_max = $d; }
	} else {
		@odc_n += 1;
		@odc_us += $d;
		if ($d > @odc_max) { @odc_max = $d; }
	}
}

tracepoint:compaction:mm_compaction_try_to_compact_pages
{
	@dc_stk[comm, args.order, kstack(16)] = count();
}

tracepoint:migrate:mm_migrate_pages
{
	@mig += args.succeeded;
	if (args.reason == 0) { @migc += args.succeeded; }
	@mig_r[args.reason, args.mode] = sum(args.succeeded);
}

tracepoint:xe:xe_vma_userptr_invalidate { @upinv += 1; }
tracepoint:xe:xe_vma_userptr_rebind_exec { @uprbx += 1; }
tracepoint:xe:xe_vma_userptr_rebind_worker { @uprbw += 1; }

kprobe:xe_exec_ioctl
{
	@xb[tid] = nsecs;
}

kretprobe:xe_exec_ioctl
/@xb[tid]/
{
	$d = (nsecs - @xb[tid]) / 1000;
	delete(@xb[tid]);
	@x_n += 1;
	if ($d > 2000) {
		@x_slow += 1;
		@x_slow_us += $d;
	}
	if ($d > @x_max) { @x_max = $d; }
}

tracepoint:vmscan:mm_vmscan_throttled { @thr += 1; }

fentry:ttm:ttm_tt_backup { @bkb[tid] = nsecs; }
fexit:ttm:ttm_tt_backup
/@bkb[tid]/
{
	@bk_n += 1;
	@bk_us += (nsecs - @bkb[tid]) / 1000;
	if (retval > 0) { @bk_pages += retval; }
	delete(@bkb[tid]);
}

kprobe:ttm_tt_restore
{
	@rsb[tid] = nsecs;
	@rs_n += 1;
	@rs_pages += ((struct ttm_tt *)arg1)->num_pages;
	@rs_stk[comm, kstack(14)] = count();
}

kretprobe:ttm_tt_restore
/@rsb[tid]/
{
	$d = (nsecs - @rsb[tid]) / 1000;
	delete(@rsb[tid]);
	@rs_us += $d;
	if ($d > @rs_max) { @rs_max = $d; }
}

kprobe:preempt_rebind_work_func { @prb[tid] = nsecs; }
kretprobe:preempt_rebind_work_func
/@prb[tid]/
{
	$d = (nsecs - @prb[tid]) / 1000;
	delete(@prb[tid]);
	@pr_n += 1;
	@pr_us += $d;
	if ($d > @pr_max) { @pr_max = $d; }
}

fentry:xe:xe_shrinker_scan { @shb[tid] = nsecs; }
fexit:xe:xe_shrinker_scan
/@shb[tid]/
{
	@sh_n += 1;
	@sh_us += (nsecs - @shb[tid]) / 1000;
	if (retval < 0xffffffff) { @sh_freed += retval; }
	delete(@shb[tid]);
}

interval:s:2
{
	time("%H:%M:%S");
	printf(" edr %d %d %d odr %d %d %d edc %d %d %d odc %d %d %d mig %d migc %d up %d %d %d x %d %d %d %d thr %d",
	       @edr_n, @edr_us / 1000, @edr_max / 1000, @odr_n, @odr_us / 1000, @odr_max / 1000,
	       @edc_n, @edc_us / 1000, @edc_max / 1000, @odc_n, @odc_us / 1000, @odc_max / 1000,
	       @mig, @migc, @upinv, @uprbx, @uprbw, @x_n, @x_slow, @x_slow_us / 1000, @x_max / 1000, @thr);
	printf(" bk %d %d %d rs %d %d %d %d pr %d %d %d sh %d %d %d\n", @bk_n, @bk_pages, @bk_us / 1000,
	       @rs_n, @rs_pages, @rs_us / 1000, @rs_max / 1000, @pr_n, @pr_us / 1000, @pr_max / 1000,
	       @sh_n, @sh_freed, @sh_us / 1000);
	@bk_n = 0; @bk_pages = 0; @bk_us = 0; @rs_n = 0; @rs_pages = 0; @rs_us = 0; @rs_max = 0;
	@pr_n = 0; @pr_us = 0; @pr_max = 0; @sh_n = 0; @sh_freed = 0; @sh_us = 0;
	@edr_n = 0; @edr_us = 0; @edr_max = 0; @odr_n = 0; @odr_us = 0; @odr_max = 0;
	@edc_n = 0; @edc_us = 0; @edc_max = 0; @odc_n = 0; @odc_us = 0; @odc_max = 0;
	@mig = 0; @migc = 0; @upinv = 0; @uprbx = 0; @uprbw = 0;
	@x_n = 0; @x_slow = 0; @x_slow_us = 0; @x_max = 0; @thr = 0;
}

END
{
	clear(@drb); clear(@dcb); clear(@xb); clear(@bkb); clear(@rsb); clear(@prb); clear(@shb);
	clear(@bk_n); clear(@bk_pages); clear(@bk_us); clear(@rs_n); clear(@rs_pages); clear(@rs_us); clear(@rs_max);
	clear(@pr_n); clear(@pr_us); clear(@pr_max); clear(@sh_n); clear(@sh_freed); clear(@sh_us);
	clear(@edr_n); clear(@edr_us); clear(@edr_max); clear(@odr_n); clear(@odr_us); clear(@odr_max);
	clear(@edc_n); clear(@edc_us); clear(@edc_max); clear(@odc_n); clear(@odc_us); clear(@odc_max);
	clear(@mig); clear(@migc); clear(@upinv); clear(@uprbx); clear(@uprbw);
	clear(@x_n); clear(@x_slow); clear(@x_slow_us); clear(@x_max); clear(@thr);
	printf("== direct compaction entries by comm, order, stack (top 12)\n");
	print(@dc_stk, 12);
	printf("== direct reclaim entries by comm, order, stack (top 12)\n");
	print(@dr_stk, 12);
	printf("== TTM restores by comm, stack (top 8)\n");
	print(@rs_stk, 8);
	clear(@rs_stk);
	printf("== pages migrated by reason (0 compaction, 7 longterm pin), mode\n");
	print(@mig_r);
	clear(@dc_stk); clear(@dr_stk); clear(@mig_r);
}
