# tools/v41/engine/xe/xe.cmake - larry: the DeepSeek-V4.1 engine with the multi-card Intel Arc (SYCL) expert tier.
# Needs ggml's SYCL backend (-DGGML_SYCL=ON, icpx); included from tools/v41/engine/v41_engine.cmake.
if(TARGET ggml-sycl AND TARGET ds41_dense AND TARGET ds41_moe_cpu)
    set(_xe_dir ${CMAKE_CURRENT_SOURCE_DIR}/tools/v41/engine/xe)
    set(STRATA_XE_AOT "bmg-g31" CACHE STRING "Intel GPU AOT device(s) for the Xe expert kernels (empty = JIT)")
    add_library(ds41_xe STATIC ${_xe_dir}/xe_kernels.cpp ${_xe_dir}/ds41_xe_tier.cpp)
    target_include_directories(ds41_xe PUBLIC ${_xe_dir} ${CMAKE_CURRENT_SOURCE_DIR}/include ${_v41_dir})
    target_link_libraries(ds41_xe PUBLIC ds41_moe_cpu strata_kernels_cpu)
    target_compile_options(ds41_xe PRIVATE -fsycl)
    if(STRATA_XE_AOT)
        target_compile_options(ds41_xe PRIVATE -fsycl-targets=spir64_gen "SHELL:-Xsycl-target-backend=spir64_gen \"-device ${STRATA_XE_AOT}\"")
        set(_xe_link -fsycl -fsycl-targets=spir64_gen "SHELL:-Xsycl-target-backend=spir64_gen \"-device ${STRATA_XE_AOT}\"")
    else()
        set(_xe_link -fsycl)
    endif()
    add_executable(ds41_generate_xe ${_v41_dir}/ds41_generate.cpp ${_v41_dir}/ds41_dspark.cpp)
    target_compile_definitions(ds41_generate_xe PRIVATE DS41_XE DS41_HAVE_DSPARK $<$<BOOL:${STRATA_DSV41_FQ_OP}>:STRATA_DSV41_FQ_OP>)
    target_link_libraries(ds41_generate_xe PRIVATE ds41_dense ds41_xe)
    target_link_options(ds41_generate_xe PRIVATE ${_xe_link})
    add_executable(test_ds41_xe ${_xe_dir}/test_ds41_xe.cpp)
    target_link_libraries(test_ds41_xe PRIVATE ds41_xe ggml-cpu ggml-base)
    target_compile_options(test_ds41_xe PRIVATE -fsycl)
    target_link_options(test_ds41_xe PRIVATE ${_xe_link})
endif()
