+void ggml_sycl_op_dsv41_li_dec(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/7);
+    const ggml_tensor * q = dst->src[0], * k = dst->src[1], * w = dst->src[2], * nvis = dst->src[3], * tab = dst->src[4];
+    const ggml_tensor * cand = dst->src[5], * lastblk = dst->src[6];
+    dsv41dec::LiArgs a;
+    a.n = (int) q->ne[2];
+    a.q = (const float *) q->data;
+    a.q_h = q->nb[1] / 4;
+    a.q_b = q->nb[2] / 4;
+    a.tab = (const float *) tab->data;
+    a.n_dims = ggml_get_op_params_i32(dst, 0);
+    a.fq = ggml_get_op_params_i32(dst, 8) != 0;
+    a.w = (const float *) w->data;
+    a.w_b = w->nb[1] / 4;
+    a.wscale = ggml_get_op_params_f32(dst, 9);
+    a.k = (const dsv41dec::li_bf16 *) k->data;
+    a.ld_k = (int64_t) (k->nb[1] / 2);
+    a.NKV = k->ne[1];
+    a.nvis = (const float *) nvis->data;
+    if (cand) {
+        a.cand = (const int32_t *) cand->data;
+        a.cand_b = cand->nb[1] / 4;
+        a.ncb = (int) cand->ne[0];
+    }
+    a.o = (float *) dst->data;
+    a.ld_o = a.NKV;
+    if (lastblk) {
+        a.lastblk = (const float *) lastblk->data;
+        a.bmax = a.o + a.NKV * a.n;
+        a.ld_bm = a.NKV / 8;
+    }
+    // scratch, freed in reverse order (the VMM pool frees in stack order)
+    ggml_sycl_pool_alloc<dsv41dec::li_bf16> qp(ctx.pool(), (size_t) a.n * 4096);
+    ggml_sycl_pool_alloc<float> ws(ctx.pool(), (size_t) a.n * dsv41dec::LIH);
+    ggml_sycl_pool_alloc<uint32_t> bits(ctx.pool(), (size_t) (cand ? a.n * dsv41dec::li_words(a.NKV) : 1));
+    a.qp = qp.get();
+    a.ws = ws.get();
+    a.bits = bits.get();
+    dsv41dec::li_prep(*ctx.stream(), a);
+    dsv41dec::li_run(*ctx.stream(), a);
+}
+
+void ggml_sycl_op_dsv41_sel_fin(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/4);
+    const ggml_tensor * ids = dst->src[0], * nvis = dst->src[1], * sel = dst->src[2], * selm = dst->src[3];
+    dsv41dec::SelArgs a;
+    a.ids = (const int32_t *) ids->data;
+    a.ids_b = ids->nb[1] / 4;
+    a.nvis = (const float *) nvis->data;
+    a.sel = (int32_t *) sel->data;
+    a.sel_b = sel->nb[1] / 4;
+    a.selm = (float *) selm->data;
+    a.selm_b = selm->nb[1] / 4;
+    a.K = (int) ids->ne[0];
+    a.n = (int) ids->ne[1];
+    dsv41dec::sel_fin(*ctx.stream(), a);
+}
