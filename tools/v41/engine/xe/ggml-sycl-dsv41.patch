+// ---- larry: the decode-width attention core (dsv41-dec.hpp).  The RoPE parameters sit in the op params from i0 as
+// ggml.c's ggml_dsv41_set_rope wrote them; theta_scale and the YaRN corr dims are derived on the host as ggml-sycl's rope
+// does.
+static dsv41dec::Rope dsv41_rope_params(const ggml_tensor * t, int i0) {
+    dsv41dec::Rope r;
+    r.n_dims = ggml_get_op_params_i32(t, i0 + 0);
+    const int n_ctx_orig = ggml_get_op_params_i32(t, i0 + 1);
+    const float freq_base = ggml_get_op_params_f32(t, i0 + 2);
+    r.freq_scale = ggml_get_op_params_f32(t, i0 + 3);
+    r.ext_factor = ggml_get_op_params_f32(t, i0 + 4);
+    r.attn_factor = ggml_get_op_params_f32(t, i0 + 5);
+    const float beta_fast = ggml_get_op_params_f32(t, i0 + 6), beta_slow = ggml_get_op_params_f32(t, i0 + 7);
+    r.theta_scale = powf(freq_base, -2.0f / r.n_dims);
+    float corr[2];
+    ggml_rope_yarn_corr_dims(r.n_dims, n_ctx_orig, freq_base, beta_fast, beta_slow, corr);
+    r.corr0 = corr[0];
+    r.corr1 = corr[1];
+    return r;
+}
