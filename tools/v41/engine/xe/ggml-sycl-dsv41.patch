+            struct ggml_tensor  * ids,
+            struct ggml_tensor  * nvis,
+            struct ggml_tensor  * sel,
+            struct ggml_tensor  * selm);
+    // ggml_dsv41_oproj with o's q8 (ggml_dsv41_attn_dec_q8's, OGD = hpg * 512) - the first quantisation skipped
+    GGML_API struct ggml_tensor * ggml_dsv41_oproj_q8(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * o,
+            struct ggml_tensor  * o8,
+            struct ggml_tensor  * wo_a,
+            struct ggml_tensor  * wo_b);
+
