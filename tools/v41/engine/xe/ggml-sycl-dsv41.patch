+struct ggml_tensor * ggml_dsv41_mvq(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * w,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * x8) {
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && x8->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_nelements(x8) == ggml_dsv41_q8_floats(x->ne[0], x->ne[1] * x->ne[2] * x->ne[3]));
+    struct ggml_tensor * result = ggml_mul_mat(ctx, w, x);
+    result->op     = GGML_OP_DSV41_MVQ;
