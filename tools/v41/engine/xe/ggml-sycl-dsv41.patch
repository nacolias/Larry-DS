+static bool li_gemm_ok(const ggml_tensor * dst) {
+    static const int on = [] { const char * v = std::getenv("GGML_SYCL_LI_GEMM"); return v && *v ? std::atoi(v) : 1; }();
+    static const int min_b = [] { const char * v = std::getenv("GGML_SYCL_LI_GEMM_MIN"); return v && *v ? std::atoi(v) : 32; }();
+    if (!on) return false;
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    if (q->ne[3] != 1 || k->ne[3] != 1 || q->ne[2] < min_b) return false;
+    return k->type == GGML_TYPE_F16 || k->type == GGML_TYPE_BF16 || k->type == GGML_TYPE_F32;
+}
