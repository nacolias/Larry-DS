+        if (!reorder_qw_q6_k_moe((uint8_t *) wa->data, sb, OG, st)) return false;
+        g_larry_slice_planar.insert(wa->data);
+    }
+    ggml_tensor_extra_gpu * extra = static_cast<ggml_tensor_extra_gpu *>(wb->extra);
+    if (!extra) return false;
