+// ggml_compute_forward_dsv41_router (larry): the reference of ggml-sycl's fused DeepSeek-V4.1 Gate (one thread)
+void ggml_compute_forward_dsv41_router(const ggml_compute_params * params, ggml_tensor * dst) {
+    if (params->ith != 0) return;
+    const ggml_tensor * lg = dst->src[0];
+    const float * bias = (const float *) dst->src[1]->data;
+    const float * sb = (const float *) dst->src[2]->data;
+    const int k = ggml_get_op_params_i32(dst, 0);
+    const bool norm = ggml_get_op_params_i32(dst, 1) != 0;
+    const float scale = ggml_get_op_params_f32(dst, 2);
+    const int64_t ne = lg->ne[0], nt = dst->ne[1];
+    std::vector<float> sc((size_t) ne), sel((size_t) ne);
+    for (int64_t t = 0; t < nt; ++t) {
+        const float * x = (const float *) lg->data + t * ne;
+        for (int64_t i = 0; i < ne; ++i) {
+            const float ax = std::fabs(x[i]);
+            sc[(size_t) i] = std::sqrt(std::max(x[i], 0.0f) + std::log1p(std::exp(-ax)));
+            sel[(size_t) i] = sc[(size_t) i] + bias[i] + sb[i];
+        }
+        float * o = (float *) ((char *) dst->data + t * dst->nb[1]);
+        float sum = 0.0f;
+        for (int r = 0; r < k; ++r) {
+            int64_t best = -1;
+            for (int64_t i = 0; i < ne; ++i)
+                if (sel[(size_t) i] > -INFINITY && (best < 0 || sel[(size_t) i] > sel[(size_t) best])) best = i;
+            o[r] = (float) best;
+            o[k + r] = sc[(size_t) best];
+            sum += sc[(size_t) best];
+            sel[(size_t) best] = -INFINITY;
+        }
+        for (int r = 0; r < k; ++r) o[k + r] = (norm ? o[k + r] / (sum + 1e-20f) : o[k + r]) * scale;
+    }
+}
+
+// ggml_compute_forward_dsv41_kgather (larry): the reference of ggml-sycl's fused per-query attention-key gather
+void ggml_compute_forward_dsv41_kgather(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * win = dst->src[0];
+    const ggml_tensor * widx = dst->src[1];
+    const ggml_tensor * comp = dst->src[2];
+    const ggml_tensor * sel = dst->src[3];
+    const int64_t DH = dst->ne[0], M = dst->ne[1], n = dst->ne[3];
+    const int64_t SWA = ggml_get_op_params_i32(dst, 0);
+    std::vector<float> tmp((size_t) DH);
+    for (int64_t row = params->ith; row < n * M; row += params->nth) {
+        const int64_t m = row % M, t = row / M;
+        const float * src = nullptr;
+        if (m < SWA) {
+            src = (const float *) ((const char *) win->data + (size_t) ((const int32_t *) widx->data)[t * SWA + m] * win->nb[1]);
+        } else {
+            const int32_t r = *(const int32_t *) ((const char *) sel->data + (size_t) t * sel->nb[1] + (size_t) (m - SWA) * 4);
+            const char * s = (const char *) comp->data + (size_t) r * comp->nb[1];
+            if (comp->type == GGML_TYPE_F32) src = (const float *) s;
+            else { ggml_get_type_traits(comp->type)->to_float(s, tmp.data(), DH); src = tmp.data(); }
+        }
+        if (dst->type == GGML_TYPE_F32) {
+            float * of = (float *) dst->data + (size_t) row * DH;
+            for (int64_t d = 0; d < DH; ++d) of[d] = src[d];
+            continue;
+        }
+        ggml_fp16_t * o = (ggml_fp16_t *) dst->data + (size_t) row * DH;
+        for (int64_t d = 0; d < DH; ++d) o[d] = GGML_CPU_FP32_TO_FP16(src[d]);
+    }
+}
+
+// ggml_compute_forward_dsv41_norm_mv (larry): the reference of ggml-sycl's RMS-normed mat-vec
+void ggml_compute_forward_dsv41_norm_mv(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * w = dst->src[0];
+    const ggml_tensor * x = dst->src[1];
+    const int64_t C = w->ne[0], R = w->ne[1], n = dst->ne[1];
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    for (int64_t j = params->ith; j < R * n; j += params->nth) {
+        const int64_t r = j % R, t = j / R;
+        const float * xt = (const float *) x->data + t * C;
+        double dot = 0, sq = 0;
+        for (int64_t c = 0; c < C; ++c) {
+            const float wv = w->type == GGML_TYPE_F16 ? GGML_CPU_FP16_TO_FP32(((const ggml_fp16_t *) w->data)[r * C + c])
+                                                      : ((const float *) w->data)[r * C + c];
+            dot += (double) wv * xt[c];
+            sq += (double) xt[c] * xt[c];
+        }
+        ((float *) dst->data)[t * R + r] = (float) dot * (1.0f / std::sqrt((float) (sq / C) + eps));
+    }
+}
+
+// ggml_compute_forward_dsv41_swiglu_lim (larry): the reference of ggml-sycl's clamped SwiGLU on gate|up rows
+void ggml_compute_forward_dsv41_swiglu_lim(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * y = dst->src[0];
+    const int64_t N = dst->ne[0], n = dst->ne[1];
+    const float lim = ggml_get_op_params_f32(dst, 0);
+    for (int64_t j = params->ith; j < N * n; j += params->nth) {
+        const int64_t i = j % N, t = j / N;
+        const float * yt = (const float *) y->data + t * 2 * N;
+        float g = yt[i], u = yt[N + i];
+        if (lim > 0) { g = g > lim ? lim : g; u = u > lim ? lim : (u < -lim ? -lim : u); }
+        ((float *) dst->data)[t * N + i] = g / (1.0f + std::exp(-g)) * u;
+    }
+}
