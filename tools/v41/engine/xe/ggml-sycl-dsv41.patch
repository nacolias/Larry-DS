+// native device memory, resident on this card only (no UR/UMF peer residency); nullptr on failure
+static sycl::half * larry_f16c_alloc(queue_ptr stream, size_t ne) {
+    ze_context_handle_t zc = sycl::get_native<sycl::backend::ext_oneapi_level_zero>(stream->get_context());
+    ze_device_handle_t zd = sycl::get_native<sycl::backend::ext_oneapi_level_zero>(stream->get_device());
+    ze_device_mem_alloc_desc_t d = {ZE_STRUCTURE_TYPE_DEVICE_MEM_ALLOC_DESC, nullptr, 0, 0};
+    void * p = nullptr;
+    const size_t bytes = ne * sizeof(sycl::half);
+    if (zeMemAllocDevice(zc, &d, bytes, 4096, zd, &p) != ZE_RESULT_SUCCESS || !p) return nullptr;
+    if (zeContextMakeMemoryResident(zc, zd, p, bytes) != ZE_RESULT_SUCCESS) { zeMemFree(zc, p); return nullptr; }
+    return (sycl::half *) p;
+}
+
+// the fp16 copy of the weight data at src (ne values), conv(y) writing it if it is not cached; nullptr = over budget
+template <typename F>
+static const sycl::half * larry_f16cache_core(const void * src, size_t ne, F && conv, queue_ptr stream) {
+    static const double mb = [] { const char * e = std::getenv("GGML_SYCL_LARRY_F16CACHE_MB"); return e ? std::atof(e) : 768.0; }();
+    const size_t budget = (size_t) (mb * 1048576.0);
+    if (budget == 0 || ne * 2 > budget) return nullptr;
+    for (auto & e : g_larry_f16c)
+        if (e.src == src && e.ne == ne) { e.tick = ++g_larry_f16c_tick; return e.f16; }
+    larry_f16c_entry * slot = nullptr;   // the least recently used entry big enough (reused in place, in queue order)
+    if (g_larry_f16c_bytes + ne * 2 > budget)
+        for (auto & e : g_larry_f16c)
+            if (e.cap >= ne && (!slot || e.tick < slot->tick)) slot = &e;
+    if (!slot) {
+        if (g_larry_f16c_bytes + ne * 2 > budget) return nullptr;   // nothing fits: the pool path, as before
+        static const double keep_mb = [] { const char * e = std::getenv("GGML_SYCL_LARRY_F16CACHE_FREE_MB"); return e ? std::atof(e) : 3072.0; }();
+        size_t free_b = 0;
+        try { free_b = stream->get_device().get_info<sycl::ext::intel::info::device::free_memory>(); } catch (...) { return nullptr; }
+        if ((double) free_b < (double) (ne * 2) + keep_mb * 1048576.0) return nullptr;   // the prompt's own buffers first
+        sycl::half * p = larry_f16c_alloc(stream, ne);
+        if (!p) return nullptr;
+        g_larry_f16c.push_back({nullptr, 0, p, ne, 0});
+        g_larry_f16c_bytes += ne * 2;
+        g_larry_f16c_q = stream;
+        slot = &g_larry_f16c.back();
+    }
+    conv(slot->f16);
+    slot->src = src;
+    slot->ne = ne;
+    slot->tick = ++g_larry_f16c_tick;
+    return slot->f16;
+}
+
+// the fp16 copy of weight src0 (a leaf, not a view; its data at src, ne values); nullptr = not cacheable / over budget
+static const sycl::half * larry_f16cache_get(const ggml_tensor * src0, const void * src, size_t ne, to_fp16_sycl_t conv,
+                                             queue_ptr stream) {
+    if (src0->op != GGML_OP_NONE || src0->view_src != nullptr) return nullptr;
+    return larry_f16cache_core(src, ne, [&](sycl::half * y) { conv(src, y, (int64_t) ne, stream); }, stream);
+}
+
+void ggml_backend_sycl_larry_f16cache_release(void) {
+    if (g_larry_f16c.empty()) return;
+    if (g_larry_f16c_q) g_larry_f16c_q->wait();
+    ze_context_handle_t zc = sycl::get_native<sycl::backend::ext_oneapi_level_zero>(g_larry_f16c_q->get_context());
+    for (auto & e : g_larry_f16c) zeMemFree(zc, e.f16);
+    g_larry_f16c.clear();
+    g_larry_f16c_bytes = 0;
+}
