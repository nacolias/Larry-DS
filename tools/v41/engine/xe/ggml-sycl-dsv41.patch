+
+// the fp16 copy of the weight data at src (ne values), conv(y) writing it if it is not cached; nullptr = over budget
+template <typename F>
+static const sycl::half * larry_f16cache_core(const void * src, size_t ne, F && conv, queue_ptr stream) {
+    static const double mb = [] { const char * e = std::getenv("GGML_SYCL_LARRY_F16CACHE_MB"); return e ? std::atof(e) : 768.0; }();
+    const size_t budget = (size_t) (mb * 1048576.0);
+    if (budget == 0 || ne * 2 > budget) return nullptr;
+    for (auto & e : g_larry_f16c)
+        if (e.src == src && e.ne == ne) { e.tick = ++g_larry_f16c_tick; return e.f16; }
+    larry_f16c_entry * slot = nullptr;   // the least recently used entry big enough (reused in place, in queue order)
+    if (g_larry_f16c_bytes + ne * 2 > budget)
+        for (auto & e : g_larry_f16c)
+            if (e.cap >= ne && (!slot || e.tick < slot->tick)) slot = &e;
+    if (!slot) {
+        if (g_larry_f16c_bytes + ne * 2 > budget) return nullptr;   // nothing fits: the pool path, as before
+        static const double keep_mb = [] { const char * e = std::getenv("GGML_SYCL_LARRY_F16CACHE_FREE_MB"); return e ? std::atof(e) : 3072.0; }();
+        size_t free_b = 0;
+        try { free_b = stream->get_device().get_info<sycl::ext::intel::info::device::free_memory>(); } catch (...) { return nullptr; }
+        if ((double) free_b < (double) (ne * 2) + keep_mb * 1048576.0) return nullptr;   // the prompt's own buffers first
+        sycl::half * p = larry_f16c_alloc(stream, ne);
+        if (!p) return nullptr;
