+
+// ---- larry (DeepSeek-V4.1 prompts): the indexer as ONE fp16 GEMM on XMX + a head-reduction kernel.
+// scores[j, b] = sum_h w[h, b] * relu(q[:, h, b] . k[:, j]) + mask[j, b].  Every query of the batch scores the same
+// keys, so S = Q [n_batch*n_head x n_embd] . K [n_kv x n_embd]^T is one GEMM (the per-row kernel above runs at
+// ~0.35 TFLOPS for 512 queries x 2K keys: 24.5 ms).  Keys are taken in chunks so S stays <= ~256 MiB at any context.
+// Used for n_batch >= GGML_SYCL_LI_GEMM_MIN (32), one stream, F16 / BF16 / F32 keys; GGML_SYCL_LI_GEMM=0 = off.
+#include <oneapi/mkl.hpp>
+#include <cstdlib>
+
+static bool li_gemm_ok(const ggml_tensor * dst) {
+    static const int on = [] { const char * v = std::getenv("GGML_SYCL_LI_GEMM"); return v && *v ? std::atoi(v) : 1; }();
+    static const int min_b = [] { const char * v = std::getenv("GGML_SYCL_LI_GEMM_MIN"); return v && *v ? std::atoi(v) : 32; }();
+    if (!on) return false;
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    if (q->ne[3] != 1 || k->ne[3] != 1 || q->ne[2] < min_b) return false;
+    return k->type == GGML_TYPE_F16 || k->type == GGML_TYPE_BF16 || k->type == GGML_TYPE_F32;
+}
+
+static void li_gemm(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    namespace mkl = oneapi::mkl;
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const ggml_tensor * w = dst->src[2];
+    const ggml_tensor * m = dst->src[3];
+    const int64_t E = q->ne[0], H = q->ne[1], B = q->ne[2], NKV = k->ne[2];
+    const size_t nbq1 = q->nb[1], nbq2 = q->nb[2], nbk2 = k->nb[2], nbw1 = w->nb[1], nbm1 = m->nb[1], nb1 = dst->nb[1];
+    const ggml_type kt = k->type;
+    queue_ptr stream = ctx.stream();
+    ggml_sycl_pool & pool = ctx.pool();
+    ggml_sycl_pool_alloc<sycl::half> Qh(pool, (size_t) B * H * E);
+    ggml_sycl_pool_alloc<sycl::half> Kh(pool, (size_t) NKV * E);
+    sycl::half * qh = Qh.get();
+    sycl::half * kh = Kh.get();
+    const char * qd = (const char *) q->data;
+    const char * kd = (const char *) k->data;
+    stream->parallel_for(sycl::range<1>((size_t) B * H * E), [=](sycl::id<1> id) {
+        const size_t i = id[0];
+        const int64_t e = (int64_t) (i % E), h = (int64_t) ((i / E) % H), b = (int64_t) (i / (E * H));
+        qh[i] = (sycl::half) *(const float *) (qd + b * nbq2 + h * nbq1 + e * sizeof(float));
+    });
+    stream->parallel_for(sycl::range<1>((size_t) NKV * E), [=](sycl::id<1> id) {
+        const size_t i = id[0];
+        const int64_t e = (int64_t) (i % E), j = (int64_t) (i / E);
+        const char * row = kd + j * nbk2;
+        float v;
+        if (kt == GGML_TYPE_F16) v = (float) ((const sycl::half *) row)[e];
+        else if (kt == GGML_TYPE_BF16) v = (float) ((const sycl::ext::oneapi::bfloat16 *) row)[e];
+        else v = ((const float *) row)[e];
+        kh[i] = (sycl::half) v;
+    });
+    const int64_t MR = B * H;
+    int64_t CH = (int64_t) ((256ull << 20) / ((size_t) MR * sizeof(float)));
+    CH = std::max<int64_t>(256, std::min<int64_t>(CH, NKV)) / 16 * 16;
+    if (CH <= 0) CH = 16;
+    ggml_sycl_pool_alloc<float> S(pool, (size_t) MR * CH);
+    float * s = S.get();
+    const char * wd = (const char *) w->data;
+    const char * md = (const char *) m->data;
+    float * od = (float *) dst->data;
+    for (int64_t j0 = 0; j0 < NKV; j0 += CH) {
+        const int64_t nc = std::min<int64_t>(CH, NKV - j0);
+        mkl::blas::row_major::gemm(*stream, mkl::transpose::nontrans, mkl::transpose::trans, MR, nc, E, 1.0f, qh, E,
+                                   kh + j0 * E, E, 0.0f, s, nc);
+        stream->parallel_for(sycl::range<2>((size_t) B, (size_t) nc), [=](sycl::id<2> id) {
+            const int64_t b = (int64_t) id[0], jj = (int64_t) id[1];
+            const float * wb = (const float *) (wd + b * nbw1);
+            float acc = 0.0f;
+            for (int64_t h = 0; h < H; ++h) acc += sycl::fmax(s[(b * H + h) * nc + jj], 0.0f) * wb[h];
+            const sycl::half * mb = (const sycl::half *) (md + b * nbm1);
+            od[(j0 + jj) + b * (int64_t) (nb1 / sizeof(float))] = acc + (float) mb[j0 + jj];
+        });
+    }
+}
