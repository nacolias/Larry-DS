+struct ggml_tensor * ggml_dsv41_router(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * logits,
+        struct ggml_tensor  * bias,
+        struct ggml_tensor  * sel_bias,
+        int                   k,
+        bool                  norm,
+        float                 scale) {
+    GGML_ASSERT(logits->type == GGML_TYPE_F32 && ggml_is_contiguous(logits));
+    GGML_ASSERT(bias->type == GGML_TYPE_F32 && ggml_nelements(bias) == logits->ne[0] && ggml_is_contiguous(bias));
+    GGML_ASSERT(sel_bias->type == GGML_TYPE_F32 && ggml_nelements(sel_bias) == logits->ne[0] && ggml_is_contiguous(sel_bias));
+    GGML_ASSERT(k >= 1 && k <= 8 && k <= logits->ne[0] && logits->ne[0] <= 1024);   // ggml-sycl: k <= 8, ne <= 1024
+    const int64_t nt = logits->ne[1] * logits->ne[2] * logits->ne[3];
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 2 * k, nt);
+    ggml_set_op_params_i32(result, 0, k);
+    ggml_set_op_params_i32(result, 1, norm ? 1 : 0);
+    ggml_set_op_params_f32(result, 2, scale);
+    result->op     = GGML_OP_DSV41_ROUTER;
+    result->src[0] = logits;
+    result->src[1] = bias;
+    result->src[2] = sel_bias;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_kgather(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * win,
+        struct ggml_tensor  * widx,
+        struct ggml_tensor  * comp,
+        struct ggml_tensor  * sel,
+        int                   swa) {
+    GGML_ASSERT(win->type == GGML_TYPE_F32 && win->nb[0] == 4 && win->ne[2] == 1 && win->ne[3] == 1);
+    GGML_ASSERT(widx->type == GGML_TYPE_I32 && ggml_is_contiguous(widx) && swa > 0 && ggml_nelements(widx) % swa == 0);
+    GGML_ASSERT((comp == NULL) == (sel == NULL));
+    const int64_t DH = win->ne[0], n = ggml_nelements(widx) / swa;
+    int64_t K = 0;
+    if (comp) {
+        GGML_ASSERT(comp->type == GGML_TYPE_F32 || comp->type == GGML_TYPE_F16 || comp->type == GGML_TYPE_BF16);
+        GGML_ASSERT(comp->ne[0] == DH && comp->nb[0] == ggml_type_size(comp->type));
+        GGML_ASSERT(sel->type == GGML_TYPE_I32 && sel->nb[0] == 4 && sel->ne[1] == n && sel->ne[2] == 1 && sel->ne[3] == 1);
+        K = sel->ne[0];
+    }
+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, DH, swa + K, 1, n);
+    ggml_set_op_params_i32(result, 0, swa);
+    result->op     = GGML_OP_DSV41_KGATHER;
+    result->src[0] = win;
+    result->src[1] = widx;
+    result->src[2] = comp;
+    result->src[3] = sel;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_kgather2(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * win,
+        struct ggml_tensor  * widx,
+        struct ggml_tensor  * comp,
+        struct ggml_tensor  * sel,
+        int                   swa,
+        enum ggml_type        type) {
+    GGML_ASSERT(type == GGML_TYPE_F16 || type == GGML_TYPE_F32);
+    struct ggml_tensor * r = ggml_dsv41_kgather(ctx, win, widx, comp, sel, swa);
+    if (type == GGML_TYPE_F32) {
+        struct ggml_tensor * result = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, r->ne[0], r->ne[1], r->ne[2], r->ne[3]);
+        ggml_set_op_params_i32(result, 0, swa);
+        result->op = GGML_OP_DSV41_KGATHER;
+        for (int i = 0; i < 4; ++i) result->src[i] = r->src[i];
+        return result;
+    }
+    return r;
+}
+
+struct ggml_tensor * ggml_dsv41_norm_mv(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * w,
+        struct ggml_tensor  * x,
+        float                 eps) {
+    GGML_ASSERT((w->type == GGML_TYPE_F16 || w->type == GGML_TYPE_F32) && ggml_is_contiguous(w));
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && ggml_is_contiguous(x) && x->ne[0] == w->ne[0]);
+    const int64_t n = x->ne[1] * x->ne[2] * x->ne[3];
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, w->ne[1], n);
+    ggml_set_op_params_f32(result, 0, eps);
+    result->op     = GGML_OP_DSV41_NORM_MV;
+    result->src[0] = w;
+    result->src[1] = x;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_swiglu_lim(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * y,
+        float                 lim) {
+    GGML_ASSERT(y->type == GGML_TYPE_F32 && ggml_is_contiguous(y) && y->ne[0] % 2 == 0);
+    const int64_t n = y->ne[1] * y->ne[2] * y->ne[3];
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, y->ne[0] / 2, n);
+    ggml_set_op_params_f32(result, 0, lim);
+    result->op     = GGML_OP_DSV41_SWIGLU_LIM;
+    result->src[0] = y;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_hc_post2(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * res,
+        struct ggml_tensor  * post,
+        struct ggml_tensor  * comb,
+        struct ggml_tensor  * dst) {
+    const int64_t D = a->ne[0], n = a->ne[1], hc = res->ne[1];
+    GGML_ASSERT(a->type == GGML_TYPE_F32 && a->nb[0] == sizeof(float) && a->ne[2] == 1 && a->ne[3] == 1);
+    GGML_ASSERT(!b || (b->type == GGML_TYPE_F32 && b->nb[0] == sizeof(float) && ggml_are_same_shape(a, b)));
+    GGML_ASSERT(res->type == GGML_TYPE_F32 && res->nb[0] == sizeof(float) && res->ne[0] == D && res->ne[2] == n);
+    GGML_ASSERT(post->type == GGML_TYPE_F32 && post->nb[0] == sizeof(float) && post->ne[0] == hc && post->ne[1] == n);
+    GGML_ASSERT(comb->type == GGML_TYPE_F32 && comb->nb[0] == sizeof(float) && comb->ne[0] == hc && comb->ne[1] == hc &&
+                comb->ne[2] == n);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && dst->nb[0] == sizeof(float) && dst->ne[0] == D && dst->ne[1] == hc &&
+                dst->ne[2] == n);
+    struct ggml_tensor * result = ggml_view_tensor(ctx, dst);
+    result->op     = GGML_OP_DSV41_HC_POST2;
+    result->src[0] = a;
+    result->src[1] = b;
+    result->src[2] = res;
+    result->src[3] = post;
+    result->src[4] = comb;
+    result->src[5] = dst;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_hc_fa(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * fn,
+        struct ggml_tensor  * pre,
+        struct ggml_tensor  * y,
+        struct ggml_tensor  * post,
+        struct ggml_tensor  * comb) {
+    const int64_t D = x->ne[0], hc = x->ne[1], n = x->ne[2];
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && x->nb[0] == sizeof(float) && x->ne[3] == 1 && hc == 4 && D % 128 == 0);
+    GGML_ASSERT((fn->type == GGML_TYPE_F16 || fn->type == GGML_TYPE_F32) && ggml_is_contiguous(fn));
+    GGML_ASSERT(fn->ne[0] == hc * D && fn->ne[1] == (2 + hc) * hc);
+    GGML_ASSERT(pre->type == GGML_TYPE_F32 && pre->nb[0] == sizeof(float) && pre->ne[0] == hc && pre->ne[1] == n);
+    GGML_ASSERT((y == NULL) == (post == NULL) && (y == NULL) == (comb == NULL));
+    if (y) {
+        GGML_ASSERT(y->type == GGML_TYPE_F32 && y->nb[0] == sizeof(float) && y->ne[0] == D && y->ne[1] == n);
+        GGML_ASSERT(post->type == GGML_TYPE_F32 && post->nb[0] == sizeof(float) && post->ne[0] == hc && post->ne[1] == n);
+        GGML_ASSERT(comb->type == GGML_TYPE_F32 && comb->nb[0] == sizeof(float) && comb->ne[0] == hc &&
+                    comb->ne[1] == hc && comb->ne[2] == n);
+    }
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n * (hc * D + D + 32 * (D / 128)));
+    ggml_set_op_params_i32(result, 0, (int32_t) D);
+    ggml_set_op_params_i32(result, 1, (int32_t) hc);
+    ggml_set_op_params_i32(result, 2, (int32_t) n);
+    result->op     = GGML_OP_DSV41_HC_FA;
+    result->src[0] = x;
+    result->src[1] = fn;
+    result->src[2] = pre;
+    result->src[3] = y;
+    result->src[4] = post;
+    result->src[5] = comb;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_hc_fb(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * fa,
+        struct ggml_tensor  * scale,
+        struct ggml_tensor  * base,
+        struct ggml_tensor  * w,
+        float                 eps,
+        float                 hc_eps,
+        int                   n_iter) {
+    GGML_ASSERT(fa->op == GGML_OP_DSV41_HC_FA && fa->type == GGML_TYPE_F32);
+    const int32_t D = ggml_get_op_params_i32(fa, 0), hc = ggml_get_op_params_i32(fa, 1), n = ggml_get_op_params_i32(fa, 2);
+    GGML_ASSERT(scale->type == GGML_TYPE_F32 && ggml_is_contiguous(scale) && ggml_nelements(scale) >= 3);
+    GGML_ASSERT(base->type == GGML_TYPE_F32 && ggml_is_contiguous(base) && ggml_nelements(base) == (2 + hc) * hc);
+    GGML_ASSERT(w->type == GGML_TYPE_F32 && ggml_is_contiguous(w) && ggml_nelements(w) == D);
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, (int64_t) n * (D + 2 * hc + hc * hc));
+    ggml_set_op_params_i32(result, 0, D);
+    ggml_set_op_params_i32(result, 1, hc);
+    ggml_set_op_params_i32(result, 2, n);
+    ggml_set_op_params_f32(result, 3, eps);
+    ggml_set_op_params_f32(result, 4, hc_eps);
+    ggml_set_op_params_i32(result, 5, n_iter);
+    result->op     = GGML_OP_DSV41_HC_FB;
+    result->src[0] = fa;
+    result->src[1] = scale;
+    result->src[2] = base;
+    result->src[3] = w;
+    return result;
+}
+
 struct ggml_tensor * ggml_dsv4_hc_pre(
         struct ggml_context * ctx,
         struct ggml_tensor  * x,
