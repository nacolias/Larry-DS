+// ggml-sycl/dsv41-fused.cpp - larry (Strata-DS4 on Intel): the two fused DeepSeek-V4.1 ops of Xolotl's ggml patch
+// (GGML_OP_DSV41_FAKE_QUANT, GGML_OP_DSV41_HC_MIXES) for the SYCL backend.  The CUDA versions (ggml-cuda/dsv4-hc.cu)
+// reproduce the stock-op composites of tools/v41/engine with float tricks (x + 1.5*2^23 - 1.5*2^23 for round-half-even,
+// Veltkamp splitting for powers of two); icpx compiles with fast-math reassociation by default, which may fold those,
+// so these use rint() and exponent-bit arithmetic instead - the same values for every finite input the ops see.
+#include "dsv41-fused.hpp"
+#include "dsv41-dec.hpp"
+
+#include <cmath>
+#include <cstdint>
+#include <type_traits>
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>   // (patch-hcwide.py)
+
+// exact IEEE arithmetic in the rounding helpers and kernels (icpx defaults to fast-math)
+#pragma float_control(precise, on, push)
+
+namespace {
+
+inline float fq_bits_f(uint32_t u) { return sycl::bit_cast<float>(u); }
+inline uint32_t fq_f_bits(float f) { return sycl::bit_cast<uint32_t>(f); }
+
+// smallest power of two >= a (a >= 0; 0 -> 0; subnormals flush to 0 like the CUDA composite's .ftz)
+inline float fq_pow2_ceil(float a) {
+    const uint32_t u = fq_f_bits(a);
+    const uint32_t e = (u >> 23) & 0xffu;
+    if (e == 0) return 0.0f;
+    if (e == 0xffu) return a;
+    const uint32_t m = u & 0x7fffffu;
+    return m == 0 ? fq_bits_f(e << 23) : fq_bits_f((e + 1) << 23);
+}
+
+// largest power of two <= a (a >= 0)
+inline float fq_pow2_floor(float a) {
+    const uint32_t u = fq_f_bits(a);
+    const uint32_t e = (u >> 23) & 0xffu;
+    if (e == 0) return 0.0f;
+    if (e == 0xffu) return a;
+    return fq_bits_f(e << 23);
+}
+
+// v rounded to a float format with `mbits` mantissa bits and smallest normal `min_normal` (round half to even)
+inline float fq_round_fmt(float v, int mbits, float min_normal) {
+    const float p = sycl::fmax(fq_pow2_floor(sycl::fabs(v)), min_normal);
+    const float k = (float) (1 << mbits);
+    const float r = sycl::rint(v / p * k) + 0.0f;   // + 0: -0 -> +0, as the composite's (y + C) - C rounding gives
+    return r / k * p;
+}
+
+template <int BS>
+void fake_quant_blocks(const float * x, float * y, int64_t nblocks, int mode, float maxv, float floor_, sycl::queue * q) {
+    const size_t wg = 64;
+    const size_t g = (size_t) ((nblocks + (int64_t) wg - 1) / (int64_t) wg) * wg;
+    q->parallel_for(sycl::nd_range<1>(sycl::range<1>(g), sycl::range<1>(wg)), [=](sycl::nd_item<1> it) {
+        const int64_t b = (int64_t) it.get_global_id(0);
+        if (b >= nblocks) return;
+        const float * xb = x + b * BS;
+        float * yb = y + b * BS;
+        float a = 0.0f;
+#pragma unroll
+        for (int i = 0; i < BS; ++i) a = sycl::fmax(a, sycl::fabs(xb[i]));
+        const float t = sycl::fmax(a, floor_) / maxv;
+        const float s = mode == 1 ? fq_round_fmt(t, 3, 0x1p-6f) : fq_pow2_ceil(t);
+#pragma unroll
+        for (int i = 0; i < BS; ++i) {
+            const float v = sycl::fmin(sycl::fmax(xb[i] / s, -maxv), maxv);
+            const float qv = mode == 0 ? fq_round_fmt(v, 3, 0x1p-6f) : fq_round_fmt(v, 1, 1.0f);
+            yb[i] = qv * s;
+        }
+    });
+}
+
+}  // namespace
+
+void ggml_sycl_op_dsv41_fake_quant(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/1);
+    const ggml_tensor * src0 = dst->src[0];
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 && ggml_is_contiguous(src0));
+    const int mode = ggml_get_op_params_i32(dst, 0);
+    const int64_t n = ggml_nelements(src0);
+    const float maxv = mode == 0 ? 448.0f : 6.0f;
+    const float floor_ = mode == 0 ? 1e-4f : mode == 1 ? 6.0f / 512.0f : 6.0f * 0x1p-126f;
+    queue_ptr stream = ctx.stream();
+    if (mode == 1) {
+        GGML_ASSERT(n % 16 == 0);
+        fake_quant_blocks<16>((const float *) src0->data, (float *) dst->data, n / 16, mode, maxv, floor_, stream);
+    } else {
+        GGML_ASSERT(n % 32 == 0);
+        fake_quant_blocks<32>((const float *) src0->data, (float *) dst->data, n / 32, mode, maxv, floor_, stream);
+    }
+}
+
+void ggml_sycl_op_dsv41_hc_mixes(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/3);
+    const ggml_tensor * mixes = dst->src[0];
+    const ggml_tensor * scale = dst->src[1];
+    const ggml_tensor * base  = dst->src[2];
+    GGML_ASSERT(mixes->type == GGML_TYPE_F32 && ggml_is_contiguous(mixes));
+    GGML_ASSERT(scale->type == GGML_TYPE_F32 && ggml_nelements(scale) == 2);
+    GGML_ASSERT(base->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->ne[1] % 2 == 0 && mixes->ne[0] >= dst->ne[0] * 2);
+    const int64_t hc = base->ne[0] / 2;
+    const int64_t nt = dst->ne[1] / 2;
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const int64_t n = 2 * hc * nt;
+    const int64_t nrow = mixes->ne[0];
+    const float * pm = (const float *) mixes->data;
+    const float * ps = (const float *) scale->data;
+    const float * pb = (const float *) base->data;
+    float * pd = (float *) dst->data;
+    queue_ptr stream = ctx.stream();
+    stream->parallel_for(sycl::range<1>((size_t) n), [=](sycl::id<1> id) {
+        const int64_t i = (int64_t) id[0];
+        const int64_t h = i % hc;
+        const int64_t col = i / hc;
+        const bool post = col >= nt;
+        const int64_t t = post ? col - nt : col;
+        const int64_t r = post ? hc + h : h;
+        const float v = pm[r + nrow * t] * ps[post ? 1 : 0] + pb[r];
+        const float s = 1.0f / (1.0f + sycl::exp(-v));
+        pd[i] = post ? 2.0f * s : s + eps;
+    });
+}
+
+#pragma float_control(pop)
+
+// GGML_OP_DSV41_ROUTER (larry): a work-group of 128 per token (8 sub-groups), every lane <= 8 of the experts; each
+// sub-group its own top k (k rounds of a sub-group argmax, ties: lower index), then sub-group 0 the top k of those
+void ggml_sycl_op_dsv41_router(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/3);
+    const ggml_tensor * lg = dst->src[0];
+    GGML_ASSERT(lg->type == GGML_TYPE_F32 && ggml_is_contiguous(lg) && dst->type == GGML_TYPE_F32);
+    const int k = ggml_get_op_params_i32(dst, 0);
+    const bool norm = ggml_get_op_params_i32(dst, 1) != 0;
+    const float scale = ggml_get_op_params_f32(dst, 2);
+    const int ne = (int) lg->ne[0];
+    const int64_t nt = dst->ne[1];
+    constexpr int WG = 128, NSG = WG / 16, VPL = 8, KMAX = 8;
+    GGML_ASSERT(ne <= WG * VPL && k <= KMAX);
+    const float * px = (const float *) lg->data;
+    const float * pb = (const float *) dst->src[1]->data;
+    const float * ps = (const float *) dst->src[2]->data;
+    float * pd = (float *) dst->data;
+    const size_t dstride = dst->nb[1] / 4;
+    // larry, ggml_dsv41_write_to: the ids (int) and weights also straight into their tensors
+    int32_t * pid = dst->src[3] ? (int32_t *) dst->src[3]->data : nullptr;
+    float * pwd = dst->src[4] ? (float *) dst->src[4]->data : nullptr;
+    const size_t ids_s = dst->src[3] ? dst->src[3]->nb[1] / 4 : 0, wd_s = dst->src[4] ? dst->src[4]->nb[1] / 4 : 0;
+    ctx.stream()->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> cv(sycl::range<1>(NSG * KMAX), h);   // candidates: selection value
+        sycl::local_accessor<int, 1> ci(sycl::range<1>(NSG * KMAX), h);     // expert id
+        sycl::local_accessor<float, 1> cw(sycl::range<1>(NSG * KMAX), h);   // sc (the weight)
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) nt * WG), sycl::range<1>(WG)),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+            const sycl::sub_group sg = it.get_sub_group();
+            const int lane = (int) sg.get_local_linear_id(), s = (int) sg.get_group_linear_id();
+            const int lid = (int) it.get_local_id(0);
+            const int64_t t = (int64_t) it.get_group(0);
+            const float * x = px + t * ne;
+            float sc[VPL], sel[VPL];
+#pragma unroll
+            for (int v = 0; v < VPL; ++v) {
+                const int i = lid + WG * v;
+                if (i < ne) {
+                    const float ax = sycl::fabs(x[i]);
+                    sc[v] = sycl::sqrt(sycl::fmax(x[i], 0.0f) + sycl::log1p(sycl::exp(-ax)));
+                    sel[v] = sc[v] + pb[i] + ps[i];
+                } else {
+                    sc[v] = 0.0f;
+                    sel[v] = -3.0e38f;
+                }
+            }
+            // this sub-group's top k
+            for (int r = 0; r < k; ++r) {
+                float bv = -3.0e38f, bw = 0.0f;
+                int bi = 1 << 30, bvv = 0;
+#pragma unroll
+                for (int v = 0; v < VPL; ++v)
+                    if (sel[v] > bv) { bv = sel[v]; bi = lid + WG * v; bw = sc[v]; bvv = v; }
+                const float gv = sycl::reduce_over_group(sg, bv, sycl::maximum<float>());
+                const int gi = sycl::reduce_over_group(sg, bv == gv ? bi : (1 << 30), sycl::minimum<int>());
+                if (bi == gi && bv == gv) {
+#pragma unroll
+                    for (int v = 0; v < VPL; ++v) if (v == bvv) sel[v] = -3.0e38f;
+                    cv[s * KMAX + r] = gv;
+                    ci[s * KMAX + r] = gi;
+                    cw[s * KMAX + r] = bw;
+                }
+            }
+            sycl::group_barrier(it.get_group());
+            if (s != 0) return;
+            // sub-group 0: the top k of the NSG * k candidates (lane holds candidates lane, lane + 16, ...)
+            constexpr int CPL = NSG * KMAX / 16;
+            float mv[CPL], mw[CPL];
+            int mi[CPL];
+#pragma unroll
+            for (int u = 0; u < CPL; ++u) {
+                const int c = lane + 16 * u, sgi = c / KMAX, rr = c % KMAX;
+                const bool ok = rr < k;
+                mv[u] = ok ? cv[sgi * KMAX + rr] : -3.0e38f;
+                mi[u] = ok ? ci[sgi * KMAX + rr] : (1 << 30);
+                mw[u] = ok ? cw[sgi * KMAX + rr] : 0.0f;
+            }
+            float w_my = 0.0f, sum = 0.0f;
+            int id_my = -1;
+            for (int r = 0; r < k; ++r) {
+                float bv = -3.0e38f, bw = 0.0f;
+                int bi = 1 << 30, bu = 0;
+#pragma unroll
+                for (int u = 0; u < CPL; ++u)
+                    if (mv[u] > bv || (mv[u] == bv && mi[u] < bi)) { bv = mv[u]; bi = mi[u]; bw = mw[u]; bu = u; }
+                const float gv = sycl::reduce_over_group(sg, bv, sycl::maximum<float>());
+                const int gi = sycl::reduce_over_group(sg, bv == gv ? bi : (1 << 30), sycl::minimum<int>());
+                float w = 0.0f;
+                if (bi == gi && bv == gv) {
+#pragma unroll
+                    for (int u = 0; u < CPL; ++u) if (u == bu) mv[u] = -3.0e38f;
+                    w = bw;
+                }
+                w = sycl::reduce_over_group(sg, w, sycl::plus<float>());
+                sum += w;
+                if (lane == r) { w_my = w; id_my = gi; }
+            }
+            if (lane < k) {
+                float * o = pd + (size_t) t * dstride;
+                const float wv = (norm ? w_my / (sum + 1e-20f) : w_my) * scale;
+                o[lane] = (float) id_my;
+                o[k + lane] = wv;
+                if (pid) pid[(size_t) t * ids_s + lane] = id_my;
+                if (pwd) pwd[(size_t) t * wd_s + lane] = wv;
+            }
+        });
+    });
+}
+
+// GGML_OP_DSV41_KGATHER (larry): query t's window rows (win at widx) then its compressed rows (comp at sel), each
+// converted to f16 once - one work-item per 8 values of an output row (16-byte loads and stores)
+void ggml_sycl_op_dsv41_kgather(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/4);
+    const ggml_tensor * win = dst->src[0];
+    const ggml_tensor * widx = dst->src[1];
+    const ggml_tensor * comp = dst->src[2];
+    const ggml_tensor * sel = dst->src[3];
+    const int64_t DH = dst->ne[0], M = dst->ne[1], n = dst->ne[3];
+    const int64_t SWA = ggml_get_op_params_i32(dst, 0);
+    // larry, patch-sdpa (ggml_dsv41_kgather_pad): rows of DP > DH halves, the M real ones, then the sink row, then zeros
+    const int64_t MR = ggml_get_op_params_i32(dst, 1);
+    if (MR > 0) {
+        const int64_t DS = win->ne[0], DP = DH, MP = M;
+        GGML_ASSERT(dst->type == GGML_TYPE_F16 && DS % 8 == 0 && DP % 8 == 0 && DP > DS && MP > MR && ggml_is_contiguous(dst));
+        GGML_ASSERT(win->type == GGML_TYPE_F32 && win->nb[1] % 16 == 0 && (!comp || comp->nb[1] % 16 == 0));
+        const char * pw = (const char *) win->data;
+        const size_t wnb = win->nb[1];
+        const int32_t * pwi = (const int32_t *) widx->data;
+        const char * pc = comp ? (const char *) comp->data : nullptr;
+        const size_t cnb = comp ? comp->nb[1] : 0;
+        const int ct = !comp ? 0 : comp->type == GGML_TYPE_BF16 ? 1 : comp->type == GGML_TYPE_F16 ? 2 : 0;
+        const char * ps = sel ? (const char *) sel->data : nullptr;
+        const size_t snb = sel ? sel->nb[1] : 0;
+        sycl::half * po = (sycl::half *) dst->data;
+        const int64_t VS = DS / 8, VP = DP / 8;
+        ctx.stream()->parallel_for(sycl::range<1>((size_t) n * MP * VP), [=](sycl::id<1> id) {
+            const size_t i = id[0];
+            const int64_t v = (int64_t) (i % VP), row = (int64_t) (i / VP), m = row % MP, t = row / MP;
+            sycl::vec<sycl::half, 8> o(0.0f);
+            if (m < MR && v < VS) {
+                float f[8];
+                if (m < SWA) {
+                    const float * s = (const float *) (pw + (size_t) pwi[t * SWA + m] * wnb) + v * 8;
+                    const sycl::float4 a = *(const sycl::float4 *) s, b = *(const sycl::float4 *) (s + 4);
+                    f[0] = a.x(); f[1] = a.y(); f[2] = a.z(); f[3] = a.w(); f[4] = b.x(); f[5] = b.y(); f[6] = b.z(); f[7] = b.w();
+                } else {
+                    const int32_t r = *(const int32_t *) (ps + (size_t) t * snb + (size_t) (m - SWA) * 4);
+                    const char * s = pc + (size_t) r * cnb;
+                    if (ct == 1) {
+                        const sycl::uint4 u = *(const sycl::uint4 *) (s + v * 16);
+                        const uint32_t w[4] = { u.x(), u.y(), u.z(), u.w() };
+#pragma unroll
+                        for (int j = 0; j < 4; ++j) { f[2 * j] = sycl::bit_cast<float>(w[j] << 16); f[2 * j + 1] = sycl::bit_cast<float>(w[j] & 0xffff0000u); }
+                    } else if (ct == 2) {
+                        const sycl::vec<sycl::half, 8> hv = *(const sycl::vec<sycl::half, 8> *) (s + v * 16);
+#pragma unroll
+                        for (int j = 0; j < 8; ++j) f[j] = (float) hv[j];
+                    } else {
+                        const float * sf = (const float *) s + v * 8;
+                        const sycl::float4 a = *(const sycl::float4 *) sf, b = *(const sycl::float4 *) (sf + 4);
+                        f[0] = a.x(); f[1] = a.y(); f[2] = a.z(); f[3] = a.w(); f[4] = b.x(); f[5] = b.y(); f[6] = b.z(); f[7] = b.w();
+                    }
+                }
+#pragma unroll
+                for (int j = 0; j < 8; ++j) o[j] = (sycl::half) f[j];
+            } else if (m == MR && v == VS) {
+                o[0] = (sycl::half) 1.0f;   // the sink key: 1 at dim DS
+            }
+            *(sycl::vec<sycl::half, 8> *) (po + (size_t) row * DP + v * 8) = o;
+        });
+        return;
+    }
+    GGML_ASSERT(DH % 8 == 0 && win->type == GGML_TYPE_F32 && ggml_is_contiguous(dst));
+    GGML_ASSERT(dst->type == GGML_TYPE_F16 || dst->type == GGML_TYPE_F32);
+    const bool out32 = dst->type == GGML_TYPE_F32;
+    float * po32 = (float *) dst->data;
+    GGML_ASSERT(win->nb[1] % 16 == 0 && (!comp || comp->nb[1] % 16 == 0));
+    const char * pw = (const char *) win->data;
+    const size_t wnb = win->nb[1];
+    const int32_t * pwi = (const int32_t *) widx->data;
+    const char * pc = comp ? (const char *) comp->data : nullptr;
+    const size_t cnb = comp ? comp->nb[1] : 0;
+    const int ct = !comp ? 0 : comp->type == GGML_TYPE_BF16 ? 1 : comp->type == GGML_TYPE_F16 ? 2 : 0;
+    const char * ps = sel ? (const char *) sel->data : nullptr;
+    const size_t snb = sel ? sel->nb[1] : 0;
+    sycl::half * po = (sycl::half *) dst->data;
+    const int64_t V = DH / 8;
+    const size_t total = (size_t) n * M * V;
+    ctx.stream()->parallel_for(sycl::range<1>(total), [=](sycl::id<1> id) {
+        const size_t i = id[0];
+        const int64_t v = (int64_t) (i % V), row = (int64_t) (i / V), m = row % M, t = row / M;
+        float f[8];
+        if (m < SWA) {
+            const float * s = (const float *) (pw + (size_t) pwi[t * SWA + m] * wnb) + v * 8;
+            const sycl::float4 a = *(const sycl::float4 *) s, b = *(const sycl::float4 *) (s + 4);
+            f[0] = a.x(); f[1] = a.y(); f[2] = a.z(); f[3] = a.w(); f[4] = b.x(); f[5] = b.y(); f[6] = b.z(); f[7] = b.w();
+        } else {
+            const int32_t r = *(const int32_t *) (ps + (size_t) t * snb + (size_t) (m - SWA) * 4);
+            const char * s = pc + (size_t) r * cnb;
+            if (ct == 1) {
+                const sycl::uint4 u = *(const sycl::uint4 *) (s + v * 16);
+                const uint32_t w[4] = { u.x(), u.y(), u.z(), u.w() };
+#pragma unroll
+                for (int j = 0; j < 4; ++j) { f[2 * j] = sycl::bit_cast<float>(w[j] << 16); f[2 * j + 1] = sycl::bit_cast<float>(w[j] & 0xffff0000u); }
+            } else if (ct == 2) {
+                const sycl::vec<sycl::half, 8> hv = *(const sycl::vec<sycl::half, 8> *) (s + v * 16);
+#pragma unroll
+                for (int j = 0; j < 8; ++j) f[j] = (float) hv[j];
+            } else {
+                const float * sf = (const float *) s + v * 8;
+                const sycl::float4 a = *(const sycl::float4 *) sf, b = *(const sycl::float4 *) (sf + 4);
+                f[0] = a.x(); f[1] = a.y(); f[2] = a.z(); f[3] = a.w(); f[4] = b.x(); f[5] = b.y(); f[6] = b.z(); f[7] = b.w();
+            }
+        }
+        if (out32) {
+            float * of = po32 + (size_t) row * DH + v * 8;
+            *(sycl::float4 *) of = sycl::float4(f[0], f[1], f[2], f[3]);
+            *(sycl::float4 *) (of + 4) = sycl::float4(f[4], f[5], f[6], f[7]);
+            return;
+        }
+        sycl::vec<sycl::half, 8> o;
+#pragma unroll
+        for (int j = 0; j < 8; ++j) o[j] = (sycl::half) f[j];
+        *(sycl::vec<sycl::half, 8> *) (po + (size_t) row * DH + v * 8) = o;
+    });
+}
