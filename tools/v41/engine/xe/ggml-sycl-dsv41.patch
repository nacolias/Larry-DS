+struct ggml_tensor * ggml_dsv41_hc_post2(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        struct ggml_tensor  * res,
+        struct ggml_tensor  * post,
+        struct ggml_tensor  * comb,
+        struct ggml_tensor  * dst) {
+    const int64_t D = a->ne[0], n = a->ne[1], hc = res->ne[1];
+    GGML_ASSERT(a->type == GGML_TYPE_F32 && a->nb[0] == sizeof(float) && a->ne[2] == 1 && a->ne[3] == 1);
+    GGML_ASSERT(!b || (b->type == GGML_TYPE_F32 && b->nb[0] == sizeof(float) && ggml_are_same_shape(a, b)));
+    GGML_ASSERT(res->type == GGML_TYPE_F32 && res->nb[0] == sizeof(float) && res->ne[0] == D && res->ne[2] == n);
+    GGML_ASSERT(post->type == GGML_TYPE_F32 && post->nb[0] == sizeof(float) && post->ne[0] == hc && post->ne[1] == n);
+    GGML_ASSERT(comb->type == GGML_TYPE_F32 && comb->nb[0] == sizeof(float) && comb->ne[0] == hc && comb->ne[1] == hc &&
+                comb->ne[2] == n);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && dst->nb[0] == sizeof(float) && dst->ne[0] == D && dst->ne[1] == hc &&
+                dst->ne[2] == n);
+    struct ggml_tensor * result = ggml_view_tensor(ctx, dst);
+    result->op     = GGML_OP_DSV41_HC_POST2;
+    result->src[0] = a;
+    result->src[1] = b;
+    result->src[2] = res;
+    result->src[3] = post;
+    result->src[4] = comb;
+    result->src[5] = dst;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_hc_fa(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * x,
+        struct ggml_tensor  * fn,
+        struct ggml_tensor  * pre,
+        struct ggml_tensor  * y,
+        struct ggml_tensor  * post,
+        struct ggml_tensor  * comb) {
+    const int64_t D = x->ne[0], hc = x->ne[1], n = x->ne[2];
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && x->nb[0] == sizeof(float) && x->ne[3] == 1 && hc == 4 && D % 128 == 0);
+    GGML_ASSERT((fn->type == GGML_TYPE_F16 || fn->type == GGML_TYPE_F32) && ggml_is_contiguous(fn));
+    GGML_ASSERT(fn->ne[0] == hc * D && fn->ne[1] == (2 + hc) * hc);
+    GGML_ASSERT(pre->type == GGML_TYPE_F32 && pre->nb[0] == sizeof(float) && pre->ne[0] == hc && pre->ne[1] == n);
+    GGML_ASSERT((y == NULL) == (post == NULL) && (y == NULL) == (comb == NULL));
+    if (y) {
+        GGML_ASSERT(y->type == GGML_TYPE_F32 && y->nb[0] == sizeof(float) && y->ne[0] == D && y->ne[1] == n);
+        GGML_ASSERT(post->type == GGML_TYPE_F32 && post->nb[0] == sizeof(float) && post->ne[0] == hc && post->ne[1] == n);
+        GGML_ASSERT(comb->type == GGML_TYPE_F32 && comb->nb[0] == sizeof(float) && comb->ne[0] == hc &&
+                    comb->ne[1] == hc && comb->ne[2] == n);
+    }
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n * (hc * D + D + 32 * (D / 128)));
+    ggml_set_op_params_i32(result, 0, (int32_t) D);
+    ggml_set_op_params_i32(result, 1, (int32_t) hc);
+    ggml_set_op_params_i32(result, 2, (int32_t) n);
+    result->op     = GGML_OP_DSV41_HC_FA;
+    result->src[0] = x;
+    result->src[1] = fn;
+    result->src[2] = pre;
+    result->src[3] = y;
+    result->src[4] = post;
+    result->src[5] = comb;
+    return result;
+}
+
+static struct ggml_tensor * ggml_dsv41_hc_fb_impl(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * fa,
+        struct ggml_tensor  * scale,
+        struct ggml_tensor  * base,
+        struct ggml_tensor  * w,
+        float                 eps,
+        float                 hc_eps,
+        int                   n_iter,
+        bool                  q8) {
+    GGML_ASSERT(fa->op == GGML_OP_DSV41_HC_FA && fa->type == GGML_TYPE_F32);
+    const int32_t D = ggml_get_op_params_i32(fa, 0), hc = ggml_get_op_params_i32(fa, 1), n = ggml_get_op_params_i32(fa, 2);
+    GGML_ASSERT(scale->type == GGML_TYPE_F32 && ggml_is_contiguous(scale) && ggml_nelements(scale) >= 3);
+    GGML_ASSERT(base->type == GGML_TYPE_F32 && ggml_is_contiguous(base) && ggml_nelements(base) == (2 + hc) * hc);
+    GGML_ASSERT(w->type == GGML_TYPE_F32 && ggml_is_contiguous(w) && ggml_nelements(w) == D);
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, (int64_t) n * (D + 2 * hc + hc * hc) +
+                                                                     (q8 ? ggml_dsv41_q8_floats(D, n) : 0));
+    ggml_set_op_params_i32(result, 0, D);
+    ggml_set_op_params_i32(result, 1, hc);
+    ggml_set_op_params_i32(result, 2, n);
+    ggml_set_op_params_f32(result, 3, eps);
+    ggml_set_op_params_f32(result, 4, hc_eps);
+    ggml_set_op_params_i32(result, 5, n_iter);
