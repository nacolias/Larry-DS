diff --git a/ggml/include/ggml-sycl.h b/ggml/include/ggml-sycl.h
--- a/ggml/include/ggml-sycl.h
+++ b/ggml/include/ggml-sycl.h
@@ -21,6 +21,37 @@
 
 GGML_BACKEND_API bool ggml_backend_is_sycl(ggml_backend_t backend);
 
+// larry: the backend's compute queue (a sycl::queue *, in order), so other SYCL code can order work against it
+GGML_BACKEND_API void * ggml_backend_sycl_get_queue(ggml_backend_t backend);
+// larry: an external launcher for the dense card's largest Q6_K mat-vecs (the LM head): called with the backend's queue,
+// the R8-reordered weight, its shape, the int8 activations (+ per-32 scales) of ncols columns and y (column stride in
+// floats); it returns true if it queued the whole product, ordered on that queue.  Weights under min_mb never reach it.
+typedef bool (*ggml_sycl_larry_mv_hook_t)(void * queue, const void * w, int64_t K, int64_t N, int ncols, const int8_t * xq,
+                                          const float * xd, float * y, int64_t y_col_stride, void * user);
+// larry: reorder a 2-D Q6_K weight into the planar layout now (it happens lazily at its first decode-shaped product
+// otherwise: ~200 dense weights and a host wait each inside the first decode token).  True if it is reordered.
+GGML_BACKEND_API bool ggml_backend_sycl_prereorder(ggml_backend_t backend, struct ggml_tensor * t);
+// larry: a 2-D Q6_K weight read only through n_slices 3-D slice views (wo_a) reordered per slice now - the planar layout
+// decode's mat-vec and the prompt's per-slice GEMM read - instead of by the first decode-shaped product
+GGML_BACKEND_API bool ggml_backend_sycl_prereorder_slices(ggml_backend_t backend, struct ggml_tensor * t, int64_t n_slices);
+GGML_BACKEND_API void ggml_backend_sycl_set_mv_hook(ggml_sycl_larry_mv_hook_t fn, void * user, double min_mb);
+// larry: an external launcher for GGML_OP_DSV41_OPROJ (DeepSeek-V4.1's attention output, <= 8 columns): the backend's
+// queue, wo_a's per-slice planar Q6_K (OG slices of OL rows x OGD, slice stride in bytes), wo_b's planar Q6_K (D rows
+// x OL * OG), o (f32, ncols columns of OGD * OG, column stride in floats) and dst (column stride in floats).  True if it
+// queued the whole product, ordered on that queue.
+typedef bool (*ggml_sycl_larry_oproj_hook_t)(void * queue, const void * wo_a, size_t wo_a_slice_bytes, const void * wo_b,
+                                             int64_t OGD, int64_t OL, int64_t OG, int64_t D, int ncols, const float * o,
+                                             int64_t o_col_stride, float * dst, int64_t dst_col_stride, void * user);
+GGML_BACKEND_API void ggml_backend_sycl_set_oproj_hook(ggml_sycl_larry_oproj_hook_t fn, void * user);
+// larry: DSV41_OPROJ outside a graph (STRATA_TP_OPROJ=2: the decode attention graph in two halves around it) - wo_a the
+// 2-D weight read as OG slices of OL rows, o / dst device pointers of n columns (OGD * OG floats apart / dst_col_stride
+// floats apart).  Ordered on the backend's queue (the launcher above if it takes it); false if the shape is not covered.
+GGML_BACKEND_API bool ggml_backend_sycl_oproj(ggml_backend_t backend, const struct ggml_tensor * wo_a, int64_t OGD, int64_t OL,
+                                              int64_t OG, const struct ggml_tensor * wo_b, const float * o, int64_t n,
+                                              float * dst, int64_t dst_col_stride);
+// larry: free the fp16 weight copies the prompt GEMMs keep (GGML_SYCL_LARRY_F16CACHE_MB) - their VRAM back for decode
+GGML_BACKEND_API void ggml_backend_sycl_larry_f16cache_release(void);
+
 // devide buffer
 GGML_BACKEND_API ggml_backend_buffer_type_t ggml_backend_sycl_buffer_type(int device);
 
