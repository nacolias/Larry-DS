+// native device memory, resident on this card only (no UR/UMF peer residency); nullptr on failure
+static sycl::half * larry_f16c_alloc(queue_ptr stream, size_t ne) {
+    ze_context_handle_t zc = sycl::get_native<sycl::backend::ext_oneapi_level_zero>(stream->get_context());
+    ze_device_handle_t zd = sycl::get_native<sycl::backend::ext_oneapi_level_zero>(stream->get_device());
+    ze_device_mem_alloc_desc_t d = {ZE_STRUCTURE_TYPE_DEVICE_MEM_ALLOC_DESC, nullptr, 0, 0};
+    void * p = nullptr;
+    const size_t bytes = ne * sizeof(sycl::half);
+    if (zeMemAllocDevice(zc, &d, bytes, 4096, zd, &p) != ZE_RESULT_SUCCESS || !p) return nullptr;
+    if (zeContextMakeMemoryResident(zc, zd, p, bytes) != ZE_RESULT_SUCCESS) { zeMemFree(zc, p); return nullptr; }
+    return (sycl::half *) p;
