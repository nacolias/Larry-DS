+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, K * n + ggml_dsv41_q8_floats(K, n));
+    ggml_set_op_params_f32(result, 0, eps);
+    ggml_set_op_params_i32(result, 1, (int32_t) K);
+    ggml_set_op_params_i32(result, 2, (int32_t) n);
+    result->op     = GGML_OP_DSV41_RMS_Q8;
+    result->src[0] = x;
+    result->src[1] = w;
+    return result;
