             struct ggml_tensor  * base,
             float                 eps);
 
+    // larry: DeepSeek-V4.1's Gate after the router matmul in one op.  logits F32 [ne, n] contiguous, bias / sel_bias
+    // F32 [ne]: sc = sqrt(softplus(logits)); the k largest of sc + bias + sel_bias (ties: lower index); weights = sc
+    // there, divided by their sum (+ 1e-20) when norm, times scale.  Result F32 [2k, n]: the k ids (as floats), then
+    // the k weights.
+    GGML_API struct ggml_tensor * ggml_dsv41_router(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * logits,
+            struct ggml_tensor  * bias,
+            struct ggml_tensor  * sel_bias,
+            int                   k,
+            bool                  norm,
+            float                 scale);
+
+    // larry: DeepSeek-V4.1's per-query attention keys in one op.  win F32 [DH, W] rows, widx I32 [swa * n] contiguous
+    // (rows of win), comp F32 / F16 / BF16 [DH, C] rows and sel I32 [K, n] (rows of comp; both null: no compressed
+    // rows).  Result F16 [DH, swa + K, 1, n]: query t's swa window rows, then its K compressed rows.
+    GGML_API struct ggml_tensor * ggml_dsv41_kgather(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * win,
+            struct ggml_tensor  * widx,
+            struct ggml_tensor  * comp,
+            struct ggml_tensor  * sel,
+            int                   swa);
+    // larry: the same with the result type F16 or F32
+    GGML_API struct ggml_tensor * ggml_dsv41_kgather2(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * win,
+            struct ggml_tensor  * widx,
+            struct ggml_tensor  * comp,
+            struct ggml_tensor  * sel,
+            int                   swa,
+            enum ggml_type        type);
+
+    // larry: an RMS-normed mat-vec in one op: out[r, t] = (w[:, r] . x[:, t]) * rsqrt(mean(x[:, t]^2) + eps).  w F16 /
+    // F32 [C, R] contiguous, x F32 [C, n] contiguous rows; result F32 [R, n] (f32 accumulation)
+    GGML_API struct ggml_tensor * ggml_dsv41_norm_mv(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * w,
+            struct ggml_tensor  * x,
+            float                 eps);
+
+    // larry: DeepSeek-V4.1's clamped SwiGLU on a fused gate|up result: y F32 [2N, n] (rows: gate, then up);
+    // out[i, t] = silu(min(gate, lim)) * clamp(up, -lim, lim) (lim <= 0: no clamps); result F32 [N, n]
+    GGML_API struct ggml_tensor * ggml_dsv41_swiglu_lim(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * y,
+            float                 lim);
+
+    // larry: DeepSeek-V4.1's hyper-connection steps fused for decode widths (ggml-sycl kernels, CPU references).
+    // hc_post2: dst = hc_post(a + b, res, post, comb) written straight into dst (the result is a view of dst, as with
+    // ggml_cpy).  a, b F32 [D, n] (b may be NULL), res F32 [D, hc, n], post F32 [hc, n], comb F32 [hc(dst), hc(src), n],
+    // dst F32 [D, hc, n]; every row contiguous.
+    GGML_API struct ggml_tensor * ggml_dsv41_hc_post2(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * a,
+            struct ggml_tensor  * b,
+            struct ggml_tensor  * res,
+            struct ggml_tensor  * post,
+            struct ggml_tensor  * comb,
+            struct ggml_tensor  * dst);
+    // hc_fa: the first half of one sub-layer's hc step.  x F32 [D, hc, n] (the hc state / residual), fn F16 / F32
+    // [hc*D, (2+hc)*hc] (the mixes weight), pre F32 [hc, n] (the pre-mix of the sub-layer input); y F32 [D, n] (the
+    // previous sub-layer's output), post F32 [hc, n], comb F32 [hc, hc, n]: all three or none.
+    //   h = y ? hc_post(y, x, post, comb) : x      z = hc_pre(h, pre)
+    // and per 128-column chunk the partial dots fn . h and the partial sums of h^2 and z^2.  hc == 4, D % 128 == 0.
+    // Result F32 1-D, region-major: h [D, hc, n] (written when y is set) | z [D, n] | partials [32, D/128, n]
+    GGML_API struct ggml_tensor * ggml_dsv41_hc_fa(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * fn,
+            struct ggml_tensor  * pre,
+            struct ggml_tensor  * y,
+            struct ggml_tensor  * post,
+            struct ggml_tensor  * comb);
+    // hc_fb: the second half.  fa = a ggml_dsv41_hc_fa result, scale F32 [3], base F32 [(2+hc)*hc], w F32 [D] (the
+    // sub-layer's RMS-norm weight).  mixes = (fn . h) * rsqrt(mean(h^2) + eps) (ggml_dsv41_norm_mv);
+    // pre = sigmoid(mixes*scale[0] + base) + hc_eps, post = 2 sigmoid(mixes*scale[1] + base) (ggml_dsv41_hc_mixes);
+    // comb = ggml_dsv4_hc_comb's Sinkhorn (n_iter);  xn = z * rsqrt(mean(z^2) + eps) * w.
+    // Result F32 1-D, region-major: xn [D, n] | pre [hc, n] | post [hc, n] | comb [hc, hc, n]
+    GGML_API struct ggml_tensor * ggml_dsv41_hc_fb(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * fa,
+            struct ggml_tensor  * scale,
+            struct ggml_tensor  * base,
+            struct ggml_tensor  * w,
+            float                 eps,
+            float                 hc_eps,
+            int                   n_iter);
