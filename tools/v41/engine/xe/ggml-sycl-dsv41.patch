+struct ggml_tensor * ggml_dsv41_router(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * logits,
+        struct ggml_tensor  * bias,
+        struct ggml_tensor  * sel_bias,
+        int                   k,
+        bool                  norm,
+        float                 scale) {
+    GGML_ASSERT(logits->type == GGML_TYPE_F32 && ggml_is_contiguous(logits));
+    GGML_ASSERT(bias->type == GGML_TYPE_F32 && ggml_nelements(bias) == logits->ne[0] && ggml_is_contiguous(bias));
+    GGML_ASSERT(sel_bias->type == GGML_TYPE_F32 && ggml_nelements(sel_bias) == logits->ne[0] && ggml_is_contiguous(sel_bias));
+    GGML_ASSERT(k >= 1 && k <= 8 && k <= logits->ne[0] && logits->ne[0] <= 1024);   // ggml-sycl: k <= 8, ne <= 1024
+    const int64_t nt = logits->ne[1] * logits->ne[2] * logits->ne[3];
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 2 * k, nt);
+    ggml_set_op_params_i32(result, 0, k);
+    ggml_set_op_params_i32(result, 1, norm ? 1 : 0);
+    ggml_set_op_params_f32(result, 2, scale);
+    result->op     = GGML_OP_DSV41_ROUTER;
+    result->src[0] = logits;
+    result->src[1] = bias;
+    result->src[2] = sel_bias;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_kgather(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * win,
+        struct ggml_tensor  * widx,
+        struct ggml_tensor  * comp,
+        struct ggml_tensor  * sel,
+        int                   swa) {
+    GGML_ASSERT(win->type == GGML_TYPE_F32 && win->nb[0] == 4 && win->ne[2] == 1 && win->ne[3] == 1);
+    GGML_ASSERT(widx->type == GGML_TYPE_I32 && ggml_is_contiguous(widx) && swa > 0 && ggml_nelements(widx) % swa == 0);
+    GGML_ASSERT((comp == NULL) == (sel == NULL));
+    const int64_t DH = win->ne[0], n = ggml_nelements(widx) / swa;
+    int64_t K = 0;
+    if (comp) {
+        GGML_ASSERT(comp->type == GGML_TYPE_F32 || comp->type == GGML_TYPE_F16 || comp->type == GGML_TYPE_BF16);
+        GGML_ASSERT(comp->ne[0] == DH && comp->nb[0] == ggml_type_size(comp->type));
+        GGML_ASSERT(sel->type == GGML_TYPE_I32 && sel->nb[0] == 4 && sel->ne[1] == n && sel->ne[2] == 1 && sel->ne[3] == 1);
+        K = sel->ne[0];
+    }
+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, DH, swa + K, 1, n);
+    ggml_set_op_params_i32(result, 0, swa);
+    result->op     = GGML_OP_DSV41_KGATHER;
+    result->src[0] = win;
+    result->src[1] = widx;
+    result->src[2] = comp;
+    result->src[3] = sel;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_kgather2(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * win,
+        struct ggml_tensor  * widx,
+        struct ggml_tensor  * comp,
+        struct ggml_tensor  * sel,
+        int                   swa,
+        enum ggml_type        type) {
+    GGML_ASSERT(type == GGML_TYPE_F16 || type == GGML_TYPE_F32);
+    struct ggml_tensor * r = ggml_dsv41_kgather(ctx, win, widx, comp, sel, swa);
+    if (type == GGML_TYPE_F32) {
+        struct ggml_tensor * result = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, r->ne[0], r->ne[1], r->ne[2], r->ne[3]);
+        ggml_set_op_params_i32(result, 0, swa);
+        result->op = GGML_OP_DSV41_KGATHER;
+        for (int i = 0; i < 4; ++i) result->src[i] = r->src[i];
+        return result;
+    }
+    return r;
+}
+
+struct ggml_tensor * ggml_dsv41_norm_mv(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * w,
+        struct ggml_tensor  * x,
+        float                 eps) {
+    GGML_ASSERT((w->type == GGML_TYPE_F16 || w->type == GGML_TYPE_F32) && ggml_is_contiguous(w));
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && ggml_is_contiguous(x) && x->ne[0] == w->ne[0]);
+    const int64_t n = x->ne[1] * x->ne[2] * x->ne[3];
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, w->ne[1], n);
+    ggml_set_op_params_f32(result, 0, eps);
+    result->op     = GGML_OP_DSV41_NORM_MV;
+    result->src[0] = w;
+    result->src[1] = x;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_swiglu_lim(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * y,
+        float                 lim) {
+    GGML_ASSERT(y->type == GGML_TYPE_F32 && ggml_is_contiguous(y) && y->ne[0] % 2 == 0);
+    const int64_t n = y->ne[1] * y->ne[2] * y->ne[3];
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, y->ne[0] / 2, n);
+    ggml_set_op_params_f32(result, 0, lim);
+    result->op     = GGML_OP_DSV41_SWIGLU_LIM;
+    result->src[0] = y;
+    return result;
+}
