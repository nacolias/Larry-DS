+static struct ggml_tensor * ggml_dsv41_attn_dec_impl(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * ring,
+        struct ggml_tensor  * rows,
+        struct ggml_tensor  * widx,
+        struct ggml_tensor  * wmask,
+        struct ggml_tensor  * comp,
+        struct ggml_tensor  * sel,
+        struct ggml_tensor  * selm,
+        struct ggml_tensor  * sinks,
+        struct ggml_tensor  * tab,
+        int                   swa,
+        float                 scale,
+        int                   n_dims,
+        int                   hpg) {
+    const int64_t D = q->ne[0], NH = q->ne[1], n = q->ne[2];
+    GGML_ASSERT(q->type == GGML_TYPE_F32 && ggml_is_contiguous(q) && q->ne[3] == 1 && D == 512 && NH % 32 == 0);
+    GGML_ASSERT(ring->type == GGML_TYPE_F32 && ring->nb[0] == sizeof(float) && ring->ne[0] == D);
+    GGML_ASSERT(rows->type == GGML_TYPE_F32 && rows->nb[0] == sizeof(float) && rows->ne[0] == D && rows->ne[1] == n);
+    GGML_ASSERT(widx->type == GGML_TYPE_I32 && ggml_is_contiguous(widx) && swa > 0 && ggml_nelements(widx) == swa * n);
+    GGML_ASSERT(wmask->type == GGML_TYPE_F32 && wmask->nb[0] == sizeof(float) && wmask->ne[0] == swa && wmask->ne[1] == n);
+    GGML_ASSERT((comp == NULL) == (sel == NULL) && (comp == NULL) == (selm == NULL));
+    int64_t K = 0;
+    if (comp) {
+        GGML_ASSERT(comp->type == GGML_TYPE_F32 || comp->type == GGML_TYPE_F16 || comp->type == GGML_TYPE_BF16);
+        GGML_ASSERT(comp->ne[0] == D && comp->nb[0] == ggml_type_size(comp->type));
+        GGML_ASSERT(sel->type == GGML_TYPE_I32 && sel->nb[0] == 4 && sel->ne[1] == n && sel->ne[2] == 1 && sel->ne[3] == 1);
+        GGML_ASSERT(selm->type == GGML_TYPE_F32 && selm->nb[0] == 4 && selm->ne[0] == sel->ne[0] && selm->ne[1] == n);
+        K = sel->ne[0];
+    }
+    GGML_ASSERT(swa + K <= 2048);
+    GGML_ASSERT(!sinks || (sinks->type == GGML_TYPE_F32 && ggml_is_contiguous(sinks) && ggml_nelements(sinks) == NH));
+    GGML_ASSERT(n_dims > 0 && n_dims % 4 == 0 && n_dims <= 128);   // ggml-sycl: the rotated dims sit in the last 128
+    GGML_ASSERT(tab->type == GGML_TYPE_F32 && ggml_is_contiguous(tab) && ggml_nelements(tab) == n_dims * n);
+    GGML_ASSERT(hpg == 0 || NH % hpg == 0);
+    struct ggml_tensor * result = hpg ? ggml_new_tensor_1d(ctx, GGML_TYPE_F32, D * NH * n + ggml_dsv41_q8_floats(D * hpg, n * (NH / hpg)))
+                                      : ggml_new_tensor_3d(ctx, GGML_TYPE_F32, D, NH, n);
+    ggml_set_op_params_i32(result, 0, swa);
+    ggml_set_op_params_f32(result, 1, scale);
+    ggml_set_op_params_i32(result, 2, n_dims);
+    ggml_set_op_params_i32(result, 10, hpg);
+    ggml_set_op_params_i32(result, 11, (int32_t) NH);
+    ggml_set_op_params_i32(result, 12, (int32_t) n);
+    result->op     = GGML_OP_DSV41_ATTN_DEC;
+    result->src[0] = q;
+    result->src[1] = ring;
+    result->src[2] = rows;
+    result->src[3] = widx;
+    result->src[4] = wmask;
+    result->src[5] = comp;
+    result->src[6] = sel;
+    result->src[7] = selm;
+    result->src[8] = sinks;
+    result->src[9] = tab;
+    return result;
+}
