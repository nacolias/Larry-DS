+static void li_gemm(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    namespace mkl = oneapi::mkl;
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const ggml_tensor * w = dst->src[2];
+    const ggml_tensor * m = dst->src[3];
+    const int64_t E = q->ne[0], H = q->ne[1], B = q->ne[2], NKV = k->ne[2];
+    const size_t nbq1 = q->nb[1], nbq2 = q->nb[2], nbk2 = k->nb[2], nbw1 = w->nb[1], nbm1 = m->nb[1], nb1 = dst->nb[1];
+    const ggml_type kt = k->type;
+    queue_ptr stream = ctx.stream();
+    ggml_sycl_pool & pool = ctx.pool();
+    ggml_sycl_pool_alloc<sycl::half> Qh(pool, (size_t) B * H * E);
+    ggml_sycl_pool_alloc<sycl::half> Kh(pool, (size_t) NKV * E);
+    sycl::half * qh = Qh.get();
+    sycl::half * kh = Kh.get();
+    const char * qd = (const char *) q->data;
+    const char * kd = (const char *) k->data;
+    stream->parallel_for(sycl::range<1>((size_t) B * H * E), [=](sycl::id<1> id) {
+        const size_t i = id[0];
+        const int64_t e = (int64_t) (i % E), h = (int64_t) ((i / E) % H), b = (int64_t) (i / (E * H));
+        qh[i] = (sycl::half) *(const float *) (qd + b * nbq2 + h * nbq1 + e * sizeof(float));
+    });
+    stream->parallel_for(sycl::range<1>((size_t) NKV * E), [=](sycl::id<1> id) {
