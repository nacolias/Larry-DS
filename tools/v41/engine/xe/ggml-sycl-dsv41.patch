+    const float * x8d = o8 ? (const float *) ((const char *) o8->data + (size_t) (wa->ne[2] * dst->ne[1] * wa->ne[0])) : nullptr;
+    return larry_oproj_core(ctx, wa->view_src ? wa->view_src : wa, wa->nb[2], wa->ne[0], wa->ne[1], wa->ne[2], dst->src[2],
+                            (const float *) dst->src[0]->data, dst->ne[1], (float *) dst->data, (int64_t) (dst->nb[1] / 4), x8q, x8d);
