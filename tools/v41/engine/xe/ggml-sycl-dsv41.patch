+    ggml_set_op_params_f32(result, 0, eps);
+    result->op     = GGML_OP_DSV41_NORM_MV;
+    result->src[0] = w;
+    result->src[1] = x;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_swiglu_lim(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * y,
+        float                 lim) {
+    GGML_ASSERT(y->type == GGML_TYPE_F32 && ggml_is_contiguous(y) && y->ne[0] % 2 == 0);
+    const int64_t n = y->ne[1] * y->ne[2] * y->ne[3];
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, y->ne[0] / 2, n);
+    ggml_set_op_params_f32(result, 0, lim);
+    result->op     = GGML_OP_DSV41_SWIGLU_LIM;
+    result->src[0] = y;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_swiglu_q8(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * y,
+        float                 lim) {
+    GGML_ASSERT(y->type == GGML_TYPE_F32 && ggml_is_contiguous(y) && y->ne[0] % 64 == 0);
+    const int64_t N = y->ne[0] / 2, n = y->ne[1] * y->ne[2] * y->ne[3];
+    struct ggml_tensor * result = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, N * n + ggml_dsv41_q8_floats(N, n));
+    ggml_set_op_params_f32(result, 0, lim);
+    ggml_set_op_params_i32(result, 1, 1);
+    ggml_set_op_params_i32(result, 2, (int32_t) N);
+    ggml_set_op_params_i32(result, 3, (int32_t) n);
+    result->op     = GGML_OP_DSV41_SWIGLU_LIM;
+    result->src[0] = y;
+    return result;
+}
