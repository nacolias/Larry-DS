+// GGML_OP_DSV41_NORM_MV (larry): a work-group per (token, output row): its lanes walk the row 8 values at a time,
+// summing w . x and x . x together; out = dot * rsqrt(mean(x^2) + eps) (the norm folded out of the product)
+void ggml_sycl_op_dsv41_norm_mv(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/2);
+    const ggml_tensor * w = dst->src[0];
+    const ggml_tensor * x = dst->src[1];
+    const int64_t C = w->ne[0], R = w->ne[1], n = dst->ne[1];
+    GGML_ASSERT(C % 8 == 0 && x->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const bool w16 = w->type == GGML_TYPE_F16;
+    const void * pw = w->data;
+    const float * px = (const float *) x->data;
+    float * pd = (float *) dst->data;
+    constexpr int WG = 256;
+    ctx.stream()->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> sd(sycl::range<1>(WG / 16), h), ss(sycl::range<1>(WG / 16), h);
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) (n * R) * WG), sycl::range<1>(WG)),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+            const int64_t g = (int64_t) it.get_group(0), r = g % R, t = g / R;
+            const int lid = (int) it.get_local_id(0);
+            const float * xt = px + t * C;
+            float dot = 0.0f, sq = 0.0f;
+            for (int64_t c = (int64_t) lid * 8; c < C; c += (int64_t) WG * 8) {
+                const sycl::float4 xa = *(const sycl::float4 *) (xt + c), xb = *(const sycl::float4 *) (xt + c + 4);
+                float wv[8];
+                if (w16) {
+                    const sycl::vec<sycl::half, 8> hv = *(const sycl::vec<sycl::half, 8> *) ((const sycl::half *) pw + r * C + c);
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) wv[j] = (float) hv[j];
+                } else {
+                    const float * wr = (const float *) pw + r * C + c;
+                    const sycl::float4 wa = *(const sycl::float4 *) wr, wb = *(const sycl::float4 *) (wr + 4);
+                    wv[0] = wa.x(); wv[1] = wa.y(); wv[2] = wa.z(); wv[3] = wa.w(); wv[4] = wb.x(); wv[5] = wb.y(); wv[6] = wb.z(); wv[7] = wb.w();
+                }
+                const float xv[8] = { xa.x(), xa.y(), xa.z(), xa.w(), xb.x(), xb.y(), xb.z(), xb.w() };
+#pragma unroll
+                for (int j = 0; j < 8; ++j) { dot += wv[j] * xv[j]; sq += xv[j] * xv[j]; }
+            }
+            const sycl::sub_group sg = it.get_sub_group();
+            dot = sycl::reduce_over_group(sg, dot, sycl::plus<float>());
+            sq = sycl::reduce_over_group(sg, sq, sycl::plus<float>());
+            const int sgi = (int) sg.get_group_linear_id();
+            if (sg.get_local_linear_id() == 0) { sd[sgi] = dot; ss[sgi] = sq; }
+            it.barrier(sycl::access::fence_space::local_space);
+            if (lid == 0) {
+                float D = 0.0f, Q = 0.0f;
+                for (int k = 0; k < WG / 16; ++k) { D += sd[k]; Q += ss[k]; }
+                pd[t * R + r] = D * sycl::rsqrt(Q / (float) C + eps);
+            }
+        });
+    });
+}
