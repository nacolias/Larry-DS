+// ggml_compute_forward_dsv41_norm_mv (larry): the reference of ggml-sycl's RMS-normed mat-vec
+void ggml_compute_forward_dsv41_norm_mv(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * w = dst->src[0];
+    const ggml_tensor * x = dst->src[1];
+    const int64_t C = w->ne[0], R = w->ne[1], n = dst->ne[1];
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    for (int64_t j = params->ith; j < R * n; j += params->nth) {
+        const int64_t r = j % R, t = j / R;
+        const float * xt = (const float *) x->data + t * C;
+        double dot = 0, sq = 0;
+        for (int64_t c = 0; c < C; ++c) {
+            const float wv = w->type == GGML_TYPE_F16 ? GGML_CPU_FP16_TO_FP32(((const ggml_fp16_t *) w->data)[r * C + c])
+                                                      : ((const float *) w->data)[r * C + c];
+            dot += (double) wv * xt[c];
+            sq += (double) xt[c] * xt[c];
+        }
+        ((float *) dst->data)[t * R + r] = (float) dot * (1.0f / std::sqrt((float) (sq / C) + eps));
+    }
+}
+
+// ggml_compute_forward_dsv41_hc_post2 / _hc_fa / _hc_fb (larry): references of ggml-sycl's fused hyper-connection
+// steps (one thread; the engine runs them on SYCL).  Same arithmetic order as the stock-op composites where it is
+// cheap to keep (hc_post, hc_pre); the dots and sums in double.
+void ggml_compute_forward_dsv41_hc_post2(const ggml_compute_params * params, ggml_tensor * dst) {
+    if (params->ith != 0) return;
+    const ggml_tensor * a = dst->src[0], * b = dst->src[1], * res = dst->src[2], * post = dst->src[3], * comb = dst->src[4];
+    const int64_t D = a->ne[0], n = a->ne[1], hc = res->ne[1];
+    auto at = [](const ggml_tensor * t, int64_t i0, int64_t i1, int64_t i2) {
+        return *(const float *) ((const char *) t->data + i0 * t->nb[0] + i1 * t->nb[1] + i2 * t->nb[2]);
+    };
+    for (int64_t t = 0; t < n; ++t)
+        for (int64_t d = 0; d < hc; ++d) {
+            float * o = (float *) ((char *) dst->data + d * dst->nb[1] + t * dst->nb[2]);
+            for (int64_t i = 0; i < D; ++i) {
+                const float x = b ? at(a, i, t, 0) + at(b, i, t, 0) : at(a, i, t, 0);
+                float s = x * at(post, d, t, 0);
+                for (int64_t r = 0; r < hc; ++r) s += at(res, i, r, t) * at(comb, d, r, t);
+                o[i] = s;
+            }
+        }
+}
+
+void ggml_compute_forward_dsv41_hc_fa(const ggml_compute_params * params, ggml_tensor * dst) {
+    if (params->ith != 0) return;
+    const ggml_tensor * x = dst->src[0], * fn = dst->src[1], * pre = dst->src[2];
+    const ggml_tensor * y = dst->src[3], * post = dst->src[4], * comb = dst->src[5];
+    const int64_t D = ggml_get_op_params_i32(dst, 0), hc = ggml_get_op_params_i32(dst, 1), n = ggml_get_op_params_i32(dst, 2);
+    const int64_t nch = D / 128, NR = (2 + hc) * hc, C = hc * D;
+    auto at = [](const ggml_tensor * t, int64_t i0, int64_t i1, int64_t i2) {
+        return *(const float *) ((const char *) t->data + i0 * t->nb[0] + i1 * t->nb[1] + i2 * t->nb[2]);
+    };
+    float * oh = (float *) dst->data;
+    float * oz = oh + n * C;
+    float * op = oz + n * D;
+    std::vector<float> h((size_t) C), z((size_t) D);
+    for (int64_t t = 0; t < n; ++t) {
+        for (int64_t d = 0; d < hc; ++d)
+            for (int64_t i = 0; i < D; ++i) {
+                float v = at(x, i, d, t);
+                if (y) {
+                    v = at(y, i, t, 0) * at(post, d, t, 0);
+                    for (int64_t r = 0; r < hc; ++r) v += at(x, i, r, t) * at(comb, d, r, t);
+                }
+                h[(size_t) (d * D + i)] = v;
+            }
+        if (y) memcpy(oh + t * C, h.data(), (size_t) C * sizeof(float));
+        for (int64_t i = 0; i < D; ++i) {
+            float v = h[(size_t) i] * at(pre, 0, t, 0);
+            for (int64_t d = 1; d < hc; ++d) v += h[(size_t) (d * D + i)] * at(pre, d, t, 0);
+            z[(size_t) i] = v;
+        }
+        memcpy(oz + t * D, z.data(), (size_t) D * sizeof(float));
+        for (int64_t ch = 0; ch < nch; ++ch) {
+            float * P = op + (t * nch + ch) * 32;
+            std::fill(P, P + 32, 0.0f);
+            for (int64_t r = 0; r < NR; ++r) {
+                double s = 0;
+                for (int64_t d = 0; d < hc; ++d)
+                    for (int64_t i = ch * 128; i < ch * 128 + 128; ++i) {
+                        const int64_t c = d * D + i;
+                        const float wv = fn->type == GGML_TYPE_F16 ? GGML_CPU_FP16_TO_FP32(((const ggml_fp16_t *) fn->data)[r * C + c])
+                                                                   : ((const float *) fn->data)[r * C + c];
+                        s += (double) wv * h[(size_t) c];
+                    }
+                P[r] = (float) s;
+            }
+            double sh = 0, sz = 0;
+            for (int64_t i = ch * 128; i < ch * 128 + 128; ++i) {
+                for (int64_t d = 0; d < hc; ++d) sh += (double) h[(size_t) (d * D + i)] * h[(size_t) (d * D + i)];
+                sz += (double) z[(size_t) i] * z[(size_t) i];
+            }
+            P[NR] = (float) sh;
+            P[NR + 1] = (float) sz;
+        }
+    }
+}
+
+void ggml_compute_forward_dsv41_hc_fb(const ggml_compute_params * params, ggml_tensor * dst) {
+    if (params->ith != 0) return;
+    const ggml_tensor * fa = dst->src[0];
+    const float * sc = (const float *) dst->src[1]->data;
+    const float * bs = (const float *) dst->src[2]->data;
+    const float * w = (const float *) dst->src[3]->data;
+    const int64_t D = ggml_get_op_params_i32(dst, 0), hc = ggml_get_op_params_i32(dst, 1), n = ggml_get_op_params_i32(dst, 2);
+    const float eps = ggml_get_op_params_f32(dst, 3), hc_eps = ggml_get_op_params_f32(dst, 4);
+    const int n_iter = ggml_get_op_params_i32(dst, 5);
+    const int64_t nch = D / 128, NR = (2 + hc) * hc;
+    const float * fz = (const float *) fa->data + n * hc * D;
+    const float * fp = fz + n * D;
+    float * oxn = (float *) dst->data;
+    float * opre = oxn + n * D;
+    float * opost = opre + n * hc;
+    float * ocomb = opost + n * hc;
+    std::vector<double> tot((size_t) (NR + 2));
+    std::vector<float> cm((size_t) (hc * hc));
+    for (int64_t t = 0; t < n; ++t) {
+        std::fill(tot.begin(), tot.end(), 0.0);
+        for (int64_t ch = 0; ch < nch; ++ch)
+            for (int64_t v = 0; v < NR + 2; ++v) tot[(size_t) v] += fp[(t * nch + ch) * 32 + v];
+        const float rh = 1.0f / std::sqrt((float) (tot[(size_t) NR] / (double) (hc * D)) + eps);
+        const float rz = 1.0f / std::sqrt((float) (tot[(size_t) NR + 1] / (double) D) + eps);
+        for (int64_t i = 0; i < D; ++i) oxn[t * D + i] = fz[t * D + i] * rz * w[i];
+        for (int64_t h = 0; h < hc; ++h) {
+            const float vp = (float) tot[(size_t) h] * rh * sc[0] + bs[h];
+            const float vq = (float) tot[(size_t) (hc + h)] * rh * sc[1] + bs[hc + h];
+            opre[t * hc + h] = 1.0f / (1.0f + std::exp(-vp)) + hc_eps;
+            opost[t * hc + h] = 2.0f / (1.0f + std::exp(-vq));
+        }
+        // ggml_dsv4_hc_comb: per src a softmax over dst (+ eps), then the column / row normalisations
+        for (int64_t s = 0; s < hc; ++s) {
+            float mx = -INFINITY;
+            for (int64_t d = 0; d < hc; ++d) {
+                const int64_t e = d + hc * s;
+                cm[(size_t) e] = (float) tot[(size_t) (2 * hc + e)] * rh * sc[2] + bs[2 * hc + e];
+                mx = std::max(mx, cm[(size_t) e]);
+            }
+            float sum = 0.0f;
+            for (int64_t d = 0; d < hc; ++d) { cm[(size_t) (d + hc * s)] = std::exp(cm[(size_t) (d + hc * s)] - mx); sum += cm[(size_t) (d + hc * s)]; }
+            for (int64_t d = 0; d < hc; ++d) cm[(size_t) (d + hc * s)] = cm[(size_t) (d + hc * s)] * (1.0f / sum) + hc_eps;
+        }
+        auto cols = [&]() {
+            for (int64_t d = 0; d < hc; ++d) {
+                float sum = hc_eps;
+                for (int64_t s = 0; s < hc; ++s) sum += cm[(size_t) (d + hc * s)];
+                for (int64_t s = 0; s < hc; ++s) cm[(size_t) (d + hc * s)] *= 1.0f / sum;
+            }
+        };
+        auto rows = [&]() {
+            for (int64_t s = 0; s < hc; ++s) {
+                float sum = hc_eps;
+                for (int64_t d = 0; d < hc; ++d) sum += cm[(size_t) (d + hc * s)];
+                for (int64_t d = 0; d < hc; ++d) cm[(size_t) (d + hc * s)] *= 1.0f / sum;
+            }
+        };
+        cols();
+        for (int k = 1; k < n_iter; ++k) { rows(); cols(); }
+        std::copy(cm.begin(), cm.end(), ocomb + t * hc * hc);
+    }
+}
+
+// ggml_compute_forward_dsv41_swiglu_lim (larry): the reference of ggml-sycl's clamped SwiGLU on gate|up rows
+void ggml_compute_forward_dsv41_swiglu_lim(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * y = dst->src[0];
+    const int64_t N = dst->ne[0], n = dst->ne[1];
+    const float lim = ggml_get_op_params_f32(dst, 0);
+    for (int64_t j = params->ith; j < N * n; j += params->nth) {
+        const int64_t i = j % N, t = j / N;
+        const float * yt = (const float *) y->data + t * 2 * N;
+        float g = yt[i], u = yt[N + i];
+        if (lim > 0) { g = g > lim ? lim : g; u = u > lim ? lim : (u < -lim ? -lim : u); }
+        ((float *) dst->data)[t * N + i] = g / (1.0f + std::exp(-g)) * u;
+    }
+}
