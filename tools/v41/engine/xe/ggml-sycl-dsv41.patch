+void ggml_sycl_op_dsv41_rms_q8(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/2);
+    const ggml_tensor * x = dst->src[0], * w = dst->src[1];
+    dsv41dec::RmsQ8Args a;
+    a.K = ggml_get_op_params_i32(dst, 1);
+    a.n = ggml_get_op_params_i32(dst, 2);
+    a.eps = ggml_get_op_params_f32(dst, 0);
+    a.x = (const float *) x->data;
+    a.x_cs = (int64_t) (x->nb[1] / 4);
+    a.w = (const float *) w->data;
+    a.y = (float *) dst->data;
+    a.q = (int8_t *) (a.y + (size_t) a.K * a.n);
+    a.d = (float *) (a.q + (size_t) a.K * a.n);
+    dsv41dec::rms_q8(*ctx.stream(), a);
+}
