+    GGML_ASSERT(q->type == GGML_TYPE_F32 && q->ne[0] == 128 && q->ne[1] == 32 && q->ne[3] == 1 && q->nb[0] == 4 && n >= 1 && n < 8);
+    GGML_ASSERT(keys->type == GGML_TYPE_BF16 && keys->ne[0] == 128 && keys->ne[2] == 1 && keys->nb[0] == 2 && NKV % 8 == 0);
+    GGML_ASSERT(w->type == GGML_TYPE_F32 && w->ne[0] == 32 && w->ne[1] == n && w->nb[0] == 4);
+    GGML_ASSERT(nvis->type == GGML_TYPE_F32 && ggml_is_contiguous(nvis) && ggml_nelements(nvis) == n);
+    GGML_ASSERT(tab->type == GGML_TYPE_F32 && ggml_is_contiguous(tab) && ggml_nelements(tab) == n_dims * n);
+    GGML_ASSERT(!cand || (cand->type == GGML_TYPE_I32 && cand->nb[0] == 4 && cand->ne[1] == n));
+    GGML_ASSERT(!lastblk || (lastblk->type == GGML_TYPE_F32 && ggml_is_contiguous(lastblk) && ggml_nelements(lastblk) == n));
+    GGML_ASSERT(n_dims > 0 && n_dims % 4 == 0 && n_dims <= 128);
+    struct ggml_tensor * result = lastblk ? ggml_new_tensor_1d(ctx, GGML_TYPE_F32, NKV * n + (NKV / 8) * n)
+                                          : ggml_new_tensor_2d(ctx, GGML_TYPE_F32, NKV, n);
+    ggml_set_op_params_i32(result, 0, n_dims);
+    ggml_set_op_params_i32(result, 8, fq ? 1 : 0);
+    ggml_set_op_params_f32(result, 9, wscale);
+    ggml_set_op_params_i32(result, 10, (int32_t) n);
+    result->op     = GGML_OP_DSV41_LI_DEC;
+    result->src[0] = q;
+    result->src[1] = keys;
+    result->src[2] = w;
+    result->src[3] = nvis;
+    result->src[4] = tab;
+    result->src[5] = cand;
+    result->src[6] = lastblk;
+    return result;
+}
+
+struct ggml_tensor * ggml_dsv41_sel_fin(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * ids,
+        struct ggml_tensor  * nvis,
+        struct ggml_tensor  * sel,
+        struct ggml_tensor  * selm) {
+    const int64_t K = ids->ne[0], n = ids->ne[1];
+    GGML_ASSERT(ids->type == GGML_TYPE_I32 && ids->nb[0] == 4 && ids->ne[2] == 1 && ids->ne[3] == 1 && K <= 512);
+    GGML_ASSERT(nvis->type == GGML_TYPE_F32 && ggml_is_contiguous(nvis) && ggml_nelements(nvis) == n);
+    GGML_ASSERT(sel->type == GGML_TYPE_I32 && sel->nb[0] == 4 && sel->ne[0] == K && sel->ne[1] == n);
+    GGML_ASSERT(selm->type == GGML_TYPE_F32 && selm->nb[0] == 4 && selm->ne[0] == K && selm->ne[1] == n);
+    struct ggml_tensor * result = ggml_view_tensor(ctx, sel);
+    result->op     = GGML_OP_DSV41_SEL_FIN;
+    result->src[0] = ids;
+    result->src[1] = nvis;
+    result->src[2] = sel;
+    result->src[3] = selm;
+    return result;
+}
