+void ggml_sycl_op_dsv41_attn_dec(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/10);
+    const ggml_tensor * q = dst->src[0], * ring = dst->src[1], * rows = dst->src[2], * widx = dst->src[3], * wmask = dst->src[4];
+    const ggml_tensor * comp = dst->src[5], * sel = dst->src[6], * selm = dst->src[7], * sinks = dst->src[8], * tab = dst->src[9];
+    dsv41dec::AttnArgs a;
+    a.q = (const float *) q->data;
+    a.q_h = q->nb[1] / 4;
+    a.q_b = q->nb[2] / 4;
+    a.tab = (const float *) tab->data;
+    a.n_dims = ggml_get_op_params_i32(dst, 2);
+    a.ring = (const float *) ring->data;
+    a.ring_cs = (int64_t) (ring->nb[1] / 4);
+    a.RAW = (int) ring->ne[1];
+    a.rows = (const float *) rows->data;
+    a.rows_cs = (int64_t) (rows->nb[1] / 4);
+    a.swa = ggml_get_op_params_i32(dst, 0);
+    a.widx = (const int32_t *) widx->data;
+    a.wi_b = a.swa;
+    a.wmask = (const float *) wmask->data;
+    a.wm_b = (int64_t) (wmask->nb[1] / 4);
+    if (comp) {
+        a.comp = comp->data;
+        a.comp_t = comp->type == GGML_TYPE_BF16 ? 1 : comp->type == GGML_TYPE_F16 ? 2 : 0;
+        a.comp_rb = comp->nb[1];
+        a.sel = (const int32_t *) sel->data;
+        a.sel_b = (int64_t) (sel->nb[1] / 4);
+        a.selm = (const float *) selm->data;
+        a.sm_b = (int64_t) (selm->nb[1] / 4);
+        a.K = (int) sel->ne[0];
+    }
+    a.sinks = sinks ? (const float *) sinks->data : nullptr;
+    a.NH = (int) q->ne[1];
+    a.n = (int) q->ne[2];
+    a.o = (float *) dst->data;
+    a.hpg = ggml_get_op_params_i32(dst, 10);
+    if (a.hpg) {   // ggml_dsv41_attn_dec_q8: o [512, NH, n] | q8 of the head groups
+        a.o_h = 512;
+        a.o_b = (size_t) a.NH * 512;
+        a.oq = (int8_t *) (a.o + (size_t) 512 * a.NH * a.n);
+        a.od = (float *) (a.oq + (size_t) 512 * a.NH * a.n);
+    } else {
+        a.o_h = dst->nb[1] / 4;
+        a.o_b = dst->nb[2] / 4;
+    }
+    a.scale = ggml_get_op_params_f32(dst, 1);
+    GGML_ASSERT(dsv41dec::covered(a.NH, a.swa + a.K) && a.n < 8);
+    ggml_sycl_pool_alloc<float> part(ctx.pool(), dsv41dec::scratch_floats(a.NH, a.swa + a.K, a.n));
+    a.part = part.get();
+    dsv41dec::attn_dec(*ctx.stream(), a);
+}
