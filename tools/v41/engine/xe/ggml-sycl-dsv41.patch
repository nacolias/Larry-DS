+struct ggml_tensor * ggml_dsv41_write_to(
+        struct ggml_tensor  * op,
+        struct ggml_tensor  * d0,
+        struct ggml_tensor  * d1,
+        struct ggml_tensor  * d2,
+        struct ggml_tensor  * d3,
+        struct ggml_tensor  * d4) {
+    struct ggml_tensor * d[5] = { d0, d1, d2, d3, d4 };
+    int first = 0, nd = 0;
+    switch (op->op) {
+        case GGML_OP_DSV41_ROUTER: first = 3; nd = 2; break;
+        case GGML_OP_DSV41_HC_FA:  first = 6; nd = 1; GGML_ASSERT(op->src[3] != NULL); break;
+        case GGML_OP_DSV41_HC_FB:  first = 4; nd = 5; break;
+        default: GGML_ABORT("ggml_dsv41_write_to: not a fused DSV4.1 op that takes destinations");
+    }
+    for (int i = 0; i < 5; ++i) {
+        if (!d[i]) continue;
+        GGML_ASSERT(i < nd && ggml_is_contiguous(d[i]));
+        op->src[first + i] = d[i];
+    }
+    return op;
+}
