+// larry: the reclaim hook (ggml_backend_sycl_set_reclaim_hook)
+static bool (*g_reclaim_fn)(int device, size_t bytes, void * ud) = nullptr;
+static void * g_reclaim_ud = nullptr;
+
+void ggml_sycl_set_reclaim(bool (*fn)(int device, size_t bytes, void * ud), void * ud) {
+    g_reclaim_fn = fn;
+    g_reclaim_ud = ud;
+}
+
+bool ggml_sycl_reclaim(int device, size_t bytes) {
+    return g_reclaim_fn && device >= 0 && g_reclaim_fn(device, bytes, g_reclaim_ud);
+}
+
+bool ggml_sycl_reclaim(const sycl::queue & q, size_t bytes) {
+    if (!g_reclaim_fn) return false;
+    const sycl::device d = q.get_device();
+    for (int i = 0; i < ggml_sycl_info().device_count; ++i)
+        if (dpct::dev_mgr::instance().get_device(i) == d) return ggml_sycl_reclaim(i, bytes);
+    return false;
+}
+
+static void * ggml_sycl_malloc_device_once(size_t size, sycl::queue &q, ggml_sycl_mem_type type);
+
+// larry: a failed allocation asks the reclaim hook once (an engine's droppable copies on that card), then retries
+void * ggml_sycl_malloc_device(size_t size, sycl::queue &q, ggml_sycl_mem_type type) {
+    void * p = ggml_sycl_malloc_device_once(size, q, type);
+    if (!p && ggml_sycl_reclaim(q, size)) p = ggml_sycl_malloc_device_once(size, q, type);
