+                out->ne[3] == 1 && out->nb[0] == sizeof(float));
+    struct ggml_tensor * result = ggml_view_tensor(ctx, out);
+    result->op     = GGML_OP_DSV41_MVQ;
+    result->src[0] = w;
+    result->src[1] = x;
+    result->src[2] = x8;
+    return result;
+}
