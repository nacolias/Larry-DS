+    stream->parallel_for(sycl::range<1>((size_t) NKV * E), [=](sycl::id<1> id) {
+        const size_t i = id[0];
+        const int64_t e = (int64_t) (i % E), j = (int64_t) (i / E);
+        const char * row = kd + j * nbk2;
+        float v;
+        if (kt == GGML_TYPE_F16) v = (float) ((const sycl::half *) row)[e];
+        else if (kt == GGML_TYPE_BF16) v = (float) ((const sycl::ext::oneapi::bfloat16 *) row)[e];
+        else v = ((const float *) row)[e];
+        kh[i] = (sycl::half) v;
+    });
+    const int64_t MR = B * H;
+    int64_t CH = (int64_t) ((256ull << 20) / ((size_t) MR * sizeof(float)));
+    CH = std::max<int64_t>(256, std::min<int64_t>(CH, NKV)) / 16 * 16;
+    if (CH <= 0) CH = 16;
+    ggml_sycl_pool_alloc<float> S(pool, (size_t) MR * CH);
+    float * s = S.get();
+    const char * wd = (const char *) w->data;
+    const char * md = (const char *) m->data;
+    float * od = (float *) dst->data;
+    const bool nvm = dst->op_params[0] == 1;   // larry, patch-linvis.py: src[3] = nvis F32 [B]
+    for (int64_t j0 = 0; j0 < NKV; j0 += CH) {
+        const int64_t nc = std::min<int64_t>(CH, NKV - j0);
+        mkl::blas::row_major::gemm(*stream, mkl::transpose::nontrans, mkl::transpose::trans, MR, nc, E, 1.0f, qh, E,
+                                   kh + j0 * E, E, 0.0f, s, nc);
+        stream->parallel_for(sycl::range<2>((size_t) B, (size_t) nc), [=](sycl::id<2> id) {
+            const int64_t b = (int64_t) id[0], jj = (int64_t) id[1];
+            const float * wb = (const float *) (wd + b * nbw1);
+            float acc = 0.0f;
+            for (int64_t h = 0; h < H; ++h) acc += sycl::fmax(s[(b * H + h) * nc + jj], 0.0f) * wb[h];
+            const float mv = nvm ? ((float) (j0 + jj) < ((const float *) md)[b] ? 0.0f : -INFINITY)
+                                 : (float) ((const sycl::half *) (md + b * nbm1))[j0 + jj];
+            od[(j0 + jj) + b * (int64_t) (nb1 / sizeof(float))] = acc + mv;
+        });
+    }
+}
+
+
+// ---- larry, GGML_SYCL_LI_XMX (default 0): decode / verify batches (<= 8 queries) with BF16 keys as ONE XMX kernel -
+// S tiles stay in registers / local memory (li_gemm writes S [B*H x NKV] f32 and reads it back), keys read once.
+// Sub-group: 8 key rows x 32 heads of one query = 2 accumulators (heads 0-15, 16-31), K = 128 in 8 bf16 DPAS steps;
+// A = the keys as stored (row-major), B = the query packed once per call (VNNI pairs, 16 x 16 tiles).  Epilogue: the
+// tile to local memory, lane i < 8 sums its key row over the heads (relu x weight) + the mask.
+#include <sycl/ext/oneapi/matrix/matrix.hpp>
+
+namespace li_mx = sycl::ext::oneapi::experimental::matrix;
+using li_bf16 = sycl::ext::oneapi::bfloat16;
+
+static bool li_xmx_ok(const ggml_tensor * dst) {
+    static const int on = [] { const char * v = std::getenv("GGML_SYCL_LI_XMX"); return v && *v ? std::atoi(v) : 0; }();
+    if (!on || dst->op_params[0] == 1) return false;   // (nvis: patch-linvis.py)
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    return k->type == GGML_TYPE_BF16 && q->type == GGML_TYPE_F32 && q->ne[0] == 128 && q->ne[1] == 32 && q->ne[2] >= 1 &&
+           q->ne[2] <= 8 && q->ne[3] == 1 && k->ne[0] == 128 && k->ne[1] == 1 && k->ne[3] == 1 && k->nb[0] == 2 &&
+           k->nb[2] % 64 == 0 && k->ne[2] % 8 == 0 && ((uintptr_t) k->data) % 64 == 0 && q->nb[0] == 4;
+}
+
+// q [128, 32, B] f32 -> qp: per (query b, head tile nt, dim step ks) a 16 x 16 B tile in the packed layout - element
+// (k2, n) = the bf16 pair (q[b][16 nt + n][16 ks + 2 k2], q[b][16 nt + n][16 ks + 2 k2 + 1]); 256 bf16 a tile.
+static void li_xmx_pack_q(const char * q, size_t nbq1, size_t nbq2, int64_t B, li_bf16 * qp, queue_ptr stream) {
+    stream->parallel_for(sycl::range<1>((size_t) B * 2 * 8 * 8 * 16), [=](sycl::id<1> id) {
+        const int64_t i = (int64_t) id[0];
+        const int n = (int) (i % 16), k2 = (int) ((i / 16) % 8), ks = (int) ((i / 128) % 8), nt = (int) ((i / 1024) % 2);
+        const int64_t b = i / 2048;
+        const float * row = (const float *) (q + b * nbq2 + (size_t) (16 * nt + n) * nbq1);
+        li_bf16 * t = qp + ((b * 2 + nt) * 8 + ks) * 256;
+        t[(k2 * 16 + n) * 2 + 0] = (li_bf16) row[16 * ks + 2 * k2];
+        t[(k2 * 16 + n) * 2 + 1] = (li_bf16) row[16 * ks + 2 * k2 + 1];
+    });
+}
+
+static void li_xmx_run(const li_bf16 * kd, int64_t ld_k, int64_t NKV, const li_bf16 * qp, const char * w, size_t nbw1,
+                       const char * m, size_t nbm1, float * od, int64_t ld_o, int64_t B, queue_ptr stream) {
+    constexpr int SG = 16, SGPWG = 8, TPS = 4;   // sub-groups a work-group, 8-row key tiles a sub-group
+    const int64_t ntiles = NKV / 8;
+    const int64_t nsg = (ntiles + TPS - 1) / TPS;
+    const int64_t nwg = (nsg + SGPWG - 1) / SGPWG;
+    stream->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> scr(sycl::range<1>((size_t) SGPWG * 256), h);
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) nwg * SGPWG * SG), sycl::range<1>(SGPWG * SG)),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+            const sycl::sub_group sg = it.get_sub_group();
+            const int sgi = (int) sg.get_group_linear_id();
+            const int lane = (int) sg.get_local_linear_id();
+            const int64_t gsg = (int64_t) it.get_group(0) * SGPWG + sgi;
+            auto sp = scr.get_multi_ptr<sycl::access::decorated::no>() + (size_t) sgi * 256;
+            for (int tt = 0; tt < TPS; ++tt) {
+                const int64_t tile = gsg * TPS + tt;
+                if (tile >= ntiles) break;   // (uniform across the sub-group)
+                const int64_t row0 = tile * 8;
+                for (int64_t b = 0; b < B; ++b) {
+                    li_mx::joint_matrix<sycl::sub_group, float, li_mx::use::accumulator, 8, 16> c0, c1;
+                    li_mx::joint_matrix_fill(sg, c0, 0.0f);
+                    li_mx::joint_matrix_fill(sg, c1, 0.0f);
+                    for (int ks = 0; ks < 8; ++ks) {
+                        li_mx::joint_matrix<sycl::sub_group, li_bf16, li_mx::use::a, 8, 16, li_mx::layout::row_major> ma;
+                        li_mx::joint_matrix<sycl::sub_group, li_bf16, li_mx::use::b, 16, 16, li_mx::layout::ext_intel_packed> mb0, mb1;
+                        li_mx::joint_matrix_load(sg, ma, sycl::address_space_cast<sycl::access::address_space::global_space,
+                                                 sycl::access::decorated::no>(kd + row0 * ld_k + ks * 16), ld_k);
+                        li_mx::joint_matrix_load(sg, mb0, sycl::address_space_cast<sycl::access::address_space::global_space,
+                                                 sycl::access::decorated::no>(qp + ((b * 2 + 0) * 8 + ks) * 256), 32);
+                        li_mx::joint_matrix_load(sg, mb1, sycl::address_space_cast<sycl::access::address_space::global_space,
+                                                 sycl::access::decorated::no>(qp + ((b * 2 + 1) * 8 + ks) * 256), 32);
+                        li_mx::joint_matrix_mad(sg, c0, ma, mb0, c0);
+                        li_mx::joint_matrix_mad(sg, c1, ma, mb1, c1);
+                    }
+                    li_mx::joint_matrix_store(sg, c0, sp, 16, li_mx::layout::row_major);         // [8 rows][16 heads]
+                    li_mx::joint_matrix_store(sg, c1, sp + 128, 16, li_mx::layout::row_major);   // heads 16-31
+                    sycl::group_barrier(sg);
+                    if (lane < 8) {
+                        const float * wb = (const float *) (w + b * nbw1);
+                        float acc = 0.0f;
+                        for (int n = 0; n < 16; ++n) acc += sycl::fmax(sp[lane * 16 + n], 0.0f) * wb[n];
+                        for (int n = 0; n < 16; ++n) acc += sycl::fmax(sp[128 + lane * 16 + n], 0.0f) * wb[16 + n];
+                        const sycl::half * mb = (const sycl::half *) (m + b * nbm1);
+                        od[b * ld_o + row0 + lane] = acc + (float) mb[row0 + lane];
+                    }
+                    sycl::group_barrier(sg);
+                }
+            }
+        });
+    });
+}
+
+static bool li_gemm_ok(const ggml_tensor * dst);
+static void li_gemm(ggml_backend_sycl_context & ctx, ggml_tensor * dst);
+
+static bool li_xmx(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const ggml_tensor * w = dst->src[2];
+    const ggml_tensor * m = dst->src[3];
+    const int64_t B = q->ne[2], NKV = k->ne[2];
+    queue_ptr stream = ctx.stream();
+    ggml_sycl_pool_alloc<li_bf16> QP(ctx.pool(), (size_t) B * 4096);
+    li_xmx_pack_q((const char *) q->data, q->nb[1], q->nb[2], B, QP.get(), stream);
+    li_xmx_run((const li_bf16 *) k->data, (int64_t) (k->nb[2] / 2), NKV, QP.get(), (const char *) w->data, w->nb[1],
+               (const char *) m->data, m->nb[1], (float *) dst->data, (int64_t) (dst->nb[1] / sizeof(float)), B, stream);
+    static const int check = [] { const char * v = std::getenv("GGML_SYCL_LI_XMX_CHECK"); return v && *v ? std::atoi(v) : 0; }();
+    static int nchk = 0;
+    if (check && nchk < 32) {   // debug: the same call through li_gemm into a copy of dst, the largest difference
+        ++nchk;
+        const size_t n = (size_t) B * NKV;
+        std::vector<float> a(n), r(n);
+        stream->wait();
+        for (int64_t b = 0; b < B; ++b)
+            stream->memcpy(a.data() + b * NKV, (const char *) dst->data + b * dst->nb[1], NKV * sizeof(float)).wait();
+        li_gemm(ctx, dst);
+        stream->wait();
+        for (int64_t b = 0; b < B; ++b)
+            stream->memcpy(r.data() + b * NKV, (const char *) dst->data + b * dst->nb[1], NKV * sizeof(float)).wait();
+        double md = 0, mx = 0;
+        for (size_t i = 0; i < n; ++i) {
+            if (!std::isfinite(r[i]) || !std::isfinite(a[i])) { if (std::isfinite(r[i]) != std::isfinite(a[i])) md = INFINITY; continue; }
+            md = std::max(md, (double) std::fabs(a[i] - r[i]));
+            mx = std::max(mx, (double) std::fabs(r[i]));
+        }
+        GGML_LOG_INFO("larry li_xmx check %d: %lld queries x %lld keys: max |diff| %.3e of max %.3e\n", nchk, (long long) B,
+                      (long long) NKV, md, mx);
+    }
+    return true;
+}
+
+// ---- larry, GGML_SYCL_LI_FUSED (patch-lifused.py, default 0): prompt batches as ONE fused XMX kernel - S stays in
+// registers.  A sub-group = one query (32 heads = 4 row tiles of 8) x 32 keys (2 column tiles of 16) a step, K = 128 in
+// 8 steps, fp16 x fp16 -> f32, B = keys^T col_major from the key rows; an accumulator lane holds its key's column
+// (element i = row i), so the relu-weighted head sum is lane-local.  Steps whose 32 keys are all masked for the query
+// write -inf without the multiplies.
+
+using lif_C = li_mx::joint_matrix<sycl::sub_group, float, li_mx::use::accumulator, 8, 16>;
+
+static int lif_mode() {
+    static const int v = [] { const char * e = std::getenv("GGML_SYCL_LI_FUSED"); return e && *e ? std::atoi(e) : 0; }();
+    return v;
+}
+
+static bool li_fused_ok(const ggml_tensor * dst) {
+    static const int min_b = [] { const char * v = std::getenv("GGML_SYCL_LI_FUSED_MIN"); return v && *v ? std::atoi(v) : 16; }();
+    if (!lif_mode()) return false;
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const ggml_tensor * w = dst->src[2];
+    const ggml_tensor * m = dst->src[3];
+    if (q->ne[0] != 128 || q->ne[1] != 32 || q->ne[2] < min_b || q->ne[3] != 1 || k->ne[0] != 128 || k->ne[1] != 1 ||
+        k->ne[3] != 1 || q->nb[0] != sizeof(float) || k->nb[0] != ggml_type_size(k->type) ||
+        w->nb[0] != sizeof(float) || dst->nb[0] != sizeof(float)) return false;
+    if (w->nb[1] % sizeof(float) || dst->nb[1] % sizeof(float)) return false;
+    if (dst->op_params[0] == 1) return m->type == GGML_TYPE_F32 && ggml_is_contiguous(m);   // nvis (patch-linvis.py)
+    if (m->ne[3] != 1 || m->nb[0] != sizeof(sycl::half) || m->nb[1] % sizeof(sycl::half)) return false;
+    return k->type == GGML_TYPE_F16 || k->type == GGML_TYPE_BF16 || k->type == GGML_TYPE_F32;
+}
+
+#define LIF_HSUM(s, x0, x1, x2, x3)                                                                        \
+    {                                                                                                     \
+        auto v0 = sycl::ext::oneapi::detail::get_wi_data(sg, x0);                                         \
+        auto v1 = sycl::ext::oneapi::detail::get_wi_data(sg, x1);                                         \
+        auto v2 = sycl::ext::oneapi::detail::get_wi_data(sg, x2);                                         \
+        auto v3 = sycl::ext::oneapi::detail::get_wi_data(sg, x3);                                         \
+        _Pragma("unroll") for (int i = 0; i < 8; ++i) {                                                   \
+            s += sycl::select_from_group(sg, wl0, i) * sycl::fmax((float) v0[i], 0.0f);                   \
+            s += sycl::select_from_group(sg, wl0, 8 + i) * sycl::fmax((float) v1[i], 0.0f);               \
+            s += sycl::select_from_group(sg, wl1, i) * sycl::fmax((float) v2[i], 0.0f);                   \
+            s += sycl::select_from_group(sg, wl1, 8 + i) * sycl::fmax((float) v3[i], 0.0f);               \
+        }                                                                                                 \
+    }
+
+// qh: fp16 [B][32][128]; kh: the keys in fp16 [NKVp][128] (zero rows past NKV, NKVp a multiple of 32)
+// larry (patch-lifbf16.py): T = sycl::half (those copies, ld_k 128) or li_bf16 (GGML_SYCL_LI_FUSED=2: the queries in bf16,
+// the BF16 keys read where they are, rows ld_k apart, NKV a multiple of 32)
+template <typename T>
+static void lif_run_t(const T * qh, const T * kh, int64_t ld_k, int64_t NKV, const float * w, int64_t ldw,
+                      const sycl::half * m, int64_t ldm, const float * nvis, float * od, int64_t ldo, int64_t B, int QW, int64_t KR,
+                      queue_ptr stream) {
+    using lif_A = li_mx::joint_matrix<sycl::sub_group, T, li_mx::use::a, 8, 16, li_mx::layout::row_major>;
+    using lif_B = li_mx::joint_matrix<sycl::sub_group, T, li_mx::use::b, 16, 16, li_mx::layout::col_major>;
+    const int64_t nkr = (NKV + KR - 1) / KR, nqb = (B + QW - 1) / QW;
+    stream->parallel_for(sycl::nd_range<1>((size_t) (nqb * nkr * QW * 16), (size_t) (QW * 16)),
+                         [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+        const sycl::sub_group sg = it.get_sub_group();
+        const int lane = (int) sg.get_local_linear_id();
+        const int64_t g = (int64_t) it.get_group(0);
+        const int64_t kr = g % nkr, b = (g / nkr) * QW + (int64_t) sg.get_group_linear_id();
+        if (b >= B) return;
+        const float wl0 = w[b * ldw + lane], wl1 = w[b * ldw + 16 + lane];
+        const T * qr = qh + b * 32 * 128;
+        const sycl::half * mr = m + b * ldm;
+        const float nv = nvis ? nvis[b] : 0.0f;   // nvis: rows j < nv visible (patch-linvis.py)
+        float * orow = od + b * ldo;
+        const int64_t j1 = sycl::min(NKV, (kr + 1) * KR);
+        for (int64_t j0 = kr * KR; j0 < j1; j0 += 32) {
+            const int64_t ja = j0 + lane, jb = j0 + 16 + lane;
+            const float ma = ja >= NKV ? -INFINITY : nvis ? ((float) ja < nv ? 0.0f : -INFINITY) : (float) mr[ja];
+            const float mb = jb >= NKV ? -INFINITY : nvis ? ((float) jb < nv ? 0.0f : -INFINITY) : (float) mr[jb];
+            if (sycl::all_of_group(sg, ma == -INFINITY && mb == -INFINITY)) {
+                if (ja < NKV) orow[ja] = -INFINITY;
+                if (jb < NKV) orow[jb] = -INFINITY;
+                continue;
+            }
+            lif_C c00, c01, c10, c11, c20, c21, c30, c31;
+            li_mx::joint_matrix_fill(sg, c00, 0.0f); li_mx::joint_matrix_fill(sg, c01, 0.0f);
+            li_mx::joint_matrix_fill(sg, c10, 0.0f); li_mx::joint_matrix_fill(sg, c11, 0.0f);
+            li_mx::joint_matrix_fill(sg, c20, 0.0f); li_mx::joint_matrix_fill(sg, c21, 0.0f);
+            li_mx::joint_matrix_fill(sg, c30, 0.0f); li_mx::joint_matrix_fill(sg, c31, 0.0f);
+#pragma unroll
+            for (int ks = 0; ks < 8; ++ks) {
+                lif_A a0, a1, a2, a3;
+                lif_B b0, b1;
+                li_mx::joint_matrix_load(sg, a0, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(qr + 0 * 1024 + ks * 16), 128);
+                li_mx::joint_matrix_load(sg, a1, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(qr + 1 * 1024 + ks * 16), 128);
+                li_mx::joint_matrix_load(sg, a2, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(qr + 2 * 1024 + ks * 16), 128);
+                li_mx::joint_matrix_load(sg, a3, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(qr + 3 * 1024 + ks * 16), 128);
+                li_mx::joint_matrix_load(sg, b0, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(kh + j0 * ld_k + ks * 16), ld_k);
+                li_mx::joint_matrix_load(sg, b1, sycl::address_space_cast<sycl::access::address_space::global_space, sycl::access::decorated::no>(kh + (j0 + 16) * ld_k + ks * 16), ld_k);
+                li_mx::joint_matrix_mad(sg, c00, a0, b0, c00); li_mx::joint_matrix_mad(sg, c01, a0, b1, c01);
+                li_mx::joint_matrix_mad(sg, c10, a1, b0, c10); li_mx::joint_matrix_mad(sg, c11, a1, b1, c11);
+                li_mx::joint_matrix_mad(sg, c20, a2, b0, c20); li_mx::joint_matrix_mad(sg, c21, a2, b1, c21);
+                li_mx::joint_matrix_mad(sg, c30, a3, b0, c30); li_mx::joint_matrix_mad(sg, c31, a3, b1, c31);
+            }
+            float s0 = 0.0f, s1 = 0.0f;
+            LIF_HSUM(s0, c00, c10, c20, c30)
+            LIF_HSUM(s1, c01, c11, c21, c31)
+            if (ja < NKV) orow[ja] = s0 + ma;
+            if (jb < NKV) orow[jb] = s1 + mb;
+        }
+    });
+}
+
+static bool li_fused(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * q = dst->src[0];
+    const ggml_tensor * k = dst->src[1];
+    const ggml_tensor * w = dst->src[2];
+    const ggml_tensor * m = dst->src[3];
+    const int64_t B = q->ne[2], NKV = k->ne[2], NKVp = (NKV + 31) / 32 * 32;
+    const size_t nbq1 = q->nb[1], nbq2 = q->nb[2], nbk2 = k->nb[2];
+    const ggml_type kt = k->type;
+    queue_ptr stream = ctx.stream();
+    ggml_sycl_pool & pool = ctx.pool();
+    // larry (patch-lifbf16.py, GGML_SYCL_LI_FUSED=2): BF16 keys in rows of 128, a multiple of 32 of them, read as they are
+    if (lif_mode() == 2 && kt == GGML_TYPE_BF16 && nbk2 == 256 && NKV % 32 == 0 && ((uintptr_t) k->data) % 64 == 0) {
+        ggml_sycl_pool_alloc<li_bf16> Qb(pool, (size_t) B * 32 * 128);
+        li_bf16 * qb = Qb.get();
+        const char * qd = (const char *) q->data;
+        stream->parallel_for(sycl::range<1>((size_t) B * 32 * 128), [=](sycl::id<1> id) {
+            const size_t i = id[0];
+            const int64_t e = (int64_t) (i % 128), hh = (int64_t) ((i / 128) % 32), b = (int64_t) (i / 4096);
+            qb[i] = (li_bf16) *(const float *) (qd + b * nbq2 + hh * nbq1 + e * sizeof(float));
+        });
+        static const int qw_env2 = [] { const char * v = std::getenv("GGML_SYCL_LI_FUSED_QW"); return v && *v ? std::atoi(v) : 0; }();
+        static const int64_t kr_env2 = [] { const char * v = std::getenv("GGML_SYCL_LI_FUSED_KR"); return v && *v ? std::atoll(v) : 0; }();
+        const int qw2 = qw_env2 > 0 ? qw_env2 : NKV > 131072 ? 16 : 8;
+        const int64_t KR2 = kr_env2 > 0 ? (kr_env2 + 31) / 32 * 32 : NKV <= 16384 ? 128 : NKV <= 65536 ? 256 : 512;
+        const bool nvm2 = dst->op_params[0] == 1;
+        const float * wd = (const float *) w->data;
+        const int64_t ldw = (int64_t) (w->nb[1] / sizeof(float)), ldo = (int64_t) (dst->nb[1] / sizeof(float));
+        const sycl::half * md = nvm2 ? nullptr : (const sycl::half *) m->data;
+        const int64_t ldm = nvm2 ? 0 : (int64_t) (m->nb[1] / sizeof(sycl::half));
+        const float * nv = nvm2 ? (const float *) m->data : nullptr;
+        lif_run_t<li_bf16>(qb, (const li_bf16 *) k->data, 128, NKV, wd, ldw, md, ldm, nv, (float *) dst->data, ldo, B, qw2, KR2, stream);
+        static const int check16 = [] { const char * v = std::getenv("GGML_SYCL_LI_FUSED_CHECK16"); return v && *v ? std::atoi(v) : 0; }();
+        static int nchk16 = 0;
+        if (check16 && nchk16 < check16) {   // debug: the same call through mode 1 (fp16 copies) into scratch, compared bit for bit
+            ++nchk16;
+            ggml_sycl_pool_alloc<sycl::half> Q16(pool, (size_t) B * 32 * 128);
+            ggml_sycl_pool_alloc<sycl::half> K16(pool, (size_t) NKV * 128);
+            ggml_sycl_pool_alloc<char> ref(pool, (size_t) B * dst->nb[1]);
+            sycl::half * q16 = Q16.get();
+            sycl::half * k16 = K16.get();
+            const li_bf16 * kb = (const li_bf16 *) k->data;
+            stream->parallel_for(sycl::range<1>((size_t) B * 32 * 128), [=](sycl::id<1> id) { q16[id[0]] = (sycl::half) (float) qb[id[0]]; });
+            stream->parallel_for(sycl::range<1>((size_t) NKV * 128), [=](sycl::id<1> id) { k16[id[0]] = (sycl::half) (float) kb[id[0]]; });
+            lif_run_t<sycl::half>(q16, k16, 128, NKV, wd, ldw, md, ldm, nv, (float *) ref.get(), ldo, B, qw2, KR2, stream);
+            stream->wait();
+            std::vector<float> a((size_t) NKV), r((size_t) NKV);
+            int64_t differ = 0;
+            double md2 = 0;
+            for (int64_t b = 0; b < B; ++b) {
+                stream->memcpy(a.data(), (const char *) dst->data + b * dst->nb[1], NKV * sizeof(float)).wait();
+                stream->memcpy(r.data(), ref.get() + b * dst->nb[1], NKV * sizeof(float)).wait();
+                for (int64_t j = 0; j < NKV; ++j)
+                    if (std::memcmp(&a[(size_t) j], &r[(size_t) j], sizeof(float)) != 0) {
+                        ++differ;
+                        if (std::isfinite(a[(size_t) j]) && std::isfinite(r[(size_t) j]))
+                            md2 = std::max(md2, (double) std::fabs(a[(size_t) j] - r[(size_t) j]));
+                    }
+            }
+            GGML_LOG_INFO("larry li_fused bf16 check %d: %lld queries x %lld keys: %lld of %lld scores differ from the fp16 path "
+                          "(max |diff| %.3e)\n", nchk16, (long long) B, (long long) NKV, (long long) differ, (long long) (B * NKV), md2);
+        }
+        return true;
+    }
+    ggml_sycl_pool_alloc<sycl::half> Qh(pool, (size_t) B * 32 * 128);
+    ggml_sycl_pool_alloc<sycl::half> Kh(pool, (size_t) NKVp * 128);
+    sycl::half * qh = Qh.get();
+    sycl::half * kh = Kh.get();
+    const char * qd = (const char *) q->data;
+    const char * kd = (const char *) k->data;
+    stream->parallel_for(sycl::range<1>((size_t) B * 32 * 128), [=](sycl::id<1> id) {
+        const size_t i = id[0];
+        const int64_t e = (int64_t) (i % 128), hh = (int64_t) ((i / 128) % 32), b = (int64_t) (i / 4096);
+        qh[i] = (sycl::half) *(const float *) (qd + b * nbq2 + hh * nbq1 + e * sizeof(float));
+    });
+    stream->parallel_for(sycl::range<1>((size_t) NKVp * 128), [=](sycl::id<1> id) {
+        const int64_t i = (int64_t) id[0];
+        const int64_t j = i / 128, e = i % 128;
+        float v = 0.0f;
+        if (j < NKV) {
+            const char * row = kd + j * nbk2;
+            if (kt == GGML_TYPE_F16) v = (float) ((const sycl::half *) row)[e];
+            else if (kt == GGML_TYPE_BF16) v = (float) ((const sycl::ext::oneapi::bfloat16 *) row)[e];
+            else v = ((const float *) row)[e];
+        }
+        kh[i] = (sycl::half) v;
+    });
+    static const int qw_env = [] { const char * v = std::getenv("GGML_SYCL_LI_FUSED_QW"); return v && *v ? std::atoi(v) : 0; }();
+    static const int64_t kr_env = [] { const char * v = std::getenv("GGML_SYCL_LI_FUSED_KR"); return v && *v ? std::atoll(v) : 0; }();
+    // the li_probe sweep's best (card 1, 512 queries): 8 queries x 128 keys a work-group to 16K keys, 256 to 64K, 512
+    // beyond (16 queries past 128K)
+    const int qw = qw_env > 0 ? qw_env : NKV > 131072 ? 16 : 8;
+    const int64_t KR = kr_env > 0 ? (kr_env + 31) / 32 * 32 : NKV <= 16384 ? 128 : NKV <= 65536 ? 256 : 512;
+    const bool nvm = dst->op_params[0] == 1;
+    lif_run_t<sycl::half>(qh, kh, 128, NKV, (const float *) w->data, (int64_t) (w->nb[1] / sizeof(float)), nvm ? nullptr : (const sycl::half *) m->data,
+            nvm ? 0 : (int64_t) (m->nb[1] / sizeof(sycl::half)), nvm ? (const float *) m->data : nullptr, (float *) dst->data,
+            (int64_t) (dst->nb[1] / sizeof(float)), B, qw, KR, stream);
+    static const int check = [] { const char * v = std::getenv("GGML_SYCL_LI_FUSED_CHECK"); return v && *v ? std::atoi(v) : 0; }();
+    static int nchk = 0;
+    if (check && nchk < check) {   // debug: the same call through li_gemm into scratch (dst keeps ours), the largest difference
+        ++nchk;
+        const size_t n = (size_t) B * NKV;
+        std::vector<float> a(n), r(n);
+        ggml_sycl_pool_alloc<char> ref(pool, (size_t) B * dst->nb[1]);
+        stream->wait();
+        for (int64_t b = 0; b < B; ++b)
+            stream->memcpy(a.data() + b * NKV, (const char *) dst->data + b * dst->nb[1], NKV * sizeof(float)).wait();
+        void * keep = dst->data;
+        dst->data = ref.get();
+        li_gemm(ctx, dst);
+        dst->data = keep;
+        stream->wait();
+        for (int64_t b = 0; b < B; ++b)
+            stream->memcpy(r.data() + b * NKV, ref.get() + b * dst->nb[1], NKV * sizeof(float)).wait();
+        double md = 0, mx = 0;
+        int64_t bad = 0;
+        for (size_t i = 0; i < n; ++i) {
+            const bool fa = std::isfinite(a[i]), fr = std::isfinite(r[i]);
+            if (fa != fr || (!fa && a[i] != r[i])) { ++bad; continue; }
+            if (!fr) continue;
+            md = std::max(md, (double) std::fabs(a[i] - r[i]));
+            mx = std::max(mx, (double) std::fabs(r[i]));
+        }
+        GGML_LOG_INFO("larry li_fused check %d: %lld queries x %lld keys (KR %lld): max |diff| %.3e of max %.3e, %lld non-finite mismatches\n",
+                      nchk, (long long) B, (long long) NKV, (long long) KR, md, mx, (long long) bad);
+    }
+    return true;
+}
+
+// ---- larry (patch-litopk.py): the top-k mode - ggml_lightning_indexer_topk (op_params[0] = 2, [1] = k).  Mode 2's
+// scores (the BF16 keys as stored) a slice of queries at a time into scratch (<= GGML_SYCL_LI_TOPK_MIB, 512), each slice's
+// top-k taken there.  With ggml_backend_sycl_li_remote(1) a call of >= GGML_SYCL_LI_REMOTE_MIN_KEYS keys (65536) and >= 64
+// queries keeps one share of its queries (1 / (1 + the other cards)) and hands the others to the other cards of card 0's
+// context: card 0 stages the keys' rows they lack and their queries / weights / visible rows in a plain buffer of its own
+// (card 0's KV pages and ggml's pool are never read by a peer), each card pulls its part, scores and ranks it on its own
+// queue, and card 0 pulls their ids after its own share - all in queue order, no host wait.
+#include "topk-radix.hpp"
+#include "ggml-sycl.h"
+
+namespace {
+struct LirKeys {   // a card's copy of one keys tensor of the prompt: rows [0, have), in fp16 (the faster kernel at depth)
+    const void * src = nullptr;
+    sycl::half * dev = nullptr;
+    int64_t have = 0;
+};
+struct LirCard {
+    std::unique_ptr<sycl::queue> q;
+    int bsz = 1024;
+    std::vector<LirKeys> keys;
+    sycl::half * kpool = nullptr;    // [layers][nkv][128] - the keys' copies, a layer each (fp16)
+    li_bf16 * kin = nullptr;         // rows as they arrive (bf16, a stage-full), converted into kpool
+    li_bf16 * qb = nullptr;          // its queries as they arrive, bf16 [nq][32][128]
+    sycl::half * qh = nullptr;       // the same in fp16
+    float * w = nullptr;             // their weights [nq][32]
+    float * nv = nullptr;            // their visible rows [nq]
+    float * sc = nullptr;            // their scores [nq][nkv]
+    int32_t * sel = nullptr;         // their ids [nq][k <= 512]
+    sycl::event done;
+};
+struct Lir {
+    int on = 0;
+    bool ready = false;
+    int64_t nkv = 0, nq = 0;
+    int layers = 0;
+    sycl::context * ctx = nullptr;   // card 0's
+    std::vector<LirCard> cards;
+    uint8_t * stage = nullptr;       // card 0, plain device memory: what the others pull
+    size_t stage_cap = 0;
+};
+Lir g_lir;
+sycl::queue * g_lir_q0 = nullptr;   // card 0's queue (the dense backend's), set at the first top-k call
+
+constexpr size_t kLirKeyChunk = (size_t) 32 << 20;   // a key catch-up a stage-full at a time
+constexpr int kLirMaxK = 512;
+
+void lir_free() {
+    for (LirCard & c : g_lir.cards) {
+        c.q->wait();
+        for (void * p : { (void *) c.kpool, (void *) c.kin, (void *) c.qb, (void *) c.qh, (void *) c.w, (void *) c.nv, (void *) c.sc,
+                          (void *) c.sel })
+            if (p) sycl::free(p, *c.q);
+        c.kpool = nullptr; c.kin = nullptr; c.qb = nullptr; c.qh = nullptr; c.w = nullptr; c.nv = nullptr; c.sc = nullptr; c.sel = nullptr;
+        c.keys.clear();
+    }
+    if (g_lir.stage && g_lir_q0) { g_lir_q0->wait(); sycl::free(g_lir.stage, *g_lir_q0); }
+    g_lir.stage = nullptr;
+    g_lir.stage_cap = 0;
+    g_lir.ready = false;
+}
+
+// the other cards of card 0's context, a queue each (once)
+bool lir_cards(sycl::queue & q0) {
+    if (!g_lir.cards.empty()) return true;
+    const sycl::context ctx = q0.get_context();
+    for (const sycl::device & d : ctx.get_devices()) {
+        if (d == q0.get_device() || !d.is_gpu()) continue;
+        LirCard c;
+        // GGML_SYCL_LI_REMOTE_PRIO=1: its queue at low priority (the card's own work - the prompt's expert calls - first);
+        // measured at 984K worse: card 0 then waited longer for the shares (322.3 s against 313.2 at the default 0)
+        static const int prio = [] { const char * e = std::getenv("GGML_SYCL_LI_REMOTE_PRIO"); return e && *e ? std::atoi(e) : 0; }();
+        if (prio) c.q = std::make_unique<sycl::queue>(ctx, d, sycl::property_list{ sycl::property::queue::in_order(),
+                                                                                    sycl::ext::oneapi::property::queue::priority_low() });
+        else c.q = std::make_unique<sycl::queue>(ctx, d, sycl::property::queue::in_order());
+        c.bsz = (int) d.get_info<sycl::info::device::max_work_group_size>();
+        g_lir.cards.push_back(std::move(c));
+    }
+    return !g_lir.cards.empty();
+}
+
+int lir_min_keys() { static const int v = [] { const char * e = std::getenv("GGML_SYCL_LI_REMOTE_MIN_KEYS"); return e && *e ? std::atoi(e) : 65536; }(); return v; }
+
+// queries [n0, n) of the call to the other cards (false: not taken - no room, a shape it was not prepared for)
+// (the keys' rows past `fin` are not written yet - the cards copy rows [have, fin) only; every query sees fewer)
+bool lir_begin(sycl::queue & q0, const li_bf16 * kd, int64_t NKV, int64_t fin, const li_bf16 * qb, const float * w, const float * nv,
+               int64_t B, int K, int qw, int64_t KR, int64_t & n0, std::vector<int64_t> & bnd) {
+    const int nc = (int) g_lir.cards.size();
+    if (!g_lir.ready || NKV > g_lir.nkv || K > kLirMaxK) return false;
+    // card 0's share: GGML_SYCL_LI_REMOTE_SHARE % of the queries (default 25); the rest evenly over the others
+    static const int pct = [] { const char * e = std::getenv("GGML_SYCL_LI_REMOTE_SHARE"); return e && *e ? std::atoi(e) : 25; }();
+    const int64_t share = std::max<int64_t>(0, std::min<int64_t>(B - nc, (B * pct + 50) / 100));
+    if (B - share > (int64_t) nc * g_lir.nq) return false;
+    n0 = share;
+    bnd.assign((size_t) nc + 1, 0);
+    for (int c = 0; c <= nc; ++c) bnd[(size_t) c] = n0 + (B - n0) * c / nc;
+    // the keys tensor's copy on every card (the same rows on each)
+    int64_t have = fin;
+    for (LirCard & c : g_lir.cards) {
+        LirKeys * e = nullptr;
+        for (LirKeys & k : c.keys) if (k.src == kd) e = &k;
+        if (!e) {
+            if ((int) c.keys.size() >= g_lir.layers) return false;
+            LirKeys k;
+            k.src = kd;
+            k.dev = c.kpool + (size_t) c.keys.size() * (size_t) g_lir.nkv * 128;
+            c.keys.push_back(k);
+            e = &c.keys.back();
+        }
+        have = std::min(have, e->have);
+    }
+    // the stage: [the keys' new rows][queries n0..B][weights n0..B][visible rows n0..B] - rows that do not fit beside the
+    // queries go first, a stage at a time (a prompt that starts deep: its first call per keys tensor), the host waiting
+    const size_t qbytes = (size_t) (B - n0) * 8192, wbytes = (size_t) (B - n0) * 128, vbytes = (size_t) (B - n0) * 4;
+    const size_t tail = ((qbytes + 255) & ~(size_t) 255) + ((wbytes + 255) & ~(size_t) 255) + vbytes + 256;
+    if (tail + 256 > g_lir.stage_cap) return false;
+    const int64_t fit = (int64_t) ((g_lir.stage_cap - tail) / 256), full = (int64_t) (g_lir.stage_cap / 256);
+    while (fin - have > fit) {
+        const int64_t nr = std::min<int64_t>(full, fin - have);
+        q0.memcpy(g_lir.stage, kd + have * 128, (size_t) nr * 256);
+        const sycl::event e0 = q0.ext_oneapi_submit_barrier();
+        for (LirCard & c : g_lir.cards) {
+            LirKeys * k = nullptr;
+            for (LirKeys & x : c.keys) if (x.src == kd) k = &x;
+            c.q->ext_oneapi_submit_barrier({ e0 });
+            c.q->memcpy(c.kin, g_lir.stage, (size_t) nr * 256);
+            sycl::half * kdst = k->dev + have * 128;
+            const li_bf16 * kin = c.kin;
+            c.q->parallel_for(sycl::range<1>((size_t) nr * 128), [=](sycl::id<1> i) { kdst[i[0]] = (sycl::half) (float) kin[i[0]]; });
+        }
+        for (LirCard & c : g_lir.cards) {
+            c.q->wait();
+            for (LirKeys & x : c.keys) if (x.src == kd) x.have = have + nr;
+        }
+        have += nr;
+    }
+    const size_t kb = (size_t) std::max<int64_t>(0, fin - have) * 256;
+    const size_t qo = (kb + 255) & ~(size_t) 255, wo = qo + ((qbytes + 255) & ~(size_t) 255), vo = wo + ((wbytes + 255) & ~(size_t) 255);
+    if (kb) q0.memcpy(g_lir.stage, kd + have * 128, kb);
+    q0.memcpy(g_lir.stage + qo, qb + n0 * 4096, qbytes);
+    q0.memcpy(g_lir.stage + wo, w + n0 * 32, wbytes);
+    q0.memcpy(g_lir.stage + vo, nv + n0, vbytes);
+    const sycl::event es = q0.ext_oneapi_submit_barrier();
+    for (int ci = 0; ci < nc; ++ci) {
+        LirCard & c = g_lir.cards[(size_t) ci];
+        LirKeys * k = nullptr;
+        for (LirKeys & x : c.keys) if (x.src == kd) k = &x;
+        const int64_t b0 = bnd[(size_t) ci], nq = bnd[(size_t) ci + 1] - b0, off = b0 - n0;
+        c.q->ext_oneapi_submit_barrier({ es });
+        if (kb) {
+            c.q->memcpy(c.kin, g_lir.stage, kb);
+            sycl::half * kdst = k->dev + have * 128;
+            const li_bf16 * kin = c.kin;
+            c.q->parallel_for(sycl::range<1>(kb / 2), [=](sycl::id<1> i) { kdst[i[0]] = (sycl::half) (float) kin[i[0]]; });
+        }
+        c.q->memcpy(c.qb, g_lir.stage + qo + (size_t) off * 8192, (size_t) nq * 8192);
+        c.q->memcpy(c.w, g_lir.stage + wo + (size_t) off * 128, (size_t) nq * 128);
+        c.q->memcpy(c.nv, g_lir.stage + vo + (size_t) off * 4, (size_t) nq * 4);
+        if (nq > 0) {
+            const li_bf16 * qin = c.qb;
+            sycl::half * qh = c.qh;
+            c.q->parallel_for(sycl::range<1>((size_t) nq * 4096), [=](sycl::id<1> i) { qh[i[0]] = (sycl::half) (float) qin[i[0]]; });
+            lif_run_t<sycl::half>(c.qh, k->dev, 128, NKV, c.w, 32, nullptr, 0, c.nv, c.sc, NKV, nq, qw, KR, c.q.get());
+            ggml_sycl_top_k_rows(*c.q, c.bsz, c.sc, c.sel, NKV, nq, K);
+        }
+        c.done = c.q->ext_oneapi_submit_barrier();
+        k->have = std::max(k->have, fin);
+    }
+    return true;
+}
+
+void lir_end(sycl::queue & q0, int32_t * out, int K, const std::vector<int64_t> & bnd) {
+    std::vector<sycl::event> ev;
+    for (LirCard & c : g_lir.cards) ev.push_back(c.done);
+    q0.ext_oneapi_submit_barrier(ev);
+    for (size_t ci = 0; ci < g_lir.cards.size(); ++ci) {
+        const int64_t b0 = bnd[ci], nq = bnd[ci + 1] - b0;
+        if (nq > 0) q0.memcpy(out + b0 * K, g_lir.cards[ci].sel, (size_t) nq * K * 4);
+    }
+}
+}  // namespace
+
+bool ggml_backend_sycl_li_remote_prepare(void * queue0, int64_t nkv, int layers, int64_t nq) {
+    if (queue0) g_lir_q0 = (sycl::queue *) queue0;   // card 0's: the dense backend's
+    if (!g_lir_q0) return false;
+    sycl::queue & q0 = *g_lir_q0;
+    if (!lir_cards(q0)) return false;
+    nkv = (nkv + 31) / 32 * 32;
+    if (g_lir.ready && nkv <= g_lir.nkv && layers <= g_lir.layers && nq <= g_lir.nq) return true;
+    lir_free();
+    g_lir.nkv = nkv; g_lir.layers = layers; g_lir.nq = nq;
+    // the stage: a key chunk, or one call's new rows + the others' queries (nc * nq of them), whichever is larger
+    const size_t call = (size_t) 2 * 1024 * 256 + (size_t) g_lir.cards.size() * (size_t) nq * (8192 + 128 + 4) + 4096;
+    g_lir.stage_cap = std::max(kLirKeyChunk, call);
+    bool ok = true;
+    for (LirCard & c : g_lir.cards) {
+        c.kpool = sycl::malloc_device<sycl::half>((size_t) layers * (size_t) nkv * 128, *c.q);
+        c.kin = sycl::malloc_device<li_bf16>(g_lir.stage_cap / 2, *c.q);
+        c.qb = sycl::malloc_device<li_bf16>((size_t) nq * 4096, *c.q);
+        c.qh = sycl::malloc_device<sycl::half>((size_t) nq * 4096, *c.q);
+        c.w = sycl::malloc_device<float>((size_t) nq * 32, *c.q);
+        c.nv = sycl::malloc_device<float>((size_t) nq, *c.q);
+        c.sc = sycl::malloc_device<float>((size_t) nq * (size_t) nkv, *c.q);
+        c.sel = sycl::malloc_device<int32_t>((size_t) nq * kLirMaxK, *c.q);
+        ok = ok && c.kpool && c.kin && c.qb && c.qh && c.w && c.nv && c.sc && c.sel;
+    }
+    g_lir.stage = sycl::malloc_device<uint8_t>(g_lir.stage_cap, q0);
+    ok = ok && g_lir.stage;
+    if (!ok) { lir_free(); GGML_LOG_INFO("larry li remote: no room for %lld keys x %d layers, %lld queries a card\n", (long long) nkv, layers, (long long) nq); return false; }
+    g_lir.ready = true;
+    GGML_LOG_INFO("larry li remote: %zu cards, %lld keys x %d layers, %lld queries a card (%.0f MiB a card)\n", g_lir.cards.size(),
+                  (long long) nkv, layers, (long long) nq,
+                  ((double) layers * nkv * 256 + (double) g_lir.stage_cap + (double) nq * (16384 + 132 + 4.0 * nkv + 4.0 * kLirMaxK)) / 1048576.0);
+    return true;
+}
+
+void ggml_backend_sycl_li_remote(int on) { g_lir.on = on; }
+
+void ggml_backend_sycl_li_remote_release(void) {
+    g_lir.on = 0;
