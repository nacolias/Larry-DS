+    // Result F32: scores [NKV, n] (-inf where masked), then with lastblk the block maxima [NKV / 8, n] (1-D).
+    GGML_API struct ggml_tensor * ggml_dsv41_li_dec(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * q,
+            struct ggml_tensor  * keys,
+            struct ggml_tensor  * w,
+            struct ggml_tensor  * nvis,
+            struct ggml_tensor  * tab,
+            struct ggml_tensor  * cand,
+            struct ggml_tensor  * lastblk,
+            float                 wscale,
+            int                   n_dims,
+            bool                  fq);
+    // larry: top-k ids (I32 [K, n], K <= 512) sorted ascending into sel (I32 [K, n]) and selm (F32 [K, n]: 0 where
