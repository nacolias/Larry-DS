+    const ggml_tensor * par = src0->view_src ? src0->view_src : src0;
+    return src0->type == GGML_TYPE_Q6_K && src0->ne[2] > 1 && src0->ne[3] == 1 && src0->data == par->data &&
+           src0->ne[0] % QK_K == 0 && src0->nb[0] == sizeof(block_q6_K) &&
+           src0->nb[1] == (size_t) (src0->ne[0] / QK_K) * sizeof(block_q6_K) && src0->nb[2] == src0->nb[1] * src0->ne[1] &&
+           src0->nb[2] * src0->ne[2] == ggml_nbytes(par) && par->extra &&
+           !static_cast<const ggml_tensor_extra_gpu *>(par->extra)->optimized_feature.reorder;
+}
+
+bool ggml_backend_sycl_prereorder_slices(ggml_backend_t backend, ggml_tensor * t, int64_t n_slices) {
+    // the knobs larry_fastmv reads a planar slice through: without them a reorder here would leave it unreadable
+    static const int on = ggml_sycl_get_env("GGML_SYCL_LARRY_FASTMV", 1);
+    static const int q6r8 = ggml_sycl_get_env("GGML_SYCL_LARRY_Q6R8", 1);
+    static const int woa = ggml_sycl_get_env("GGML_SYCL_LARRY_WOA", 1);
+    if (!on || !q6r8 || !woa || !backend || !t || t->type != GGML_TYPE_Q6_K || t->view_src || t->ne[2] != 1 ||
+        t->ne[3] != 1 || n_slices < 2 || t->ne[1] % n_slices || t->ne[0] % QK_K || !t->extra) return false;
+    if (g_larry_slice_planar.count(t->data)) return true;
+    if (static_cast<const ggml_tensor_extra_gpu *>(t->extra)->optimized_feature.reorder) return false;   // reordered whole
+    auto * ctx = static_cast<ggml_backend_sycl_context *>(backend->context);
+    if (!reorder_qw_q6_k_moe((uint8_t *) t->data, ggml_nbytes(t) / n_slices, n_slices, ctx->stream())) return false;
+    g_larry_slice_planar.insert(t->data);
+    return true;
+}
+
+// larry, patch-slicesbatch.py / patch-oproja.py: dst_g [ncols][N] (ld ldc, slices sc apart) = X_g [ncols][K] . W_g^T
+// for every slice in ONE gemm_batch - xs [ncols][G][K] f32 contiguous (converted to fp16 once), the per-slice planar
+// Q6_K slices (w0, sb bytes apart) dequantised into one fp16 cache entry
+static void larry_slices_batched(ggml_backend_sycl_context & ctx, const char * w0, size_t sb, int64_t N, int64_t K, int64_t G,
+                                 const float * xs, int64_t ncols, float * dd, int64_t ldc, int64_t sc,
+                                 const sycl::half * x16 = nullptr) {   // x16: the input already fp16 (patch-sdpao16.py)
+    dpct::queue_ptr st = ctx.stream();
+    ggml_sycl_pool_alloc<sycl::half> xa(ctx.pool(), x16 ? (size_t) 1 : (size_t) (ncols * G * K));
+    ggml_sycl_pool_alloc<sycl::half> wa(ctx.pool());   // only when the fp16 cache cannot hold the whole weight
+    auto deq = [&](sycl::half * y) {
+        for (int64_t g = 0; g < G; ++g) fastmv::dequant_q6k_planar_f16(*st, w0 + g * sb, N, K, y + g * N * K);
+    };
+    const sycl::half * w = larry_f16cache_core(w0, (size_t) (N * K * G), deq, st);
+    if (!w) {
+        wa.alloc((size_t) (N * K * G));
+        deq(wa.get());
+        w = wa.get();
+    }
+    const sycl::half * xh = x16 ? x16 : xa.get();
+    if (!x16) {
+        sycl::half * xw = xa.get();
+        const size_t ne4 = (size_t) (ncols * G * K) / 4;
+        st->parallel_for(sycl::range<1>(ne4), [=](sycl::id<1> i) {
+            const sycl::float4 v = *(const sycl::float4 *) (xs + 4 * i[0]);
+            *(sycl::vec<sycl::half, 4> *) (xw + 4 * i[0]) =
+                sycl::vec<sycl::half, 4>((sycl::half) v.x(), (sycl::half) v.y(), (sycl::half) v.z(), (sycl::half) v.w());
+        });
+    }
+    if (sc >= ldc * ncols) {   // separate slices: the strided batch
+        oneapi::mkl::blas::row_major::gemm_batch(*st, oneapi::mkl::transpose::nontrans, oneapi::mkl::transpose::trans, ncols, N, K,
+                                                 1.0f, xh, G * K, K, w, K, N * K, 0.0f, dd, ldc, sc, G);
+        return;
+    }
+    // larry, patch-oproja2.py: interleaved slices (wo_b's layout) - oneMKL's strided batch rejects a stride below ldc *
+    // rows, so the pointer form: one group of G products, the device pointer arrays written by a kernel
+    ggml_sycl_pool_alloc<const sycl::half *> pa(ctx.pool(), (size_t) G), pb(ctx.pool(), (size_t) G);
+    ggml_sycl_pool_alloc<float *> pc(ctx.pool(), (size_t) G);
+    const sycl::half ** ap = pa.get();
+    const sycl::half ** bp = pb.get();
+    float ** cp = pc.get();
+    st->parallel_for(sycl::range<1>((size_t) G), [=](sycl::id<1> i) {
+        const int64_t g = (int64_t) i[0];
+        ap[g] = xh + g * K;
+        bp[g] = w + g * N * K;
+        cp[g] = dd + g * sc;
+    });
+    oneapi::mkl::transpose ta = oneapi::mkl::transpose::nontrans, tb = oneapi::mkl::transpose::trans;
+    int64_t m_ = ncols, n_ = N, k_ = K, la = G * K, lb = K, lc = ldc, gs = G;
+    float al = 1.0f, be = 0.0f;
+    try {
+        oneapi::mkl::blas::row_major::gemm_batch(*st, &ta, &tb, &m_, &n_, &k_, &al, ap, &la, bp, &lb, &be, cp, &lc, (int64_t) 1, &gs);
+    } catch (const std::exception & e) {   // one gemm a slice
+        static bool said = false;
+        if (!said) { said = true; GGML_LOG_WARN("larry_slices_batched: pointer gemm_batch failed (%s) - a gemm a slice\n", e.what()); }
+        for (int64_t g = 0; g < G; ++g)
+            oneapi::mkl::blas::row_major::gemm(*st, oneapi::mkl::transpose::nontrans, oneapi::mkl::transpose::trans, ncols, N, K, 1.0f,
+                                               xh + g * K, G * K, w + g * N * K, K, 0.0f, dd + g * sc, ldc);
+    }
+}
+
+// prompt chunks against a per-slice planar Q6_K weight: per slice, W (f16) and the slice's columns (f16), one GEMM
+static bool larry_slices_gemm(ggml_backend_sycl_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32 || src1->ne[3] != 1 || dst->ne[3] != 1) return false;
+    const int64_t K = src0->ne[0], N = src0->ne[1], ncols = src1->ne[1], G = src1->ne[2];
+    if (src1->ne[0] != K || G % src0->ne[2] || dst->ne[0] != N || dst->ne[1] != ncols || dst->ne[2] != G) return false;
+    if (src1->nb[0] != 4 || dst->nb[0] != 4) return false;
+    dpct::queue_ptr st = ctx.stream();
+    // larry, patch-slicesbatch.py: every slice in one gemm_batch when src1's memory is a contiguous [ncols][G][K]
+    static const int batched = ggml_sycl_get_env("GGML_SYCL_LARRY_SLICES_BATCH", 0);
+    if (batched && G == src0->ne[2] && src1->nb[2] == (size_t) K * 4 && src1->nb[1] == (size_t) (G * K) * 4 &&
+        dst->nb[1] % 4 == 0 && dst->nb[2] % 4 == 0) {
+        // dst slice g, row-major [ncols][N] (ld nb1 / 4, slices nb2 / 4 apart)
+        larry_slices_batched(ctx, (const char *) src0->data, src0->nb[2], N, K, G, (const float *) src1->data, ncols,
+                             (float *) dst->data, (int64_t) (dst->nb[1] / 4), (int64_t) (dst->nb[2] / 4));
+        return true;
+    }
+    ggml_sycl_pool_alloc<sycl::half> xf(ctx.pool(), (size_t) ncols * K);
+    // only when the fp16 weight cache cannot hold the slice; declared after xf: the pool frees in stack order
+    ggml_sycl_pool_alloc<sycl::half> wf(ctx.pool());
+    const int64_t g_div = G / src0->ne[2];
+    const sycl::half * w = nullptr;
+    for (int64_t g = 0; g < G; ++g) {
+        if (g % g_div == 0) {
+            const char * sl = (const char *) src0->data + (g / g_div) * src0->nb[2];
+            w = larry_f16cache_core(sl, (size_t) (N * K), [&](sycl::half * y) { fastmv::dequant_q6k_planar_f16(*st, sl, N, K, y); }, st);
+            if (!w) {
+                if (!wf.get()) wf.alloc((size_t) N * K);
+                fastmv::dequant_q6k_planar_f16(*st, sl, N, K, wf.get());
+                w = wf.get();
+            }
+        }
+        fastmv::cols_to_f16(*st, (const float *) ((const char *) src1->data + g * src1->nb[2]), (int64_t) (src1->nb[1] / 4), ncols, K, xf.get());
+        // dst slice g, row-major [ncols][N] (ld = nb1 / 4) = X [ncols x K] . W^T
+        oneapi::mkl::blas::row_major::gemm(*st, oneapi::mkl::transpose::nontrans, oneapi::mkl::transpose::trans, ncols, N, K, 1.0f,
+                                           xf.get(), K, w, K, 0.0f,
+                                           (float *) ((char *) dst->data + g * dst->nb[2]), (int64_t) (dst->nb[1] / 4));
+    }
+    return true;
+}
+
+// larry: the int8 activations of the last Q6K_R8 mat-vec, per backend context - mat-vecs of one graph that share their
+// input (q_a / kv / the compressor and indexer projections read attn_norm(x); the shared expert's gate and up read
+// ffn_norm(h)) quantise it once (GGML_SYCL_LARRY_QREUSE, default 1).  A graph's tensors do not change once computed;
+// the cache dies with the graph (g_larry_graph_epoch), and in-order execution makes reusing its buffer safe.
+static ggml_sycl_larry_mv_hook_t g_larry_mv_hook = nullptr;
+static void * g_larry_mv_user = nullptr;
+static double g_larry_mv_mb = 0.0;
+void ggml_backend_sycl_set_mv_hook(ggml_sycl_larry_mv_hook_t fn, void * user, double min_mb) {
+    g_larry_mv_hook = fn; g_larry_mv_user = user; g_larry_mv_mb = min_mb;
+}
+static ggml_sycl_larry_oproj_hook_t g_larry_oproj_hook = nullptr;
+static void * g_larry_oproj_user = nullptr;
+void ggml_backend_sycl_set_oproj_hook(ggml_sycl_larry_oproj_hook_t fn, void * user) {
+    g_larry_oproj_hook = fn; g_larry_oproj_user = user;
+}
+
+struct larry_qcache {
+    const ggml_tensor * t = nullptr;
+    const void * data = nullptr;
+    int64_t K = 0, ncols = 0, G = 0, xc = 0, xb = 0;
+    uint64_t epoch = 0;
+    int8_t * xq = nullptr;
+    float * xd = nullptr;
+    size_t cap = 0;   // int8 elements
+};
+// four entries a context, replaced round-robin
+struct larry_qcache_set {
+    larry_qcache e[4];
+    int next = 0;
+};
+static std::unordered_map<const void *, larry_qcache_set> g_larry_qcache;
+static uint64_t g_larry_graph_epoch = 1;
+// larry: GGML_OP_DSV41_MVQ - the int8 activations its producer already wrote (quant_x's layout), for the one mat-vec
+// being queued: larry_fastmv's Q6K_R8 path takes them instead of quantising src1 again
+static const int8_t * g_larry_pre_xq = nullptr;
+static const float * g_larry_pre_xd = nullptr;
+
+static bool larry_fastmv(ggml_backend_sycl_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    static const int on = ggml_sycl_get_env("GGML_SYCL_LARRY_FASTMV", 1);
+    static const int f16_max_rows = ggml_sycl_get_env("GGML_SYCL_LARRY_FASTMV_F16_ROWS", 1 << 30);
+    static const int q6r8 = ggml_sycl_get_env("GGML_SYCL_LARRY_Q6R8", 1);
+    if (!on || (dst->op != GGML_OP_MUL_MAT && dst->op != GGML_OP_DSV41_MVQ)) return false;
+    if (!src0->buffer || ggml_backend_buffer_is_sycl_split(src0->buffer)) return false;
+    static const int woa = ggml_sycl_get_env("GGML_SYCL_LARRY_WOA", 1);
+    const bool slice_planar = src0->type == GGML_TYPE_Q6_K && g_larry_slice_planar.count(src0->data) != 0;
+    if (slice_planar && src1->ne[1] > 8) {   // a prompt chunk against a weight only this hook can read now
+        if (larry_slices_gemm(ctx, src0, src1, dst)) return true;
+        GGML_ABORT("larry_fastmv: per-slice planar Q6_K weight in an unsupported product");
+    }
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    const int64_t ncols = src1->ne[1];
+    if (ncols < 1 || ncols > 8 || src1->ne[3] != 1 || src0->ne[3] != 1 || dst->ne[3] != 1) return false;
+    if (src1->nb[0] != sizeof(float) || dst->nb[0] != sizeof(float) || src1->ne[0] != src0->ne[0]) return false;
+    const int64_t K = src0->ne[0], N = src0->ne[1], G = src1->ne[2];
+    if (src0->ne[2] < 1 || G % src0->ne[2] || dst->ne[0] != N || dst->ne[1] != ncols || dst->ne[2] != G) return false;
+    if (((uintptr_t) src1->data) % 16 || (src1->nb[1] / 4) % 4 || (src1->nb[2] / 4) % 4) return false;
+    fastmv::Args a;
+    fastmv::WType t;
+    if (src0->type == GGML_TYPE_F16) {
+        if (N > f16_max_rows || src0->nb[0] != 2 || src0->nb[1] != (size_t) K * 2 || K % 8) return false;
+        t = fastmv::WType::F16;
+        a.w_row_bytes = src0->nb[1];
+        a.w_batch_bytes = src0->nb[2];
+    } else if (src0->type == GGML_TYPE_F32) {   // the router (5120 x 384): oneMKL's GEMV otherwise
+        if (src0->nb[0] != 4 || src0->nb[1] != (size_t) K * 4 || K % 8) return false;
+        t = fastmv::WType::F32;
+        a.w_row_bytes = src0->nb[1];
+        a.w_batch_bytes = src0->nb[2];
+    } else if (src0->type == GGML_TYPE_Q6_K && src0->ne[2] == 1 && G == 1 && q6r8) {
+        // a 2-D Q6_K weight: ggml-sycl's lazy reorder (once per tensor; the prompt path reads that layout too), then
+        // fastmv's dp4a kernel against int8 activations (~1.7x ggml-sycl's ESIMD mat-vec at these shapes)
+        if (K % QK_K || src0->nb[0] != sizeof(block_q6_K) || src0->nb[1] != (size_t) (K / QK_K) * sizeof(block_q6_K)) return false;
+        opt_for_reorder(&ctx, src0, src1, dst, mul_mat_algo::DMMV);
+        const ggml_tensor_extra_gpu * extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+        if (!extra || !extra->optimized_feature.reorder) return false;
+        t = fastmv::WType::Q6K_R8;
+        a.n_blocks_total = N * (K / QK_K);
+        a.w_batch_bytes = 0;
+    } else if (src0->type == GGML_TYPE_Q6_K && src0->ne[2] > 1 && G > 1 && q6r8 && woa &&
+               (slice_planar || larry_slice_view_ok(src0))) {
+        // wo_a: reorder the parent per slice once (the first decode-shaped product, an eager run), then dp4a
+        if (!slice_planar) {
+            const ggml_tensor * par = src0->view_src ? src0->view_src : src0;
+            if (!reorder_qw_q6_k_moe((uint8_t *) par->data, src0->nb[2], src0->ne[2], ctx.stream())) return false;
+            g_larry_slice_planar.insert(src0->data);
+        }
+        t = fastmv::WType::Q6K_R8;
+        a.n_blocks_total = N * (K / QK_K);
+        a.w_batch_bytes = src0->nb[2];
+    } else if (src0->type == GGML_TYPE_Q6_K && src0->ne[2] > 1 && G > 1 && ncols == 1) {
+        // wo_a is a reshaped VIEW of a 2-D tensor: no extra of its own, never reordered by ggml-sycl (src1 is 3-D), and
+        // its prompt path reads the view's (absent) reorder flag - so it stays in the standard layout and is read as is.
+        if (K % QK_K || src0->nb[0] != sizeof(block_q6_K) || src0->nb[1] != (size_t) (K / QK_K) * sizeof(block_q6_K)) return false;
+        const ggml_tensor_extra_gpu * extra = static_cast<const ggml_tensor_extra_gpu *>(src0->extra);
+        if (extra && extra->optimized_feature.reorder) {
+            t = fastmv::WType::Q6K_R;             // a real 3-D tensor ggml-sycl reordered per slice
+            a.n_blocks_total = N * (K / QK_K);
+        } else {
+            t = fastmv::WType::Q6K;
+            a.w_row_bytes = src0->nb[1];
+        }
+        a.w_batch_bytes = src0->nb[2];
+    } else {
+        return false;
+    }
+    a.w = src0->data;
+    a.K = K; a.N = N; a.G = G; a.g_div = G / src0->ne[2];
+    a.x = (const float *) src1->data;
+    a.x_col_stride = (int64_t) (src1->nb[1] / 4); a.x_batch_stride = (int64_t) (src1->nb[2] / 4);
+    a.y = (float *) dst->data;
+    a.y_col_stride = (int64_t) (dst->nb[1] / 4); a.y_batch_stride = (int64_t) (dst->nb[2] / 4);
+    a.ncols = (int) ncols;
+    if (t == fastmv::WType::Q6K_R8 && g_larry_pre_xq) {   // DSV41_MVQ: the producer quantised x already
+        a.xq = g_larry_pre_xq;
+        a.xd = g_larry_pre_xd;
+        return fastmv::launch(*ctx.stream(), t, a);
+    }
+    if (t == fastmv::WType::Q6K_R8 && fastmv::xmx_wants(a)) {
+        // larry, GGML_SYCL_LARRY_XMXMV: XMX for the latency-bound verify shapes; the transposed activations are kept
+        // per graph like the int8 ones (same input = q_a / kv's attn_norm, quantised once)
+        struct xt_cache { const ggml_tensor * t = nullptr; const void * data = nullptr; int64_t K = 0, nc = 0, G = 0, xc = 0, xb = 0;
+                          uint64_t epoch = 0; sycl::half * xT = nullptr; float * xd = nullptr; size_t cap = 0; };
+        static std::unordered_map<const void *, std::array<xt_cache, 2>> cache;
+        static std::unordered_map<const void *, int> next;
+        auto & cs = cache[&ctx];
+        xt_cache * hit = nullptr;
+        for (auto & e : cs)
+            if (e.epoch == g_larry_graph_epoch && e.t == src1 && e.data == src1->data && e.K == K && e.nc == ncols && e.G == G &&
+                e.xc == a.x_col_stride && e.xb == a.x_batch_stride) { hit = &e; break; }
+        if (!hit) {
+            int & nx = next[&ctx];
+            hit = &cs[(size_t) nx];
+            nx = (nx + 1) % 2;
+            const size_t need = (size_t) (G * K * 8);
+            if (need > hit->cap) {   // grows a few times early on: queued kernels may still read the old buffer
+                ctx.stream()->wait();
+                if (hit->xT) { sycl::free(hit->xT, *ctx.stream()); sycl::free(hit->xd, *ctx.stream()); }
+                hit->cap = std::max<size_t>(need, (size_t) 8 * 8192);
+                hit->xT = sycl::malloc_device<sycl::half>(hit->cap, *ctx.stream());
+                hit->xd = sycl::malloc_device<float>(hit->cap / 32, *ctx.stream());
+                if (!hit->xT || !hit->xd) GGML_ABORT("larry_fastmv: xT cache allocation failed");
+            }
+            fastmv::quant_xT(*ctx.stream(), a.x, a.x_col_stride, a.x_batch_stride, (int) ncols, G, K, hit->xT, hit->xd);
+            hit->t = src1; hit->data = src1->data; hit->K = K; hit->nc = ncols; hit->G = G;
+            hit->xc = a.x_col_stride; hit->xb = a.x_batch_stride; hit->epoch = g_larry_graph_epoch;
+        }
+        static const int xchk = ggml_sycl_get_env("GGML_SYCL_LARRY_XMXMV_CHECK", 0);   // diagnostic: vs the dp4a path
+        if (xchk) {
+            const size_t ny = (size_t) (N * ncols * G);
+            ggml_sycl_pool_alloc<float> ty(ctx.pool(), ny);
+            fastmv::Args b = a;
+            b.y = ty.get(); b.y_col_stride = N; b.y_batch_stride = N * ncols;
+            if (!fastmv::launch_xmx(*ctx.stream(), b, hit->xT, hit->xd)) GGML_ABORT("xmx check: launch");
+            ggml_sycl_pool_alloc<int8_t> rq(ctx.pool(), (size_t) (G * ncols * K));
+            ggml_sycl_pool_alloc<float> rd(ctx.pool(), (size_t) (G * ncols * K / 32));
+            fastmv::quant_x(*ctx.stream(), a.x, a.x_col_stride, a.x_batch_stride, (int) ncols, G, K, rq.get(), rd.get());
+            fastmv::Args r = a;
+            r.xq = rq.get(); r.xd = rd.get();   // into dst
+            fastmv::launch(*ctx.stream(), t, r);
+            static int nchk = 0;
+            if (nchk < 40) {
+                ++nchk;
+                std::vector<float> va(ny), vb(ny);
+                ctx.stream()->wait();
+                for (int64_t g2 = 0; g2 < G; ++g2)
+                    for (int64_t c2 = 0; c2 < ncols; ++c2)
+                        ctx.stream()->memcpy(va.data() + (g2 * ncols + c2) * N, a.y + g2 * a.y_batch_stride + c2 * a.y_col_stride, N * 4);
+                ctx.stream()->memcpy(vb.data(), ty.get(), ny * 4).wait();
+                double md = 0, mx = 0;
+                for (size_t i = 0; i < ny; ++i) { md = std::max(md, (double) std::fabs(va[i] - vb[i])); mx = std::max(mx, (double) std::fabs(va[i])); }
+                GGML_LOG_INFO("larry xmx check %d: %s %lld x %lld x %d cols: max |diff| %.3e, max |dp4a| %.3e\n", nchk, dst->name,
+                              (long long) K, (long long) N, (int) ncols, md, mx);
+            }
+            return true;
+        }
