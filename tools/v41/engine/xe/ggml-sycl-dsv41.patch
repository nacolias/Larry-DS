+struct ggml_tensor * ggml_dsv41_oproj(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * o,
+        struct ggml_tensor  * wo_a,
+        struct ggml_tensor  * wo_b) {
+    GGML_ASSERT(o->type == GGML_TYPE_F32 && ggml_is_contiguous(o));
+    const int64_t OGD = wo_a->ne[0], OL = wo_a->ne[1], OG = wo_a->ne[2];
+    GGML_ASSERT(wo_b->ne[0] == OL * OG && ggml_nelements(o) % (OGD * OG) == 0);
+    const int64_t n = ggml_nelements(o) / (OGD * OG);
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, wo_b->ne[1], n);
+    result->op     = GGML_OP_DSV41_OPROJ;
+    result->src[0] = o;
+    result->src[1] = wo_a;
+    result->src[2] = wo_b;
+    return result;
+}
+
+// larry: wo_a alone, in wo_b's input layout (GGML_OP_DSV41_OPROJ with op_params[0] = 1, no wo_b)
+struct ggml_tensor * ggml_dsv41_oproj_a(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * o,
+        struct ggml_tensor  * wo_a) {
+    GGML_ASSERT((o->type == GGML_TYPE_F32 || o->type == GGML_TYPE_F16) && ggml_is_contiguous(o));   // (F16: patch-sdpao16.py)
+    const int64_t OGD = wo_a->ne[0], OL = wo_a->ne[1], OG = wo_a->ne[2];
+    GGML_ASSERT(ggml_nelements(o) % (OGD * OG) == 0);
+    const int64_t n = ggml_nelements(o) / (OGD * OG);
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, OL * OG, n);
+    ggml_set_op_params_i32(result, 0, 1);
+    result->op     = GGML_OP_DSV41_OPROJ;
+    result->src[0] = o;
+    result->src[1] = wo_a;
+    return result;
+}
+
+static void ggml_dsv41_set_rope(struct ggml_tensor * t, int i0, struct ggml_dsv41_rope r) {
+    ggml_set_op_params_i32(t, i0 + 0, r.n_dims);
+    ggml_set_op_params_i32(t, i0 + 1, r.n_ctx_orig);
+    ggml_set_op_params_f32(t, i0 + 2, r.freq_base);
+    ggml_set_op_params_f32(t, i0 + 3, r.freq_scale);
+    ggml_set_op_params_f32(t, i0 + 4, r.ext_factor);
+    ggml_set_op_params_f32(t, i0 + 5, r.attn_factor);
+    ggml_set_op_params_f32(t, i0 + 6, r.beta_fast);
+    ggml_set_op_params_f32(t, i0 + 7, r.beta_slow);
+}
