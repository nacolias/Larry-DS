+// ---- larry: DeepSeek-V4.1's hyper-connection steps fused for decode widths.  Per layer the composite was ~14 tiny
+// kernels (hc_post, norm_mv, hc_mixes, hc_comb, hc_pre, rms_norm+mul for each sub-layer; add, hc_post, cpy for the
+// finish); these are 5.  hc == 4.
+
+// GGML_OP_DSV41_HC_POST2: one work-item per (token, 4 columns), all hc outputs: (a + b) * post[d] + sum_s res[s] * comb[d, s]
+void ggml_sycl_op_dsv41_hc_post2(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/5);
+    const ggml_tensor * a = dst->src[0], * b = dst->src[1], * res = dst->src[2], * post = dst->src[3], * comb = dst->src[4];
+    constexpr int HC = 4;
+    const int64_t D = a->ne[0], n = a->ne[1];
+    GGML_ASSERT(res->ne[1] == HC && D % 4 == 0);
+    const float * pa = (const float *) a->data;
+    const float * pb = b ? (const float *) b->data : nullptr;
+    const float * pr = (const float *) res->data;
+    const float * pp = (const float *) post->data;
+    const float * pc = (const float *) comb->data;
+    float * pd = (float *) dst->data;
+    const int64_t as1 = a->nb[1] / 4, bs1 = b ? b->nb[1] / 4 : 0, rs1 = res->nb[1] / 4, rs2 = res->nb[2] / 4;
+    const int64_t ps1 = post->nb[1] / 4, cs1 = comb->nb[1] / 4, cs2 = comb->nb[2] / 4, ds1 = dst->nb[1] / 4, ds2 = dst->nb[2] / 4;
+    const int64_t nq = D / 4;
+    ctx.stream()->parallel_for(sycl::range<1>((size_t) (n * nq)), [=](sycl::id<1> id) {
+        const int64_t i = ((int64_t) id[0] % nq) * 4, t = (int64_t) id[0] / nq;
+        sycl::float4 x = *(const sycl::float4 *) (pa + t * as1 + i);
+        if (pb) x += *(const sycl::float4 *) (pb + t * bs1 + i);
+        sycl::float4 r[HC];
+#pragma unroll
+        for (int s = 0; s < HC; ++s) r[s] = *(const sycl::float4 *) (pr + t * rs2 + s * rs1 + i);
+        const float * po = pp + t * ps1;
+        const float * co = pc + t * cs2;
+#pragma unroll
+        for (int d = 0; d < HC; ++d) {
+            sycl::float4 o = x * po[d];
+#pragma unroll
+            for (int s = 0; s < HC; ++s) o += r[s] * co[d + s * cs1];
+            *(sycl::float4 *) (pd + t * ds2 + d * ds1 + i) = o;
+        }
+    });
+}
+
+namespace {
+
+// GGML_OP_DSV41_HC_FA: one sub-group per (token, 128-column chunk, group of 6 mixes rows); a lane takes 8 columns of
+// every hc row: h (hc_post, or x itself), z = hc_pre(h, pre), then the 6 rows' fn . h (16-byte weight loads).  Row
+// group 0 also writes h and z and the chunk's sums of h^2 and z^2.  No SLM, no barriers.
+template <bool W16, bool POST>
+void hc_fa_sycl(sycl::queue * q, const float * x, int64_t xs1, int64_t xs2, const void * fn, int64_t fs1,
+                const float * pre, int64_t ps1, const float * y, int64_t ys1, const float * post, int64_t pos1,
+                const float * comb, int64_t cs1, int64_t cs2, float * out, int64_t D, int64_t n) {
+    constexpr int HC = 4, NR = 24, NRG = 4, RPG = NR / NRG, IPL = 8, SG = 16, NV = 32;
+    const int64_t nch = D / (SG * IPL);
+    float * oh = out;
+    float * oz = out + n * HC * D;
+    float * op = oz + n * D;
+    q->parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) (n * nch * NRG * SG)), sycl::range<1>(SG)),
+                    [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+        const int64_t g = (int64_t) it.get_group(0);
+        const int rg = (int) (g % NRG);
+        const int64_t ch = (g / NRG) % nch, t = g / (NRG * nch);
+        const int lane = (int) it.get_local_id(0);
+        const int64_t i0 = ch * (SG * IPL) + lane * IPL;
+        float h[HC][IPL];
+        const float * xt = x + t * xs2 + i0;
+#pragma unroll
+        for (int s = 0; s < HC; ++s) {
+            const sycl::float4 va = *(const sycl::float4 *) (xt + s * xs1), vb = *(const sycl::float4 *) (xt + s * xs1 + 4);
+            h[s][0] = va.x(); h[s][1] = va.y(); h[s][2] = va.z(); h[s][3] = va.w();
+            h[s][4] = vb.x(); h[s][5] = vb.y(); h[s][6] = vb.z(); h[s][7] = vb.w();
+        }
+        if constexpr (POST) {
+            float xr[HC][IPL];
+#pragma unroll
+            for (int s = 0; s < HC; ++s)
+#pragma unroll
+                for (int j = 0; j < IPL; ++j) xr[s][j] = h[s][j];
+            const sycl::float4 ya = *(const sycl::float4 *) (y + t * ys1 + i0), yb = *(const sycl::float4 *) (y + t * ys1 + i0 + 4);
+            const float yv[IPL] = { ya.x(), ya.y(), ya.z(), ya.w(), yb.x(), yb.y(), yb.z(), yb.w() };
+            const float * pp = post + t * pos1;
+            const float * cc = comb + t * cs2;
+#pragma unroll
+            for (int d = 0; d < HC; ++d) {
+                const float pd = pp[d];
+                float cd[HC];
+#pragma unroll
+                for (int s = 0; s < HC; ++s) cd[s] = cc[d + s * cs1];
+#pragma unroll
+                for (int j = 0; j < IPL; ++j) {
+                    float v = yv[j] * pd;
+#pragma unroll
+                    for (int s = 0; s < HC; ++s) v += xr[s][j] * cd[s];
+                    h[d][j] = v;
+                }
+            }
+        }
+        const float * pw = pre + t * ps1;
+        const float p0 = pw[0], p1 = pw[1], p2 = pw[2], p3 = pw[3];
+        float z[IPL];
+#pragma unroll
+        for (int j = 0; j < IPL; ++j) {
+            float v = h[0][j] * p0;
+            v += h[1][j] * p1;
+            v += h[2][j] * p2;
+            v += h[3][j] * p3;
+            z[j] = v;
+        }
+        const sycl::sub_group sg = it.get_sub_group();
+        float * P = op + (t * nch + ch) * NV;
+        if (rg == 0) {
+            if constexpr (POST) {
+#pragma unroll
+                for (int d = 0; d < HC; ++d) {
+                    float * o = oh + t * HC * D + d * D + i0;
+                    *(sycl::float4 *) o = sycl::float4(h[d][0], h[d][1], h[d][2], h[d][3]);
+                    *(sycl::float4 *) (o + 4) = sycl::float4(h[d][4], h[d][5], h[d][6], h[d][7]);
+                }
+            }
+            *(sycl::float4 *) (oz + t * D + i0) = sycl::float4(z[0], z[1], z[2], z[3]);
+            *(sycl::float4 *) (oz + t * D + i0 + 4) = sycl::float4(z[4], z[5], z[6], z[7]);
+            float sh = 0.0f, sz = 0.0f;
+#pragma unroll
+            for (int j = 0; j < IPL; ++j) {
+#pragma unroll
+                for (int d = 0; d < HC; ++d) sh += h[d][j] * h[d][j];
+                sz += z[j] * z[j];
+            }
+            sh = sycl::reduce_over_group(sg, sh, sycl::plus<float>());
+            sz = sycl::reduce_over_group(sg, sz, sycl::plus<float>());
+            if (lane == 0) { P[NR] = sh; P[NR + 1] = sz; }
+        }
+        float acc[RPG];
+#pragma unroll
+        for (int rr = 0; rr < RPG; ++rr) {
+            const int64_t r = rg * RPG + rr;
+            float a = 0.0f;
+#pragma unroll
+            for (int d = 0; d < HC; ++d) {
+                float wv[IPL];
+                if constexpr (W16) {
+                    const sycl::vec<sycl::half, 8> hv = *(const sycl::vec<sycl::half, 8> *) ((const sycl::half *) fn + r * fs1 + d * D + i0);
+#pragma unroll
+                    for (int j = 0; j < IPL; ++j) wv[j] = (float) hv[j];
+                } else {
+                    const float * wr = (const float *) fn + r * fs1 + d * D + i0;
+                    const sycl::float4 wa = *(const sycl::float4 *) wr, wb = *(const sycl::float4 *) (wr + 4);
+                    wv[0] = wa.x(); wv[1] = wa.y(); wv[2] = wa.z(); wv[3] = wa.w();
+                    wv[4] = wb.x(); wv[5] = wb.y(); wv[6] = wb.z(); wv[7] = wb.w();
+                }
+#pragma unroll
+                for (int j = 0; j < IPL; ++j) a += wv[j] * h[d][j];
+            }
+            acc[rr] = a;
+        }
+#pragma unroll
+        for (int rr = 0; rr < RPG; ++rr) acc[rr] = sycl::reduce_over_group(sg, acc[rr], sycl::plus<float>());
+        if (lane == 0) {
+#pragma unroll
+            for (int rr = 0; rr < RPG; ++rr) P[rg * RPG + rr] = acc[rr];
+        }
+    });
+}
+
+}  // namespace
+
+void ggml_sycl_op_dsv41_hc_fa(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/6);
+    const ggml_tensor * x = dst->src[0], * fn = dst->src[1], * pre = dst->src[2];
+    const ggml_tensor * y = dst->src[3], * post = dst->src[4], * comb = dst->src[5];
+    const int64_t D = ggml_get_op_params_i32(dst, 0), hc = ggml_get_op_params_i32(dst, 1), n = ggml_get_op_params_i32(dst, 2);
+    GGML_ASSERT(hc == 4 && D % 128 == 0 && fn->ne[1] == 24);
+    const bool w16 = fn->type == GGML_TYPE_F16;
+    const int64_t fs1 = fn->nb[1] / ggml_type_size(fn->type);
+    const float * px = (const float *) x->data;
+    const int64_t xs1 = x->nb[1] / 4, xs2 = x->nb[2] / 4, ps1 = pre->nb[1] / 4;
+    const float * pp = (const float *) pre->data;
+    float * out = (float *) dst->data;
+    sycl::queue * q = ctx.stream();
+    if (y) {
+        const float * py = (const float *) y->data;
+        const float * po = (const float *) post->data;
+        const float * pc = (const float *) comb->data;
+        const int64_t ys1 = y->nb[1] / 4, pos1 = post->nb[1] / 4, cs1 = comb->nb[1] / 4, cs2 = comb->nb[2] / 4;
+        if (w16) hc_fa_sycl<true, true>(q, px, xs1, xs2, fn->data, fs1, pp, ps1, py, ys1, po, pos1, pc, cs1, cs2, out, D, n);
+        else     hc_fa_sycl<false, true>(q, px, xs1, xs2, fn->data, fs1, pp, ps1, py, ys1, po, pos1, pc, cs1, cs2, out, D, n);
+    } else {
+        if (w16) hc_fa_sycl<true, false>(q, px, xs1, xs2, fn->data, fs1, pp, ps1, nullptr, 0, nullptr, 0, nullptr, 0, 0, out, D, n);
+        else     hc_fa_sycl<false, false>(q, px, xs1, xs2, fn->data, fs1, pp, ps1, nullptr, 0, nullptr, 0, nullptr, 0, 0, out, D, n);
+    }
+}
+
+// GGML_OP_DSV41_HC_FB: (token, 1024-column block) work-groups of 256.  Each sums the token's chunk partials (8 lanes a
+// value over every 8th chunk, then those 8 in a fixed order) and writes its block of xn = z * rsqrt(mean z^2 + eps) * w;
+// block 0's first sub-group then the mixes: pre / post on lanes 0-7 and the comb Sinkhorn with one matrix entry a
+// lane (lane = dst + 4 src; a column's / row's sum by sub-group xor shuffles).
+void ggml_sycl_op_dsv41_hc_fb(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/4);
+    const ggml_tensor * fa = dst->src[0];
+    const int64_t D = ggml_get_op_params_i32(dst, 0), hc = ggml_get_op_params_i32(dst, 1), n = ggml_get_op_params_i32(dst, 2);
+    const float eps = ggml_get_op_params_f32(dst, 3), hc_eps = ggml_get_op_params_f32(dst, 4);
+    const int n_iter = ggml_get_op_params_i32(dst, 5);
+    constexpr int HC = 4, NR = 24, WG = 256, NV = 32, NCG = WG / NV;
+    GGML_ASSERT(hc == HC && D % 4 == 0);
+    const int64_t nch = D / 128, nb = (D + 4 * WG - 1) / (4 * WG);
+    const float * fz = (const float *) fa->data + n * HC * D;
+    const float * fp = fz + n * D;
+    const float * sc = (const float *) dst->src[1]->data;
+    const float * bs = (const float *) dst->src[2]->data;
+    const float * pw = (const float *) dst->src[3]->data;
+    float * oxn = (float *) dst->data;
+    float * opre = oxn + n * D;
+    float * opost = opre + n * HC;
+    float * ocomb = opost + n * HC;
+    ctx.stream()->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> part(sycl::range<1>(WG), h), tot(sycl::range<1>(NV), h);
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) (n * nb * WG)), sycl::range<1>(WG)),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+            const int64_t g = (int64_t) it.get_group(0), t = g / nb, blk = g % nb;
+            const int l = (int) it.get_local_id(0);
+            const int v = l % NV, cg = l / NV;
+            float s = 0.0f;
+            if (v < NR + 2)
+                for (int64_t c = cg; c < nch; c += NCG) s += fp[(t * nch + c) * NV + v];
+            part[l] = s;
+            it.barrier(sycl::access::fence_space::local_space);
+            if (l < NV) {
+                float a = 0.0f;
+#pragma unroll
+                for (int k = 0; k < NCG; ++k) a += part[k * NV + l];
+                tot[l] = a;
+            }
+            it.barrier(sycl::access::fence_space::local_space);
+            const float rz = sycl::rsqrt(tot[NR + 1] / (float) D + eps);
+            const int64_t i = blk * 4 * WG + (int64_t) l * 4;
+            if (i < D) {
+                const sycl::float4 zv = *(const sycl::float4 *) (fz + t * D + i);
+                const sycl::float4 wv = *(const sycl::float4 *) (pw + i);
+                *(sycl::float4 *) (oxn + t * D + i) = zv * rz * wv;
+            }
+            if (blk == 0 && l < 16) {   // the whole first sub-group: its shuffles below are convergent
+                const sycl::sub_group sg = it.get_sub_group();
+                const float rh = sycl::rsqrt(tot[NR] / (float) (HC * D) + eps);
+                if (l < 2 * HC) {
+                    const bool is_post = l >= HC;
+                    const float m = tot[l] * rh * sc[is_post ? 1 : 0] + bs[l];
+                    const float sgm = 1.0f / (1.0f + sycl::exp(-m));
+                    if (is_post) opost[t * HC + (l - HC)] = 2.0f * sgm;
+                    else opre[t * HC + l] = sgm + hc_eps;
+                }
+                float c = tot[2 * HC + l] * rh * sc[2] + bs[2 * HC + l];
+                // per src (lanes 4 src .. 4 src + 3): softmax over dst, + eps
+                float mx = sycl::fmax(c, sycl::permute_group_by_xor(sg, c, 1));
+                mx = sycl::fmax(mx, sycl::permute_group_by_xor(sg, mx, 2));
+                c = sycl::exp(c - mx);
+                float sm = c + sycl::permute_group_by_xor(sg, c, 1);
+                sm += sycl::permute_group_by_xor(sg, sm, 2);
+                c = c * (1.0f / sm) + hc_eps;
+                // columns: per dst over src (xor 4, 8); rows: per src over dst (xor 1, 2)
+                float cs = c + sycl::permute_group_by_xor(sg, c, 4);
+                cs += sycl::permute_group_by_xor(sg, cs, 8);
+                c *= 1.0f / (cs + hc_eps);
+                for (int k = 1; k < n_iter; ++k) {
+                    float rs = c + sycl::permute_group_by_xor(sg, c, 1);
+                    rs += sycl::permute_group_by_xor(sg, rs, 2);
+                    c *= 1.0f / (rs + hc_eps);
+                    cs = c + sycl::permute_group_by_xor(sg, c, 4);
+                    cs += sycl::permute_group_by_xor(sg, cs, 8);
+                    c *= 1.0f / (cs + hc_eps);
+                }
+                ocomb[t * HC * HC + l] = c;
+            }
+        });
+    });
+}
