+        int   n_ctx_orig;
+        float freq_base, freq_scale, ext_factor, attn_factor, beta_fast, beta_slow;
+    };
+    // larry: DeepSeek-V4.1's window row at decode widths (ggml-sycl only): y = rms_norm(x) * w, the RoPE at pos, the FP8
+    // activation rounding when fq (FP8 E4M3, 32-value blocks, power-of-two scales; ds41_ops.hpp FP8_POW2_32), and the
+    // last nslot = ggml_nelements(slot) columns also written into ring rows slot[] (the window ring).  x F32 [512, n]
+    // (rows contiguous), w F32 [512], pos I32 [n], ring F32 [512, R], slot I32.  Result F32 1-D: y [512, n], then the
+    // pass's RoPE table [rope.n_dims, n] (per query and rotated pair: cos, sin) - what ggml_dsv41_attn_dec and
+    // ggml_dsv41_li_dec rotate with (the same positions and angles).
+    GGML_API struct ggml_tensor * ggml_dsv41_kv_fin(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * w,
+            struct ggml_tensor  * pos,
+            struct ggml_tensor  * ring,
+            struct ggml_tensor  * slot,
+            float                 eps,
+            struct ggml_dsv41_rope rope,
+            bool                  fq);
+    // larry: DeepSeek-V4.1's decode / verify attention (< 8 queries, ggml-sycl only) in one op: per query t its swa
+    // window keys - row widx[t * swa + j] of [ring (R rows) | rows (this pass's)] - masked by wmask, then its K
+    // compressed keys - row sel[i, t] of comp (F32 / F16 / BF16) - masked by selm (comp, sel, selm all set or none);
+    // K = V, MQA.  q is RoPE'd (forward) on the way in by tab (ggml_dsv41_kv_fin's table [n_dims, n]: the last n_dims
+    // of each head), the output RoPE'd back; sinks [NH] one logit per head.
+    // q F32 [512, NH, n] contiguous, ring F32 [512, R], rows F32 [512, n], widx I32 [swa * n], wmask F32 [swa, n],
+    // sel I32 [K, n], selm F32 [K, n] (any column strides).  Result F32 [512, NH, n].  NH % 32 == 0, swa + K <= 2048.
+    GGML_API struct ggml_tensor * ggml_dsv41_attn_dec(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * q,
+            struct ggml_tensor  * ring,
+            struct ggml_tensor  * rows,
+            struct ggml_tensor  * widx,
+            struct ggml_tensor  * wmask,
+            struct ggml_tensor  * comp,
+            struct ggml_tensor  * sel,
+            struct ggml_tensor  * selm,
+            struct ggml_tensor  * sinks,
+            struct ggml_tensor  * tab,
+            int                   swa,
+            float                 scale,
+            int                   n_dims);
+
+    // ---- larry: int8 activations straight from the op that produces them (fastmv's quant_x layout, "q8"): rows
+    // r = g * n + t (batch-major) of K int8 values each (round(x * 127 / amax) per 32-value block), then the rows' block
+    // scales (amax / 127) as f32.  A producer writes them next to its f32 result; ggml_dsv41_mvq reads them instead of
+    // quantising its input again (one kernel less a product).
+    // ggml_dsv41_mvq: ggml_mul_mat(w, x) where x8 holds x's q8 form (an F32-typed view of the bytes; ggml-sycl's fastmv
+    // takes it for a Q6_K weight - other weights read x itself)
+    GGML_API struct ggml_tensor * ggml_dsv41_mvq(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * w,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * x8);
+    // ggml_dsv41_rms_q8: y = rms_norm(x) * w and y's q8.  x F32 [K, n] (rows contiguous), w F32 [K], K % 32 == 0.
+    // Result F32 1-D: y [K, n] | q8 (ggml_dsv41_q8_floats(K, n) floats)
+    GGML_API struct ggml_tensor * ggml_dsv41_rms_q8(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * w,
+            float                 eps);
+    // the q8 form's size in floats (K int8 + K / 32 f32 a row, rows = n)
+    GGML_API int64_t ggml_dsv41_q8_floats(int64_t K, int64_t n);
+    // ggml_dsv41_hc_fb with xn's q8 appended: xn | pre | post | comb | q8(xn)
+    GGML_API struct ggml_tensor * ggml_dsv41_hc_fb_q8(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * fa,
+            struct ggml_tensor  * scale,
+            struct ggml_tensor  * base,
+            struct ggml_tensor  * w,
+            float                 eps,
+            float                 hc_eps,
+            int                   n_iter);
+    // ggml_dsv41_swiglu_lim with the result's q8 appended: out [N, n] | q8(out).  F32 1-D.
+    GGML_API struct ggml_tensor * ggml_dsv41_swiglu_q8(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * y,
+            float                 lim);
+    // ggml_dsv41_attn_dec with the output's q8 for the grouped output projection appended: o [512, NH, n] | q8 of the
+    // OG = NH / hpg head groups as batches (row g * n + t holds query t's heads hpg g .. hpg g + hpg - 1).  F32 1-D.
+    GGML_API struct ggml_tensor * ggml_dsv41_attn_dec_q8(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * q,
+            struct ggml_tensor  * ring,
+            struct ggml_tensor  * rows,
+            struct ggml_tensor  * widx,
+            struct ggml_tensor  * wmask,
+            struct ggml_tensor  * comp,
+            struct ggml_tensor  * sel,
+            struct ggml_tensor  * selm,
+            struct ggml_tensor  * sinks,
+            struct ggml_tensor  * tab,
+            int                   swa,
+            float                 scale,
+            int                   n_dims,
+            int                   hpg);
+    // ggml_dsv41_mvq writing into out (a contiguous F32 [N, n] view, e.g. a persistent tensor's columns): the result is
+    // a view of out, as ggml_cpy's - no copy after the product
+    GGML_API struct ggml_tensor * ggml_dsv41_mvq_into(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * w,
+            struct ggml_tensor  * x,
+            struct ggml_tensor  * x8,
+            struct ggml_tensor  * out);
+    // larry: run a ggml_dsv41_hc_fb(_q8) and its ggml_dsv41_hc_fa (fb->src[0]) as ONE kernel (ggml-sycl: the hc_fa node
+    // computes nothing, the hc_fb node both; hc_fa's result must not be read before hc_fb has run).  Returns fb.
+    GGML_API struct ggml_tensor * ggml_dsv41_hc_merge(
+            struct ggml_tensor  * fb);
+    // larry: a fused decode op also writes its outputs straight into (persistent) tensors - the copies after it go:
+    //   ggml_dsv41_router       d0 = ids I32 [k, n], d1 = weights F32 [k, n]
+    //   ggml_dsv41_hc_fa (y)    d0 = h F32 [D, hc, n]
+    //   ggml_dsv41_hc_fb(_q8)   d0 = xn [D, n], d1 = pre [hc, n], d2 = post [hc, n], d3 = comb [hc, hc, n], d4 = q8(xn)
+    // (rows contiguous, columns contiguous; NULL: not written).  Returns op.
+    GGML_API struct ggml_tensor * ggml_dsv41_write_to(
+            struct ggml_tensor  * op,
+            struct ggml_tensor  * d0,
+            struct ggml_tensor  * d1,
+            struct ggml_tensor  * d2,
+            struct ggml_tensor  * d3,
+            struct ggml_tensor  * d4);
+    // larry: DeepSeek-V4.1's lightning indexer at decode widths (< 8 queries, ggml-sycl only) from the raw products: q F32
+    // [128, 32, n] (the indexer's q_b product: RoPE'd by tab (ggml_dsv41_kv_fin's) on the last n_dims, FP4-rounded when
+    // fq, here), keys BF16
+    // [128, NKV] (rows nb[1] apart, NKV % 8 == 0), w F32 [32, n] (the proj product, times wscale here), nvis F32 [n] (rows
+    // i < nvis visible), cand I32 [ncb, n] (NULL, or: only rows of these 8-row blocks score), lastblk F32 [n] (NULL, or:
