+// GGML_OP_DSV41_KGATHER (larry): query t's window rows (win at widx) then its compressed rows (comp at sel), each
+// converted to f16 once - one work-item per 8 values of an output row (16-byte loads and stores)
+void ggml_sycl_op_dsv41_kgather(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/4);
+    const ggml_tensor * win = dst->src[0];
+    const ggml_tensor * widx = dst->src[1];
+    const ggml_tensor * comp = dst->src[2];
+    const ggml_tensor * sel = dst->src[3];
+    const int64_t DH = dst->ne[0], M = dst->ne[1], n = dst->ne[3];
+    const int64_t SWA = ggml_get_op_params_i32(dst, 0);
+    GGML_ASSERT(DH % 8 == 0 && win->type == GGML_TYPE_F32 && ggml_is_contiguous(dst));
+    GGML_ASSERT(dst->type == GGML_TYPE_F16 || dst->type == GGML_TYPE_F32);
+    const bool out32 = dst->type == GGML_TYPE_F32;
+    float * po32 = (float *) dst->data;
+    GGML_ASSERT(win->nb[1] % 16 == 0 && (!comp || comp->nb[1] % 16 == 0));
+    const char * pw = (const char *) win->data;
+    const size_t wnb = win->nb[1];
+    const int32_t * pwi = (const int32_t *) widx->data;
+    const char * pc = comp ? (const char *) comp->data : nullptr;
+    const size_t cnb = comp ? comp->nb[1] : 0;
+    const int ct = !comp ? 0 : comp->type == GGML_TYPE_BF16 ? 1 : comp->type == GGML_TYPE_F16 ? 2 : 0;
+    const char * ps = sel ? (const char *) sel->data : nullptr;
+    const size_t snb = sel ? sel->nb[1] : 0;
+    sycl::half * po = (sycl::half *) dst->data;
+    const int64_t V = DH / 8;
+    const size_t total = (size_t) n * M * V;
+    ctx.stream()->parallel_for(sycl::range<1>(total), [=](sycl::id<1> id) {
+        const size_t i = id[0];
+        const int64_t v = (int64_t) (i % V), row = (int64_t) (i / V), m = row % M, t = row / M;
+        float f[8];
+        if (m < SWA) {
+            const float * s = (const float *) (pw + (size_t) pwi[t * SWA + m] * wnb) + v * 8;
+            const sycl::float4 a = *(const sycl::float4 *) s, b = *(const sycl::float4 *) (s + 4);
+            f[0] = a.x(); f[1] = a.y(); f[2] = a.z(); f[3] = a.w(); f[4] = b.x(); f[5] = b.y(); f[6] = b.z(); f[7] = b.w();
+        } else {
+            const int32_t r = *(const int32_t *) (ps + (size_t) t * snb + (size_t) (m - SWA) * 4);
+            const char * s = pc + (size_t) r * cnb;
+            if (ct == 1) {
+                const sycl::uint4 u = *(const sycl::uint4 *) (s + v * 16);
+                const uint32_t w[4] = { u.x(), u.y(), u.z(), u.w() };
+#pragma unroll
+                for (int j = 0; j < 4; ++j) { f[2 * j] = sycl::bit_cast<float>(w[j] << 16); f[2 * j + 1] = sycl::bit_cast<float>(w[j] & 0xffff0000u); }
+            } else if (ct == 2) {
+                const sycl::vec<sycl::half, 8> hv = *(const sycl::vec<sycl::half, 8> *) (s + v * 16);
+#pragma unroll
+                for (int j = 0; j < 8; ++j) f[j] = (float) hv[j];
+            } else {
+                const float * sf = (const float *) s + v * 8;
+                const sycl::float4 a = *(const sycl::float4 *) sf, b = *(const sycl::float4 *) (sf + 4);
+                f[0] = a.x(); f[1] = a.y(); f[2] = a.z(); f[3] = a.w(); f[4] = b.x(); f[5] = b.y(); f[6] = b.z(); f[7] = b.w();
+            }
+        }
+        if (out32) {
+            float * of = po32 + (size_t) row * DH + v * 8;
+            *(sycl::float4 *) of = sycl::float4(f[0], f[1], f[2], f[3]);
+            *(sycl::float4 *) (of + 4) = sycl::float4(f[4], f[5], f[6], f[7]);
+            return;
+        }
+        sycl::vec<sycl::half, 8> o;
+#pragma unroll
+        for (int j = 0; j < 8; ++j) o[j] = (sycl::half) f[j];
+        *(sycl::vec<sycl::half, 8> *) (po + (size_t) row * DH + v * 8) = o;
+    });
+}
+
+// GGML_OP_DSV41_NORM_MV (larry): a work-group per (token, output row): its lanes walk the row 8 values at a time,
+// summing w . x and x . x together; out = dot * rsqrt(mean(x^2) + eps) (the norm folded out of the product)
+void ggml_sycl_op_dsv41_norm_mv(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/2);
+    const ggml_tensor * w = dst->src[0];
+    const ggml_tensor * x = dst->src[1];
+    const int64_t C = w->ne[0], R = w->ne[1], n = dst->ne[1];
+    GGML_ASSERT(C % 8 == 0 && x->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32);
+    const float eps = ggml_get_op_params_f32(dst, 0);
+    const bool w16 = w->type == GGML_TYPE_F16;
+    const void * pw = w->data;
+    const float * px = (const float *) x->data;
+    float * pd = (float *) dst->data;
+    constexpr int WG = 256;
+    ctx.stream()->submit([&](sycl::handler & h) {
+        sycl::local_accessor<float, 1> sd(sycl::range<1>(WG / 16), h), ss(sycl::range<1>(WG / 16), h);
+        h.parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) (n * R) * WG), sycl::range<1>(WG)),
+                       [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+            const int64_t g = (int64_t) it.get_group(0), r = g % R, t = g / R;
+            const int lid = (int) it.get_local_id(0);
+            const float * xt = px + t * C;
+            float dot = 0.0f, sq = 0.0f;
+            for (int64_t c = (int64_t) lid * 8; c < C; c += (int64_t) WG * 8) {
+                const sycl::float4 xa = *(const sycl::float4 *) (xt + c), xb = *(const sycl::float4 *) (xt + c + 4);
+                float wv[8];
+                if (w16) {
+                    const sycl::vec<sycl::half, 8> hv = *(const sycl::vec<sycl::half, 8> *) ((const sycl::half *) pw + r * C + c);
+#pragma unroll
+                    for (int j = 0; j < 8; ++j) wv[j] = (float) hv[j];
+                } else {
+                    const float * wr = (const float *) pw + r * C + c;
+                    const sycl::float4 wa = *(const sycl::float4 *) wr, wb = *(const sycl::float4 *) (wr + 4);
+                    wv[0] = wa.x(); wv[1] = wa.y(); wv[2] = wa.z(); wv[3] = wa.w(); wv[4] = wb.x(); wv[5] = wb.y(); wv[6] = wb.z(); wv[7] = wb.w();
+                }
+                const float xv[8] = { xa.x(), xa.y(), xa.z(), xa.w(), xb.x(), xb.y(), xb.z(), xb.w() };
+#pragma unroll
+                for (int j = 0; j < 8; ++j) { dot += wv[j] * xv[j]; sq += xv[j] * xv[j]; }
+            }
+            const sycl::sub_group sg = it.get_sub_group();
+            dot = sycl::reduce_over_group(sg, dot, sycl::plus<float>());
+            sq = sycl::reduce_over_group(sg, sq, sycl::plus<float>());
+            const int sgi = (int) sg.get_group_linear_id();
+            if (sg.get_local_linear_id() == 0) { sd[sgi] = dot; ss[sgi] = sq; }
+            it.barrier(sycl::access::fence_space::local_space);
+            if (lid == 0) {
+                float D = 0.0f, Q = 0.0f;
+                for (int k = 0; k < WG / 16; ++k) { D += sd[k]; Q += ss[k]; }
+                pd[t * R + r] = D * sycl::rsqrt(Q / (float) C + eps);
+            }
+        });
+    });
+}
+
+// GGML_OP_DSV41_SWIGLU_LIM (larry): out = silu(min(gate, lim)) * clamp(up, -lim, lim), one work-item an element
+// (op_silu / the clamp of ggml-sycl's own ops, the same arithmetic)
+void ggml_sycl_op_dsv41_swiglu_lim(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/1);
+    const ggml_tensor * y = dst->src[0];
+    const float lim = ggml_get_op_params_f32(dst, 0);
+    const float * py = (const float *) y->data;
+    float * pd = (float *) dst->data;
+    if (ggml_get_op_params_i32(dst, 1)) {
+        // larry, ggml_dsv41_swiglu_q8: one sub-group a 32-value block (2 values a lane), the same arithmetic per value,
+        // then the block's q8 (out [N, n] | q [n][N] | d [n][N / 32])
+        const int64_t N = ggml_get_op_params_i32(dst, 2), n = ggml_get_op_params_i32(dst, 3), nblk = N / 32;
+        int8_t * oq = (int8_t *) (pd + N * n);
+        float * od = (float *) (oq + N * n);
+        ctx.stream()->parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) (n * nblk * 16)), sycl::range<1>(16)),
+                                   [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(16)]] {
+            const int64_t g = (int64_t) it.get_group(0), t = g / nblk, bk = g % nblk;
+            const int lane = (int) it.get_local_id(0);
+            const int64_t i = bk * 32 + 2 * lane;
+            float o[2];
+#pragma unroll
+            for (int j = 0; j < 2; ++j) {
+                float gt = py[t * 2 * N + i + j], u = py[t * 2 * N + N + i + j];
+                if (lim > 0.0f) {
+                    gt = gt > lim ? lim : gt;
+                    u = u < -lim ? -lim : (u > lim ? lim : u);
+                }
+                o[j] = gt / (1.0f + sycl::exp(-gt)) * u;
+            }
+            *(sycl::float2 *) (pd + t * N + i) = sycl::float2(o[0], o[1]);
+            const float am = sycl::reduce_over_group(it.get_sub_group(), sycl::fmax(sycl::fabs(o[0]), sycl::fabs(o[1])), sycl::maximum<float>());
+            const float id = dsv41dec::q8_inv(am);
+            *(uint16_t *) (oq + t * N + i) = (uint16_t) (((int) sycl::rint(o[0] * id) & 0xFF) | (((int) sycl::rint(o[1] * id) & 0xFF) << 8));
+            if (lane == 0) od[t * nblk + bk] = am / 127.0f;
+        });
+        return;
+    }
+    const int64_t N = dst->ne[0], n = dst->ne[1];
+    ctx.stream()->parallel_for(sycl::range<1>((size_t) (N * n)), [=](sycl::id<1> id) {
+        const int64_t i = (int64_t) id[0] % N, t = (int64_t) id[0] / N;
+        float g = py[t * 2 * N + i], u = py[t * 2 * N + N + i];
+        if (lim > 0.0f) {
+            g = g > lim ? lim : g;
+            u = u < -lim ? -lim : (u > lim ? lim : u);
+        }
+        pd[t * N + i] = g / (1.0f + sycl::exp(-g)) * u;
+    });
+}
+
+// ---- larry: DeepSeek-V4.1's hyper-connection steps fused for decode widths.  Per layer the composite was ~14 tiny
+// kernels (hc_post, norm_mv, hc_mixes, hc_comb, hc_pre, rms_norm+mul for each sub-layer; add, hc_post, cpy for the
+// finish); these are 5.  hc == 4.
+
+// GGML_OP_DSV41_HC_POST2: one work-item per (token, 4 columns), all hc outputs: (a + b) * post[d] + sum_s res[s] * comb[d, s]
+void ggml_sycl_op_dsv41_hc_post2(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/5);
+    const ggml_tensor * a = dst->src[0], * b = dst->src[1], * res = dst->src[2], * post = dst->src[3], * comb = dst->src[4];
+    constexpr int HC = 4;
+    const int64_t D = a->ne[0], n = a->ne[1];
+    GGML_ASSERT(res->ne[1] == HC && D % 4 == 0);
+    const float * pa = (const float *) a->data;
+    const float * pb = b ? (const float *) b->data : nullptr;
+    const float * pr = (const float *) res->data;
+    const float * pp = (const float *) post->data;
+    const float * pc = (const float *) comb->data;
+    float * pd = (float *) dst->data;
+    const int64_t as1 = a->nb[1] / 4, bs1 = b ? b->nb[1] / 4 : 0, rs1 = res->nb[1] / 4, rs2 = res->nb[2] / 4;
+    const int64_t ps1 = post->nb[1] / 4, cs1 = comb->nb[1] / 4, cs2 = comb->nb[2] / 4, ds1 = dst->nb[1] / 4, ds2 = dst->nb[2] / 4;
+    const int64_t nq = D / 4;
+    ctx.stream()->parallel_for(sycl::range<1>((size_t) (n * nq)), [=](sycl::id<1> id) {
+        const int64_t i = ((int64_t) id[0] % nq) * 4, t = (int64_t) id[0] / nq;
+        sycl::float4 x = *(const sycl::float4 *) (pa + t * as1 + i);
+        if (pb) x += *(const sycl::float4 *) (pb + t * bs1 + i);
+        sycl::float4 r[HC];
+#pragma unroll
+        for (int s = 0; s < HC; ++s) r[s] = *(const sycl::float4 *) (pr + t * rs2 + s * rs1 + i);
+        const float * po = pp + t * ps1;
+        const float * co = pc + t * cs2;
+#pragma unroll
+        for (int d = 0; d < HC; ++d) {
+            sycl::float4 o = x * po[d];
+#pragma unroll
+            for (int s = 0; s < HC; ++s) o += r[s] * co[d + s * cs1];
+            *(sycl::float4 *) (pd + t * ds2 + d * ds1 + i) = o;
+        }
+    });
+}
