+    // allocations stay in the same order either way: the VMM pool frees in stack order)
+    ggml_sycl_pool_alloc<int8_t> xq(ctx.pool(), x8q ? (size_t) 1 : (size_t) (OG * n * OGD));
+    ggml_sycl_pool_alloc<float> xd(ctx.pool(), x8q ? (size_t) 1 : (size_t) (OG * n * OGD / 32));
+    ggml_sycl_pool_alloc<float> oa(ctx.pool(), (size_t) (KA * n));
+    ggml_sycl_pool_alloc<int8_t> aq(ctx.pool(), (size_t) (KA * n));
+    ggml_sycl_pool_alloc<float> ad(ctx.pool(), (size_t) (KA * n / 32));
+    if (!x8q) fastmv::quant_x(*st, x, OGD * OG, OGD, (int) n, OG, OGD, xq.get(), xd.get());
