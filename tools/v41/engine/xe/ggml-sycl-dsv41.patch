diff --git a/ggml/src/ggml-sycl/fattn-dsv4.cpp b/ggml/src/ggml-sycl/fattn-dsv4.cpp
new file mode 100644
index 000000000..e6522a680
--- /dev/null
+++ b/ggml/src/ggml-sycl/fattn-dsv4.cpp
@@ -0,0 +1,121 @@
+// ggml-sycl/fattn-dsv4.cpp - larry (Strata-DS4 on Intel): flash attention for DeepSeek-V4.1's prompt shape on XMX.
+//
+// The DS4 engines (Xolotl tools/v41/engine/ds41_dense.cpp) attend with the QUERY as the batch: every query has its
+// own key set (its 128-token window + its top-k compressed rows, padded to a multiple of 256), so one
+// GGML_OP_FLASH_ATTN_EXT has Q [D, 1, NH, n] f32 (64 heads, MQA), K = V [D, M, 1, n] f16, a mask [M, 1, 1, n] f16 and
+// attention sinks [NH] f32.  The TILE kernel does that at ~3.5 TFLOPS (18.6 ms for 512 queries at D 512, M 768); the
+// MKL and oneDNN paths refuse it (one query row per batch, sinks).  Here it is two strided batched oneMKL GEMMs in
+// fp16 with f32 results (XMX) around one softmax kernel:
+//   S_b = (scale * Q_b) . K_b^T     [NH x M] per query b
+//   P_b = softmax(S_b + mask_b) with the head's sink as one more logit (no value row), in fp16
+//   O_b = P_b . V_b                  [NH x D], written straight into dst ([D, NH, 1, n] contiguous)
+// Used for n >= GGML_SYCL_DSV4_MQA_MIN (8) queries; decode keeps the TILE/VEC kernels.  GGML_SYCL_DSV4_MQA=0 = off.
+#include "fattn-dsv4.hpp"
+
+#include <oneapi/mkl.hpp>
+
+#include <cmath>
+#include <cstdlib>
+
+namespace {
+
+int env_int(const char * k, int def) {
+    const char * v = std::getenv(k);
+    return v && *v ? std::atoi(v) : def;
+}
+
+}  // namespace
+
+bool ggml_sycl_fattn_dsv4_mqa_ok(const ggml_tensor * dst) {
+    static const int on = env_int("GGML_SYCL_DSV4_MQA", 1);
+    static const int min_n = env_int("GGML_SYCL_DSV4_MQA_MIN", 8);
+    if (!on) return false;
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+    if (!Q || !K || !V || !mask) return false;
+    if (Q->type != GGML_TYPE_F32 || K->type != GGML_TYPE_F16 || V->type != GGML_TYPE_F16 || mask->type != GGML_TYPE_F16 ||
+        dst->type != GGML_TYPE_F32) return false;
+    if (sinks && sinks->type != GGML_TYPE_F32) return false;
+    const int64_t D = Q->ne[0], NH = Q->ne[2], n = Q->ne[3], M = K->ne[1];
+    if (Q->ne[1] != 1 || n < min_n) return false;                          // one query per batch, enough of them
+    if (K->ne[0] != D || V->ne[0] != D || V->ne[1] != M) return false;
+    if (K->ne[2] != 1 || V->ne[2] != 1 || K->ne[3] != n || V->ne[3] != n) return false;   // MQA, keys per query
+    if (D % 16 || M % 16) return false;
+    // K / V contiguous per query: [D] rows, M of them, then the next query
+    for (const ggml_tensor * t : {K, V})
+        if (t->nb[0] != 2 || t->nb[1] != (size_t) D * 2 || t->nb[3] != (size_t) M * D * 2) return false;
+    // mask: one row of M per query
+    if (mask->ne[0] < M || mask->ne[1] != 1 || mask->ne[2] != 1 || mask->ne[3] != n || mask->nb[0] != 2) return false;
+    // dst [D, NH, 1, n] contiguous
+    if (dst->ne[0] != D || dst->ne[1] != NH || dst->ne[2] != 1 || dst->ne[3] != n || !ggml_is_contiguous(dst)) return false;
+    float max_bias = 0.0f, logit_softcap = 0.0f;
+    memcpy(&max_bias, (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) dst->op_params + 2, sizeof(float));
+    return max_bias == 0.0f && logit_softcap == 0.0f;
+}
+
+void ggml_sycl_flash_attn_ext_dsv4_mqa(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    namespace mkl = oneapi::mkl;
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+    const int64_t D = Q->ne[0], NH = Q->ne[2], n = Q->ne[3], M = K->ne[1];
+    float scale = 1.0f;
+    memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+    dpct::queue_ptr stream = ctx.stream();
+    ggml_sycl_pool & pool = ctx.pool();
+    ggml_sycl_pool_alloc<sycl::half> Qh(pool, (size_t) n * NH * D);
+    ggml_sycl_pool_alloc<float> S(pool, (size_t) n * NH * M);
+    ggml_sycl_pool_alloc<sycl::half> P(pool, (size_t) n * NH * M);
+    sycl::half * qh = Qh.get();
+    float * s = S.get();
+    sycl::half * p = P.get();
+    // 1. Q (any strides) -> Qh[b][h][d] = half(scale * Q)
+    {
+        const char * qd = (const char *) Q->data;
+        const size_t nb0 = Q->nb[0], nb2 = Q->nb[2], nb3 = Q->nb[3];
+        const size_t total = (size_t) n * NH * D;
+        stream->parallel_for(sycl::range<1>(total), [=](sycl::id<1> id) {
+            const size_t i = id[0];
+            const int64_t d = (int64_t) (i % D), h = (int64_t) ((i / D) % NH), b = (int64_t) (i / (D * NH));
+            const float v = *(const float *) (qd + d * nb0 + h * nb2 + b * nb3);
+            qh[i] = (sycl::half) (v * scale);
+        });
+    }
+    // 2. S_b = Qh_b [NH x D] . K_b^T  (K_b row-major [M x D])
+    mkl::blas::row_major::gemm_batch(*stream, mkl::transpose::nontrans, mkl::transpose::trans, NH, M, D, 1.0f, qh, D,
+                                     NH * D, (const sycl::half *) K->data, D, M * D, 0.0f, s, M, NH * M, n);
+    // 3. softmax over M with the mask row of the query and the head's sink; P in fp16
+    {
+        const sycl::half * mk = (const sycl::half *) mask->data;
+        const size_t mstride = mask->nb[3] / 2;
+        const float * sk = sinks ? (const float *) sinks->data : nullptr;
+        const int WG = 256;
+        stream->parallel_for(sycl::nd_range<1>(sycl::range<1>((size_t) n * NH * WG), sycl::range<1>(WG)),
+                             [=](sycl::nd_item<1> it) {
+            const int64_t row = (int64_t) it.get_group(0);       // b * NH + h
+            const int64_t b = row / NH, h = row % NH;
+            const int lid = (int) it.get_local_id(0);
+            const float * sr = s + row * M;
+            const sycl::half * mr = mk + b * mstride;
+            float mx = sk ? sk[h] : -1e30f;   // not -inf: icpx assumes finite math; a fully masked row then gives 0
+            for (int64_t m = lid; m < M; m += WG) mx = sycl::fmax(mx, sr[m] + (float) mr[m]);
+            mx = sycl::reduce_over_group(it.get_group(), mx, sycl::maximum<float>());
+            float sum = 0.0f;
+            for (int64_t m = lid; m < M; m += WG) sum += sycl::exp(sr[m] + (float) mr[m] - mx);
+            sum = sycl::reduce_over_group(it.get_group(), sum, sycl::plus<float>());
+            if (sk) sum += sycl::exp(sk[h] - mx);
+            const float inv = sum > 0.0f ? 1.0f / sum : 0.0f;
+            sycl::half * pr = p + row * M;
+            for (int64_t m = lid; m < M; m += WG) pr[m] = (sycl::half) (sycl::exp(sr[m] + (float) mr[m] - mx) * inv);
+        });
+    }
+    // 4. O_b = P_b [NH x M] . V_b [M x D] -> dst[b] = [NH][D] (dst is [D, NH, 1, n] contiguous)
+    mkl::blas::row_major::gemm_batch(*stream, mkl::transpose::nontrans, mkl::transpose::nontrans, NH, D, M, 1.0f, p, M,
+                                     NH * M, (const sycl::half *) V->data, D, M * D, 0.0f, (float *) dst->data, D, NH * D, n);
+}
