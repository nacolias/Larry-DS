+void ggml_sycl_op_dsv41_kv_fin(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/5);
+    const ggml_tensor * x = dst->src[0], * w = dst->src[1], * pos = dst->src[2], * ring = dst->src[3], * slot = dst->src[4];
+    GGML_ASSERT(x->ne[0] == 512);
+    dsv41dec::KvFinArgs a;
+    a.x = (const float *) x->data;
+    a.x_cs = (int64_t) (x->nb[1] / 4);
+    a.w = (const float *) w->data;
+    a.pos = (const int32_t *) pos->data;
+    a.eps = ggml_get_op_params_f32(dst, 0);
+    a.fq = ggml_get_op_params_i32(dst, 1) != 0;
+    a.rope = dsv41_rope_params(dst, 2);
+    a.y = (float *) dst->data;   // y [512, n], then the RoPE table [n_dims, n]
+    a.y_cs = 512;
+    a.tab = a.y + (size_t) 512 * x->ne[1];
+    a.ring = (float *) ring->data;
+    a.ring_cs = (int64_t) (ring->nb[1] / 4);
+    a.slot = (const int32_t *) slot->data;
+    a.D = (int) x->ne[0];
+    a.n = (int) x->ne[1];
+    a.slot_from = a.n - (int) ggml_nelements(slot);
+    dsv41dec::kv_fin(*ctx.stream(), a);
+}
