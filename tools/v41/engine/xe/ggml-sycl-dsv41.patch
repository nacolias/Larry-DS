+// larry, GGML_SYCL_LARRY_F16CACHE_MB: fp16 copies of quantized weights for the prompt GEMMs, kept across calls
+struct larry_f16c_entry { const void * src; size_t ne; sycl::half * f16; size_t cap; uint64_t tick; };
+static std::vector<larry_f16c_entry> g_larry_f16c;
+static size_t g_larry_f16c_bytes = 0;
+static uint64_t g_larry_f16c_tick = 0;
+static sycl::queue * g_larry_f16c_q = nullptr;
