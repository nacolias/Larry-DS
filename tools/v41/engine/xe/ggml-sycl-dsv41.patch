+// ---- larry: DeepSeek-V4.1's hyper-connection steps fused for decode widths.  Per layer the composite was ~14 tiny
+// kernels (hc_post, norm_mv, hc_mixes, hc_comb, hc_pre, rms_norm+mul for each sub-layer; add, hc_post, cpy for the
+// finish); these are 5.  hc == 4.
+
+// GGML_OP_DSV41_HC_POST2: one work-item per (token, 4 columns), all hc outputs: (a + b) * post[d] + sum_s res[s] * comb[d, s]
+void ggml_sycl_op_dsv41_hc_post2(ggml_backend_sycl_context & ctx, ggml_tensor * dst) {
+    scope_op_debug_print scope_dbg_print(__func__, dst, /*num_src=*/5);
+    const ggml_tensor * a = dst->src[0], * b = dst->src[1], * res = dst->src[2], * post = dst->src[3], * comb = dst->src[4];
+    constexpr int HC = 4;
+    const int64_t D = a->ne[0], n = a->ne[1];
+    GGML_ASSERT(res->ne[1] == HC && D % 4 == 0);
+    const float * pa = (const float *) a->data;
+    const float * pb = b ? (const float *) b->data : nullptr;
+    const float * pr = (const float *) res->data;
+    const float * pp = (const float *) post->data;
+    const float * pc = (const float *) comb->data;
+    float * pd = (float *) dst->data;
+    const int64_t as1 = a->nb[1] / 4, bs1 = b ? b->nb[1] / 4 : 0, rs1 = res->nb[1] / 4, rs2 = res->nb[2] / 4;
+    const int64_t ps1 = post->nb[1] / 4, cs1 = comb->nb[1] / 4, cs2 = comb->nb[2] / 4, ds1 = dst->nb[1] / 4, ds2 = dst->nb[2] / 4;
+    const int64_t nq = D / 4;
+    ctx.stream()->parallel_for(sycl::range<1>((size_t) (n * nq)), [=](sycl::id<1> id) {
+        const int64_t i = ((int64_t) id[0] % nq) * 4, t = (int64_t) id[0] / nq;
+        sycl::float4 x = *(const sycl::float4 *) (pa + t * as1 + i);
+        if (pb) x += *(const sycl::float4 *) (pb + t * bs1 + i);
+        sycl::float4 r[HC];
+#pragma unroll
+        for (int s = 0; s < HC; ++s) r[s] = *(const sycl::float4 *) (pr + t * rs2 + s * rs1 + i);
+        const float * po = pp + t * ps1;
+        const float * co = pc + t * cs2;
+#pragma unroll
+        for (int d = 0; d < HC; ++d) {
+            sycl::float4 o = x * po[d];
+#pragma unroll
+            for (int s = 0; s < HC; ++s) o += r[s] * co[d + s * cs1];
+            *(sycl::float4 *) (pd + t * ds2 + d * ds1 + i) = o;
+        }
+    });
+}
